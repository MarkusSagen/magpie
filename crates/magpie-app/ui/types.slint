export struct EntryRow {
    title: string,
    subtitle: string,
    kind: string,
    slot: int,
    merged: bool,
    badge: string,
    source: string,
    when: string,
    copied: int,
    size: string,
    masked: bool,
    icon: image,
    has_icon: bool,
    words: int,
    section: string,
    copied_date: string,
    pinned: bool,
    // For web-link entries: the bare domain (e.g. "github.com"), "" otherwise.
    // Drives the accent "domain ↗" suffix + chain badge on link rows (screen 04).
    domain: string,
    // The entry's OWN content preview, as opposed to `icon` (the source app):
    // a thumbnail for image entries, a swatch colour for colour entries.
    thumb: image,
    has_thumb: bool,
    swatch: color,
    has_swatch: bool,
}

export struct Bar {
    label: string,
    display: string,
    value_norm: float,
}

export struct ActionItem {
    icon: string,
    label: string,
    key: string,
    id: string,
    group: string,
}

export struct SlotItem {
    n: int,
    title: string,
    filled: bool,
}

export struct AppItem {
    id: int,
    name: string,
    count: int,
}

export struct NoteRow {
    id: int,
    title: string,
    when: string,
    is_daily: bool,
    tags: string,
}

export struct BookmarkRow {
    id: int,
    title: string,
    domain: string,
    url: string,
    icon: image,
    has_icon: bool,
    thumb: image,
    has_thumb: bool,
    tags: string,
}

export struct JournalRow {
    note_id: int,
    date: string,
    body: string,
}

export struct RefRow {
    note_id: int,
    line_index: int,
    source: string,
    line: string,
}

// A single task row (a `- [ ]` line parsed out of a note). `priority` is 0=High,
// 1=Medium, 2=Low, 3=None; `due` is a pre-formatted date string (empty if none);
// `source` is the owning note's name.
export struct TaskRow {
    note_id: int,
    line_index: int,
    title: string,
    done: bool,
    // In-progress (`- [/]`), the Obsidian/Logseq convention. Mutually exclusive
    // with `done`; drives the amber half-filled checkbox glyph.
    doing: bool,
    priority: int,
    due: string,
    project: string,
    source: string,
    recur: string,
    overdue: bool,
    bookmarked: bool,
    tracking: bool,
    time_total: string,
}

// One column of the cross-project task Board (Kanban/List layouts share this
// shape — see `magpie_app::tasks::board_columns`).
export struct BoardColumn {
    title: string,
    count: int,
    tasks: [TaskRow],
}

// A note-link-graph node/edge, pre-positioned by `magpie_app::graph::build_graph`
// (Rust owns the layout; Slint just draws normalized 0..1 coordinates). Edges
// carry resolved endpoints directly — no index lookups in Slint.
export struct GraphNode {
    id: int,
    title: string,
    x: float,
    y: float,
    degree: int,
}

export struct GraphEdge {
    x1: float,
    y1: float,
    x2: float,
    y2: float,
}

export struct ClipRow {
    title: string,
    kind: string,
}

// A single tracked session in the Stats → "Recent sessions" list.
export struct TimeEntryRow {
    id: int,
    title: string,
    when: string,      // e.g. "2h ago" (relative_time)
    duration: string,  // fmt_duration, or ignored when `running`
    running: bool,
}

// ---- "Find everywhere" palette rows (unified search over notes/tasks/bookmarks) ----
export struct SearchNoteRow {
    id: int,
    title: string,
}

export struct SearchTaskRow {
    id: int,
    title: string,
}

export struct SearchBookmarkRow {
    url: string,
    title: string,
}

// One typed column of a parsed Data table (screen 13). `cells` holds one display
// string per row; `numeric` right-aligns cells and marks the column chartable.
export struct DataColumn {
    name: string,
    kind: string,   // "integer" | "float" | "date" | "bool" | "text"
    numeric: bool,
    cells: [string],
}

// One row of calculator history (screen 11). `kind` is math|date|graph (drives the
// row glyph + tab filter); `group` is the day bucket ("Today"/"Yesterday"/…) used
// for section headers.
export struct CalcRow {
    id: int,
    kind: string,
    input: string,
    result: string,
    time: string,
    group: string,
    pinned: bool,
}

// One sidebar Favorites-group row (Phase 10). `kind` drives the leading glyph +
// the activation behaviour (quicklink → open URL, clip → paste, note → open, …).
export struct FavoriteRow {
    id: int,
    kind: string,
    label: string,
    keyword: string,
}

// A recent-data entry in the Data view's left rail (session-scoped).
export struct RecentData {
    name: string,
    meta: string,   // e.g. "File · CSV · 8 × 6"
    selected: bool,
}

// One plotted point for the Data chart (screen 14), pre-normalized to 0..1 with
// the origin at the bottom-left; `label` is the optional point label.
export struct ChartPoint {
    x: float,
    y: float,
    label: string,
}

// Accent + the text colour that is legible ON the accent. White-on-accent only
// reaches ~2.9:1, so filled controls use `on-accent` for their label.
// Theme tokens (light + dark). `dark` is wired from the `LauncherWindow` root
// (a global can't read the root directly — see `theme-dark` on the root and
// its `init`/`changed` handler that push the value in here). Phase 1: only
// the core surfaces (sidebar, clipboard/list view) consume these tokens —
// everything else keeps its hardcoded dark values until a later migration
// pass, so default dark mode is visually unchanged.
// One named colour theme. Every colour token the UI consumes lives here, so a
// new theme is just one more entry in `Theme.palettes` (order MUST match the
// Rust registry in `themes.rs`). `dark` drives the native window chrome.
// Graphite token set (one accent, neutral greys). `bg-elevated-2` and
// `text-ghost` are derived in `Theme` from these base tokens.
export struct Palette {
    name: string,
    dark: bool,
    // surfaces (darkest → lightest)
    bg-sidebar: color,
    bg-app: color,
    bg-panel: color,
    bg-elevated: color,
    line: color,
    line-strong: color,
    // text (brightest → faintest)
    text: color,
    text-dim: color,
    text-faint: color,
    // the single accent + destructive
    accent: color,
    on-accent: color,
    danger: color,
}

// ---- Date answers v2 / calendar (Phase 11, PNG 15) ----
// One day cell in a month grid. `blank` cells pad the Mon-first grid.
export struct CalDay {
    dom: string,
    blank: bool,
    in-range: bool,
    is-target: bool,
    is-today: bool,
    is-weekend: bool,
}
export struct CalMonth {
    title: string,      // "September"
    cells: [CalDay],    // 42 (6×7), Mon-first, row-major
}
// One cell of the 53×7 year heatmap.
export struct CalYearCell {
    blank: bool,
    in-range: bool,
    is-target: bool,
    is-today: bool,
}
export struct CalMonthLabel {
    label: string,      // "Jan"
    col: int,           // heatmap column the month starts in
}

// ---- World clock (Phase 12, PNG 16) ----
export struct WorldClockRow {
    name: string,
    abbrev: string,        // "CEST"
    offset-label: string,  // "+2"
    rel-label: string,     // "you" / "-1h" / "+7h"
    big-time: string,      // "15:00"
    date-label: string,    // "Fri 25 Sep"
    is-home: bool,
    hours: [int],          // 24 local-hour labels, aligned to the home day
    shades: [int],         // 24 shade bands: 0 night, 1 awake, 2 work
}

// ---- Notes v2 rich Markdown preview (Phase 14, PNG 18) ----
// One inline span. `kind`: 0 text, 1 bold, 2 italic, 3 code, 4 wiki, 5 url,
// 6 prio, 7 date, 8 tag, 9 recur.
export struct MdSpan {
    kind: int,
    text: string,
    href: string,
    domain: string,
    prio: int,       // 1 low, 2 med, 3 high (kind 6)
    icon: image,     // favicon for a URL span (kind 5), when cached
    has-icon: bool,
}
// One rendered line. `block`: 0 plain, 1 h1, 2 h2, 3 h3, 4 bullet, 5 numbered,
// 6 quote, 7 task.
export struct MdLineVM {
    block: int,
    done: bool,
    marker: string,   // "1." for numbered
    spans: [MdSpan],
}
