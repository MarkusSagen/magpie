import { LineEdit, ListView, TextEdit, ScrollView } from "std-widgets.slint";

struct EntryRow {
    title: string,
    subtitle: string,
    kind: string,
    slot: int,
    merged: bool,
    full: string,
    badge: string,
    glyph: string,
    source: string,
    when: string,
    copied: int,
    size: string,
    masked: bool,
    full_masked: string,
    icon: image,
    has_icon: bool,
    words: int,
    section: string,
    copied_date: string,
}

struct Bar {
    label: string,
    display: string,
    value_norm: float,
}

struct ActionItem {
    icon: string,
    label: string,
    key: string,
    id: string,
}

// A labeled horizontal bar: [ label ][=== track ===][ value ]
component HBar inherits Rectangle {
    in property <string> label;
    in property <string> display;
    in property <float> value_norm;
    height: 22px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: label;
            color: #d0d0d4;
            font-size: 11px;
            width: 180px;
            overflow: elide;
            vertical-alignment: center;
        }
        track := Rectangle {
            background: #2a2a30;
            border-radius: 3px;
            Rectangle {
                x: 0;
                y: 0;
                height: parent.height;
                width: track.width * value_norm;
                background: #6a8cff;
                border-radius: 3px;
            }
        }
        Text {
            text: display;
            color: #9a9aa0;
            font-size: 11px;
            width: 48px;
            vertical-alignment: center;
        }
    }
}

export component LauncherWindow inherits Window {
    title: "Magpie";
    preferred-width: 900px;
    preferred-height: 560px;
    background: #1e1e21;
    forward-focus: fs;

    in property <[EntryRow]> entries;
    in property <string> query;
    in-out property <int> selected: 0;
    // "list" | "edit" | "actions" — gates keyboard routing.
    in-out property <string> mode: "list";
    in-out property <int> type-index: 0;
    in-out property <int> sort-index: 0;
    in-out property <int> action-selected: 0;
    in property <bool> screenshare: false;
    in-out property <bool> revealed: false;
    // The app that was frontmost when the launcher opened (paste target).
    in property <string> target-app: "";
    in property <image> target-icon;
    in property <bool> target-has-icon: false;

    in-out property <string> view: "list";
    in property <[Bar]> over-time-bars;
    in property <[Bar]> most-copied-bars;
    in property <[Bar]> per-app-bars;
    in property <[Bar]> by-type-bars;
    in property <string> totals-line;
    in-out property <int> range-index: 1;

    callback search-changed(string);
    callback key-char(string);
    callback key-backspace();
    callback clear-query();
    callback activate(int);
    callback activate-nth(int);
    callback copy-only(int);
    callback stats-range-changed(int);
    callback toggle-view();
    callback assign-slot(int, int);
    callback set-type-filter(int);
    callback set-sort(int);
    callback hide-window();
    callback toggle-pin(int);
    callback paste-into-search();
    callback toggle-screenshare();
    callback delete-entry(int);
    callback activate-keep(int);
    // ⌘K actions menu (Rust owns the filtered model; Slint dispatches by id).
    in property <[ActionItem]> actions;
    in-out property <string> actions-query: "";
    callback open-actions();
    callback actions-key-char(string);
    callback actions-backspace();
    callback run-action(string);
    run-action(id) => {
        if id == "paste" { root.activate(root.selected); }
        else if id == "copy" { root.copy-only(root.selected); }
        else if id == "keep" { root.activate-keep(root.selected); }
        else if id == "edit" { root.start-edit(root.selected); }
        else if id == "snippet" { root.new-snippet(); }
        else if id == "pin" { root.toggle-pin(root.selected); }
        else if id == "merge" { root.toggle-merge(root.selected); }
        else if id == "delete" { root.delete-entry(root.selected); }
        root.mode = "list";
    }

    in-out property <string> edit-mode: "none";
    in-out property <string> edit-text;
    callback start-edit(int);
    callback new-snippet();
    callback save-edit(string);
    callback cancel-edit();

    in property <[string]> selected-tags;
    in property <[string]> all-tags;
    in-out property <string> add-tag-text;
    in-out property <string> tag-filter;
    callback add-tag(int, string);
    callback remove-tag(int, string);
    callback set-tag-filter(string);

    in property <int> merge-count;
    in-out property <int> merge-sep: 0;
    callback toggle-merge(int);
    callback merge-paste();
    callback clear-merge();

    // Re-focus the command bar whenever we return to list mode.
    changed mode => {
        if root.mode == "list" {
            fs.focus();
        }
    }

    fs := FocusScope {
        key-pressed(event) => {
            // Native editor owns the keyboard while editing.
            if root.mode == "edit" {
                return reject;
            }

            // Help view swallows keys except the ways out.
            if root.view == "help" {
                if event.text == Key.Escape || (event.modifiers.meta && event.text == "/") {
                    root.view = "list";
                }
                return accept;
            }

            // ---- ⌘K actions palette (searchable) ----
            if root.mode == "actions" {
                if event.text == Key.UpArrow {
                    if root.action-selected > 0 { root.action-selected -= 1; }
                    return accept;
                }
                if event.text == Key.DownArrow {
                    if root.action-selected < root.actions.length - 1 { root.action-selected += 1; }
                    return accept;
                }
                if event.text == Key.Escape {
                    root.mode = "list";
                    return accept;
                }
                if event.text == Key.Return {
                    if root.actions.length > 0 && root.action-selected < root.actions.length {
                        root.run-action(root.actions[root.action-selected].id);
                    }
                    return accept;
                }
                if event.text == Key.Backspace {
                    root.actions-backspace();
                    return accept;
                }
                // any other named key -> ignore; printable -> filter query
                if event.text == Key.Tab || event.text == Key.Delete || event.text == Key.Home
                    || event.text == Key.End || event.text == Key.PageUp || event.text == Key.PageDown
                    || event.text == Key.LeftArrow || event.text == Key.RightArrow
                    || event.text == Key.Shift || event.text == Key.Control
                    || event.text == Key.Alt || event.text == Key.Meta {
                    return accept;
                }
                if event.text.character-count == 1 {
                    root.actions-key-char(event.text);
                }
                return accept;
            }

            // ---- list-mode navigation ----
            if event.text == Key.UpArrow {
                if root.selected > 0 {
                    root.selected -= 1;
                }
                return accept;
            }
            if event.text == Key.DownArrow {
                if root.selected < root.entries.length - 1 {
                    root.selected += 1;
                }
                return accept;
            }
            if event.text == Key.Return {
                root.activate(root.selected);
                return accept;
            }
            if event.text == Key.Escape {
                if root.query != "" {
                    root.clear-query();
                    return accept;
                }
                root.hide-window();
                return accept;
            }
            if event.text == Key.Backspace {
                root.key-backspace();
                return accept;
            }

            // ---- ⌘ shortcuts ----
            if event.modifiers.meta {
                if event.text == "c" { root.copy-only(root.selected); return accept; }
                if event.text == "k" { root.open-actions(); return accept; }
                if event.text == "/" { root.view = "help"; return accept; }
                if event.text == "e" { root.start-edit(root.selected); return accept; }
                if event.text == "n" { root.new-snippet(); return accept; }
                if event.text == "m" { root.toggle-merge(root.selected); return accept; }
                if event.text == "p" { root.toggle-pin(root.selected); return accept; }
                if event.text == "v" { root.paste-into-search(); return accept; }
                if event.text == "1" { root.activate-nth(1); return accept; }
                if event.text == "2" { root.activate-nth(2); return accept; }
                if event.text == "3" { root.activate-nth(3); return accept; }
                if event.text == "4" { root.activate-nth(4); return accept; }
                if event.text == "5" { root.activate-nth(5); return accept; }
                if event.text == "6" { root.activate-nth(6); return accept; }
                if event.text == "7" { root.activate-nth(7); return accept; }
                if event.text == "8" { root.activate-nth(8); return accept; }
                if event.text == "9" { root.activate-nth(9); return accept; }
                return reject;
            }

            // ---- typed character -> query (skip non-printable named keys) ----
            if event.text == Key.Tab || event.text == Key.Delete || event.text == Key.Home
                || event.text == Key.End || event.text == Key.PageUp || event.text == Key.PageDown
                || event.text == Key.LeftArrow || event.text == Key.RightArrow
                || event.text == Key.Shift || event.text == Key.Control
                || event.text == Key.Alt || event.text == Key.Meta {
                return reject;
            }
            if event.text.character-count == 1 {
                root.key-char(event.text);
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 8px;
            spacing: 8px;

            // ---- List view ----
            if root.view == "list": VerticalLayout {
                spacing: 8px;

                // Command-bar search field (keys handled by the root FocusScope).
                Rectangle {
                    height: 44px;
                    background: #161618;
                    border-radius: 10px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        Text { text: "🔍"; font-size: 16px; vertical-alignment: center; }
                        Text {
                            text: root.query == "" ? "Search clipboard…" : root.query;
                            color: root.query == "" ? #6a6a70 : white;
                            font-size: 15px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Rectangle { width: 2px; height: 20px; background: #6a8cff; }
                    }
                }

                // Type filter + sort + stats.
                HorizontalLayout {
                    spacing: 6px;
                    for label[i] in ["All", "Text", "Link", "Color", "Image", "File"]: Rectangle {
                        height: 26px;
                        width: 58px;
                        background: i == root.type-index ? #6a8cff : #2a2a30;
                        border-radius: 6px;
                        TouchArea { clicked => { root.type-index = i; root.set-type-filter(i); } }
                        Text { text: label; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    for label[i] in ["Recent", "Most"]: Rectangle {
                        height: 26px;
                        width: 58px;
                        background: i == root.sort-index ? #3a3a40 : #202024;
                        border-radius: 6px;
                        TouchArea { clicked => { root.sort-index = i; root.set-sort(i); } }
                        Text { text: label; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 40px;
                        height: 26px;
                        background: root.screenshare ? #b04a4a : #202024;
                        border-radius: 6px;
                        TouchArea { clicked => { root.toggle-screenshare(); } }
                        Text { text: "🔒"; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 34px;
                        height: 26px;
                        background: #202024;
                        border-radius: 6px;
                        TouchArea { clicked => { root.view = "help"; } }
                        Text { text: "?"; color: white; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 58px;
                        height: 26px;
                        background: #202024;
                        border-radius: 6px;
                        TouchArea { clicked => { root.toggle-view(); } }
                        Text { text: "Stats"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                if root.all-tags.length > 0: HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    for t in root.all-tags: Rectangle {
                        height: 22px;
                        width: 64px;
                        background: root.tag-filter == t ? #6a8cff : #2a2a30;
                        border-radius: 11px;
                        TouchArea { clicked => { root.set-tag-filter(t); } }
                        Text {
                            text: "#" + t;
                            color: white;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                if root.merge-count > 0: HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: "Merge " + root.merge-count + " · sep:";
                        color: white;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    for label[si] in ["↵", "␣", ","]: Rectangle {
                        width: 30px;
                        height: 26px;
                        background: si == root.merge-sep ? #6a8cff : #2a2a30;
                        border-radius: 6px;
                        TouchArea { clicked => { root.merge-sep = si; } }
                        Text { text: label; color: white; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 110px;
                        height: 26px;
                        background: #6a8cff;
                        border-radius: 6px;
                        TouchArea { clicked => { root.merge-paste(); } }
                        Text { text: "Merge & paste"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 54px;
                        height: 26px;
                        background: #2a2a30;
                        border-radius: 6px;
                        TouchArea { clicked => { root.clear-merge(); } }
                        Text { text: "Clear"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                // Two-pane body.
                HorizontalLayout {
                    spacing: 12px;

                    // Scroll-follow: mirror `selected` locally so the `changed`
                    // handler can reach `list` (an id inside this subtree).
                    property <int> sel-follow: root.selected;
                    changed sel-follow => {
                        root.revealed = false;
                        if root.selected * 52px < -list.viewport-y {
                            list.viewport-y = -root.selected * 52px;
                        } else if (root.selected + 1) * 52px > -list.viewport-y + list.visible-height {
                            list.viewport-y = -((root.selected + 1) * 52px - list.visible-height);
                        }
                    }

                    list := ListView {
                        min-width: 340px;
                        for row[i] in entries: VerticalLayout {
                            // Date group header when the section changes.
                            if i == 0 || entries[i - 1].section != row.section: Text {
                                text: row.section;
                                color: #6a6a70;
                                font-size: 11px;
                            }
                            Rectangle {
                            height: 52px;
                            background: i == root.selected ? #2f2f37 : transparent;
                            border-radius: 8px;
                            TouchArea {
                                clicked => { root.selected = i; }
                                double-clicked => { root.activate(i); }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                Rectangle {
                                    width: 3px;
                                    y: 12px;
                                    height: 28px;
                                    border-radius: 2px;
                                    background: i == root.selected ? #6a8cff : transparent;
                                }
                                if row.has-icon: Image { source: row.icon; width: 20px; height: 20px; }
                                if !row.has-icon: Text { text: row.glyph; font-size: 18px; vertical-alignment: center; width: 24px; horizontal-alignment: center; }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: row.title; color: white; font-size: 14px; overflow: elide; horizontal-stretch: 1; }
                                        if row.badge != "": Text { text: row.badge; color: #9a9aa0; font-size: 10px; vertical-alignment: center; }
                                    }
                                    Text { text: row.subtitle; color: #9a9aa0; font-size: 11px; overflow: elide; }
                                }
                                if row.slot > 0: Rectangle {
                                    width: 24px;
                                    y: 15px;
                                    height: 22px;
                                    border-radius: 6px;
                                    background: #3a3a40;
                                    Text { text: "⌘" + row.slot; color: #d0d0d4; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Rectangle {
                                    width: 24px;
                                    y: 14px;
                                    height: 24px;
                                    background: row.merged ? #6a8cff : transparent;
                                    border-radius: 6px;
                                    TouchArea { clicked => { root.toggle-merge(i); } }
                                    Text { text: row.merged ? "✓" : "+"; color: row.merged ? white : #6a6a70; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            }
                        }
                    }

                    Rectangle {
                        background: #161618;
                        border-radius: 8px;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;
                            ScrollView {
                                min-height: 100px;
                                vertical-stretch: 1;
                                Text {
                                    width: parent.visible-width;
                                    text: (entries.length > 0 && root.selected < entries.length)
                                        ? (entries[root.selected].masked && !root.revealed
                                            ? entries[root.selected].full-masked
                                            : entries[root.selected].full)
                                        : "";
                                    color: #d0d0d4;
                                    wrap: word-wrap;
                                }
                            }

                            // Reveal a masked entry's detail (UI-only; row stays masked).
                            if entries.length > 0 && root.selected < entries.length
                                && entries[root.selected].masked && !root.revealed: Rectangle {
                                height: 26px;
                                width: 96px;
                                background: #2a2a30;
                                border-radius: 6px;
                                TouchArea { clicked => { root.revealed = true; } }
                                Text { text: "👁 Reveal"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                            }

                            // Metadata "Information" block (Raycast-style; right-aligned values).
                            if entries.length > 0 && root.selected < entries.length: VerticalLayout {
                                spacing: 5px;
                                Rectangle { height: 1px; background: #2a2a30; }
                                Text { text: "Information"; color: #6a6a70; font-size: 12px; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text { text: "Source"; color: #6a6a70; font-size: 11px; horizontal-stretch: 1; }
                                    if entries[root.selected].has-icon: Image { source: entries[root.selected].icon; width: 14px; height: 14px; }
                                    Text { text: entries[root.selected].source; color: #d0d0d4; font-size: 11px; overflow: elide; }
                                }
                                HorizontalLayout {
                                    Text { text: "Content type"; color: #6a6a70; font-size: 11px; horizontal-stretch: 1; }
                                    Text { text: entries[root.selected].kind; color: #d0d0d4; font-size: 11px; horizontal-alignment: right; }
                                }
                                HorizontalLayout {
                                    Text { text: "Characters"; color: #6a6a70; font-size: 11px; horizontal-stretch: 1; }
                                    Text { text: entries[root.selected].size; color: #d0d0d4; font-size: 11px; horizontal-alignment: right; }
                                }
                                HorizontalLayout {
                                    Text { text: "Words"; color: #6a6a70; font-size: 11px; horizontal-stretch: 1; }
                                    Text { text: entries[root.selected].words; color: #d0d0d4; font-size: 11px; horizontal-alignment: right; }
                                }
                                HorizontalLayout {
                                    Text { text: "Times copied"; color: #6a6a70; font-size: 11px; horizontal-stretch: 1; }
                                    Text { text: entries[root.selected].copied; color: #d0d0d4; font-size: 11px; horizontal-alignment: right; }
                                }
                                HorizontalLayout {
                                    Text { text: "Last used"; color: #6a6a70; font-size: 11px; horizontal-stretch: 1; }
                                    Text { text: entries[root.selected].when; color: #d0d0d4; font-size: 11px; horizontal-alignment: right; }
                                }
                                HorizontalLayout {
                                    Text { text: "Copied"; color: #6a6a70; font-size: 11px; horizontal-stretch: 1; }
                                    Text { text: entries[root.selected].copied-date; color: #d0d0d4; font-size: 11px; horizontal-alignment: right; }
                                }
                                HorizontalLayout {
                                    Text { text: "Slot"; color: #6a6a70; font-size: 11px; horizontal-stretch: 1; }
                                    Text { text: entries[root.selected].slot > 0 ? "⌘" + entries[root.selected].slot : "—"; color: #d0d0d4; font-size: 11px; horizontal-alignment: right; }
                                }
                            }

                            // Tag chips for the selected entry (click to remove).
                            if root.edit-mode == "none" && root.selected-tags.length > 0: HorizontalLayout {
                                spacing: 4px;
                                alignment: start;
                                for t in root.selected-tags: Rectangle {
                                    height: 22px;
                                    width: 74px;
                                    background: #3a3a40;
                                    border-radius: 11px;
                                    TouchArea { clicked => { root.remove-tag(root.selected, t); } }
                                    Text {
                                        text: "#" + t + " ✕";
                                        color: #d0d0d4;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            // Add-tag input.
                            if root.edit-mode == "none" && entries.length > 0 && root.selected < entries.length: HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                tagfield := LineEdit {
                                    placeholder-text: "add tag…";
                                    width: 140px;
                                    text <=> root.add-tag-text;
                                }
                                Rectangle {
                                    width: 48px;
                                    height: 26px;
                                    background: #2a2a30;
                                    border-radius: 6px;
                                    TouchArea { clicked => { root.add-tag(root.selected, root.add-tag-text); } }
                                    Text { text: "Add"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }

                            // Edit-mode editor.
                            if root.edit-mode != "none": VerticalLayout {
                                spacing: 6px;
                                editor := TextEdit {
                                    min-height: 120px;
                                    text <=> root.edit-text;
                                    init => { editor.focus(); }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    Rectangle {
                                        width: 60px;
                                        height: 26px;
                                        background: #6a8cff;
                                        border-radius: 6px;
                                        TouchArea { clicked => { root.save-edit(root.edit-text); } }
                                        Text { text: "Save"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        width: 60px;
                                        height: 26px;
                                        background: #2a2a30;
                                        border-radius: 6px;
                                        TouchArea { clicked => { root.cancel-edit(); } }
                                        Text { text: "Cancel"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                }

                // Bottom action bar.
                Rectangle {
                    height: 34px;
                    background: #161618;
                    border-radius: 8px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;
                        Text {
                            text: (entries.length > 0 && root.selected < entries.length) ? entries[root.selected].source : "";
                            color: #9a9aa0;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.target-has-icon: Image { source: root.target-icon; width: 14px; height: 14px; }
                        Text {
                            text: root.target-app == "" ? "⏎ Paste" : "⏎ Paste to " + root.target-app;
                            color: #9a9aa0;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Text { text: "⌘C Copy   ⌘K Actions"; color: #9a9aa0; font-size: 12px; vertical-alignment: center; }
                    }
                }
            }

            // ---- Stats view ----
            if root.view == "stats": VerticalLayout {
                padding: 8px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Rectangle {
                        width: 70px;
                        height: 26px;
                        background: #202024;
                        border-radius: 6px;
                        TouchArea { clicked => { root.toggle-view(); } }
                        Text { text: "← Back"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    for label[i] in ["7d", "30d", "90d", "All"]: Rectangle {
                        width: 56px;
                        height: 26px;
                        background: i == root.range-index ? #3a3a40 : #202024;
                        border-radius: 6px;
                        TouchArea {
                            clicked => {
                                root.range-index = i;
                                root.stats-range-changed(i);
                            }
                        }
                        Text {
                            text: label;
                            color: white;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Text { text: root.totals-line; color: white; font-size: 13px; }

                Text { text: "Copies over time"; color: #9a9aa0; font-size: 11px; }
                Rectangle {
                    height: 64px;
                    HorizontalLayout {
                        alignment: start;
                        spacing: 2px;
                        for bar in root.over-time-bars: Rectangle {
                            width: 8px;
                            Rectangle {
                                width: parent.width;
                                y: parent.height * (1.0 - bar.value_norm);
                                height: parent.height * bar.value_norm;
                                background: #6a8cff;
                                border-radius: 2px;
                            }
                        }
                    }
                }

                Text { text: "Most copied"; color: #9a9aa0; font-size: 11px; }
                for bar in root.most-copied-bars: HBar {
                    label: bar.label;
                    display: bar.display;
                    value_norm: bar.value_norm;
                }

                Text { text: "By app"; color: #9a9aa0; font-size: 11px; }
                for bar in root.per-app-bars: HBar {
                    label: bar.label;
                    display: bar.display;
                    value_norm: bar.value_norm;
                }

                Text { text: "By type"; color: #9a9aa0; font-size: 11px; }
                for bar in root.by-type-bars: HBar {
                    label: bar.label;
                    display: bar.display;
                    value_norm: bar.value_norm;
                }
            }

            // ---- Help / keyboard shortcuts ----
            if root.view == "help": VerticalLayout {
                padding: 8px;
                spacing: 6px;
                HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        width: 70px;
                        height: 26px;
                        background: #202024;
                        border-radius: 6px;
                        TouchArea { clicked => { root.view = "list"; } }
                        Text { text: "← Back"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                Text { text: "Keyboard Shortcuts"; color: white; font-size: 15px; }

                Text { text: "Navigation"; color: #6a8cff; font-size: 12px; }
                for row in [
                    { k: "↑ / ↓", d: "Move selection" },
                    { k: "⏎", d: "Paste to the previous app" },
                    { k: "Esc", d: "Clear search, then close" },
                    { k: "type", d: "Filter entries" },
                    { k: "⌘1–9", d: "Paste the Nth entry" },
                ]: HorizontalLayout {
                    Text { text: row.k; color: #d0d0d4; font-size: 12px; width: 120px; }
                    Text { text: row.d; color: #9a9aa0; font-size: 12px; }
                }

                Text { text: "Actions"; color: #6a8cff; font-size: 12px; }
                for row in [
                    { k: "⌘K", d: "Open the actions menu" },
                    { k: "⌘C", d: "Copy (no paste)" },
                    { k: "⌘E", d: "Edit the entry" },
                    { k: "⌘N", d: "New snippet" },
                    { k: "⌘P", d: "Pin / unpin" },
                    { k: "⌘M", d: "Add to merge" },
                    { k: "⌘V", d: "Paste clipboard into search" },
                    { k: "⌃X", d: "Delete the entry" },
                ]: HorizontalLayout {
                    Text { text: row.k; color: #d0d0d4; font-size: 12px; width: 120px; }
                    Text { text: row.d; color: #9a9aa0; font-size: 12px; }
                }

                Text { text: "Views"; color: #6a8cff; font-size: 12px; }
                for row in [
                    { k: "⌘/  or  ?", d: "This help" },
                    { k: "🔒", d: "Screenshare (mask everything)" },
                    { k: "Stats", d: "Copy analytics" },
                ]: HorizontalLayout {
                    Text { text: row.k; color: #d0d0d4; font-size: 12px; width: 120px; }
                    Text { text: row.d; color: #9a9aa0; font-size: 12px; }
                }
            }
        }

        // ---- ⌘K actions palette overlay (searchable) ----
        if root.mode == "actions": Rectangle {
            background: #000000aa;
            TouchArea { clicked => { root.mode = "list"; } }
            Rectangle {
                width: 440px;
                height: 360px;
                background: #1e1e21;
                border-radius: 12px;
                border-width: 1px;
                border-color: #3a3a40;
                VerticalLayout {
                    padding: 10px;
                    spacing: 4px;
                    Text { text: "Actions"; color: #9a9aa0; font-size: 12px; }
                    ListView {
                        vertical-stretch: 1;
                        for a[i] in root.actions: Rectangle {
                            height: 34px;
                            background: i == root.action-selected ? #2f2f37 : transparent;
                            border-radius: 6px;
                            TouchArea { clicked => { root.run-action(a.id); } }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                Text { text: a.icon; font-size: 15px; vertical-alignment: center; width: 22px; }
                                Text { text: a.label; color: white; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: a.key; color: #6a6a70; font-size: 12px; vertical-alignment: center; }
                            }
                        }
                    }
                    // Search field (keys fed by the FocusScope while actions are open).
                    Rectangle {
                        height: 34px;
                        background: #161618;
                        border-radius: 8px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            Text { text: "🔍"; font-size: 13px; vertical-alignment: center; }
                            Text {
                                text: root.actions-query == "" ? "Search actions…" : root.actions-query;
                                color: root.actions-query == "" ? #6a6a70 : white;
                                font-size: 13px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }
}
