import { LineEdit, ListView, TextEdit, ScrollView } from "std-widgets.slint";

import { EntryRow, Bar, ActionItem, SlotItem, AppItem, NoteRow, BookmarkRow, JournalRow, RefRow, TaskRow, BoardColumn, GraphNode, GraphEdge, ClipRow, TimeEntryRow, SearchNoteRow, SearchTaskRow, SearchBookmarkRow, Palette } from "types.slint";
import { Theme, Pal } from "theme.slint";
import { Icons } from "icons.slint";
import { TypeIcon, ActionIcon } from "components/glyphs.slint";
import { HBar } from "components/hbar.slint";
import { PopoverTaskRow } from "components/task_row.slint";
import { BoardCard } from "components/board_card.slint";
import { NotesView } from "views/notes.slint";
import { TasksView } from "views/tasks.slint";
import { BoardView } from "views/board.slint";
import { GraphView } from "views/graph.slint";
import { BookmarksView } from "views/bookmarks.slint";
import { TodayView } from "views/today.slint";
import { JournalView } from "views/journal.slint";
import { FindView } from "views/find.slint";
import { HelpView } from "views/help.slint";
import { AccessibilityView } from "views/accessibility.slint";
import { FiltersView } from "views/filters.slint";
import { ActionsView } from "views/actions.slint";
import { SlotsView } from "views/slots.slint";
import { EditorView } from "views/editor.slint";
import { WelcomeView } from "views/welcome.slint";
import { MainView } from "views/main.slint";
import { ClipboardView } from "views/clipboard.slint";
import { StatsView } from "views/stats.slint";

export component LauncherWindow inherits Window {
    title: "Magpie";
    preferred-width: 960px;
    min-width: 960px;
    preferred-height: 560px;
    background: Theme.bg-app;
    forward-focus: main;

    // ---- Sidebar navigation (5 sections, Rust-driven router) ----
    property <length> sidebar-w: 60px;
    in-out property <string> section: "clipboard"; // clipboard|tasks|notes|bookmarks|stats
    in-out property <string> tasks-view: "today"; // today|list|board
    in-out property <string> notes-view: "notes"; // notes|journal|graph
    callback set-section(string);
    callback set-task-view(string);
    callback set-note-view(string);

    // ---- Theme (light/dark) ----
    in-out property <int> theme-index: 0;
    // Select a theme by catalogue index (see themes.rs / Theme.palettes).
    callback set-theme(int);
    init => { Theme.index = root.theme-index; }
    changed theme-index => { Theme.index = root.theme-index; }

    // ---- Keyboard nav layer (history + g-leader + view cycling) ----
    in-out property <bool> nav-leader: false;
    // Jump straight to a section, remembering its last-shown view (used by
    callback nav-section(string);
    // History stack (screens visited via `nav-section`/`set-task-view`/
    callback nav-back();
    callback nav-forward();
    // ⌘⌥← — toggle to the last screen you were on (alt-tab for screens).
    callback nav-previous();
    // ⌘⌥↑ / ⌘⌥↓ (-1 / +1) — cycle the current section's views. No-op outside
    callback nav-cycle-view(int);

    in property <[EntryRow]> entries;
    in-out property <string> query;
    in-out property <int> selected: 0;
    // "list" | "edit" | "actions" — gates keyboard routing.
    in-out property <string> mode: "list";
    in-out property <int> type-index: 0;
    in-out property <int> sort-index: 0;
    in-out property <int> action-selected: 0;
    in property <bool> screenshare: false;
    in-out property <bool> revealed: false;
    // True while the primary modifier (⌘ on macOS / Ctrl elsewhere) is held —
    in-out property <bool> cmd-held: false;
    // The app that was frontmost when the launcher opened (paste target).
    in property <string> target-app: "";
    in property <image> target-icon;
    in property <bool> target-has-icon: false;

    in-out property <string> view: "list";
    in property <[Bar]> over-time-bars;
    in property <[Bar]> most-copied-bars;
    in property <[Bar]> per-app-bars;
    in property <[Bar]> by-type-bars;
    in property <string> time-week-total;
    in property <[Bar]> time-by-day-bars;
    in property <[Bar]> time-by-project-bars;
    in property <[TimeEntryRow]> time-entries;
    callback delete-time-entry(int);
    in property <string> totals-line;
    // "2026-08-04 → 2026-09-02 · peak 21 copies in a day" under the bar chart.
    in property <string> over-time-caption;
    in-out property <int> range-index: 1;

    callback search-changed(string);
    // Detail preview is a virtualized line list — Rust pushes the (bounded) lines
    in property <[string]> preview-lines;
    // Image entries: the decoded bitmap for the selected entry. Without this the
    in property <image> preview-image;
    in property <bool> preview-has-image: false;
    // Selectable preview text for normal-size entries (empty for huge ones, which
    in property <string> preview-text;
    in property <bool> preview-truncated: false;
    // Preview font size — ⌘+ / ⌘- adjust it, ⌘0 resets (clamped in Rust callbacks).
    in-out property <length> preview-font-size: 13px;
    callback zoom-preview(int); // +1 bigger, -1 smaller, 0 reset
    callback preview-select(int, bool, bool);
    callback open-in-editor(int);
    callback activate(int);
    callback activate-nth(int);
    callback copy-only(int);
    callback stats-range-changed(int);
    callback toggle-view();
    callback assign-slot(int, int);
    callback set-type-filter(int);
    callback set-sort(int);
    callback hide-window();
    // Accessibility (macOS auto-paste permission) modal.
    in-out property <bool> needs-accessibility: false;
    callback open-accessibility-settings();
    callback recheck-accessibility();
    callback dismiss-accessibility();
    callback toggle-pin(int);
    callback toggle-screenshare();
    callback delete-entry(int);
    callback activate-keep(int);
    // ⌘K actions menu (Rust owns the filtered model; Slint dispatches by id).
    in property <[ActionItem]> actions;
    in-out property <string> actions-query: "";
    callback open-actions();
    callback actions-key-char(string);
    callback actions-backspace();
    callback run-action(string);
    // Close the palette FIRST so an action that opens another overlay (⌘S) wins.
    run-action(id) => {
        root.mode = "list";
        if id == "paste" { root.activate(root.selected); }
        else if id == "copy" { root.copy-only(root.selected); }
        else if id == "keep" { root.activate-keep(root.selected); }
        else if id == "edit" { root.start-edit(root.selected); }
        else if id == "snippet" { root.new-snippet(); }
        else if id == "pin" { root.toggle-pin(root.selected); }
        else if id == "slot" { root.open-slots(); }
        else if id == "merge" { root.toggle-merge(root.selected); }
        else if id == "note" { root.note-from-entry(root.selected); }
        else if id == "delete" { root.delete-entry(root.selected); }
        else if id == "export" { root.export-data(); }
        else if id == "bookmark" { root.bookmark-selected(); }
        else if id == "task-from-link" { root.task-from-link(); }
    }
    callback export-data();

    // "none" | "entry" | "snippet" — also drives the edit modal.
    in-out property <string> edit-mode: "none";
    in-out property <string> edit-text;
    callback start-edit(int);
    callback new-snippet();
    callback save-edit(string);
    callback cancel-edit();

    in property <[string]> selected-tags;
    in property <[string]> all-tags;
    in-out property <string> add-tag-text;
    in-out property <string> tag-filter;
    callback add-tag(int, string);
    callback remove-tag(int, string);
    callback set-tag-filter(string);

    in property <int> merge-count;
    in-out property <int> merge-sep: 0;
    callback toggle-merge(int);
    callback merge-paste();
    callback clear-merge();

    // Pinned filter + speed-dial slots.
    in-out property <bool> pinned-only: false;
    callback set-pinned-only(bool);
    in property <[SlotItem]> slots;
    // All nine slots (empty ones included) for the ⌘S assign picker.
    in property <[SlotItem]> all-slots;
    callback open-slots();
    callback paste-slot(int);

    // ⌘F advanced search.
    in property <[AppItem]> apps;
    // Active source-app filter (-1 = any) so the overlay can mark the current one.
    in-out property <int> app-index: -1;
    in-out property <int> time-index: 0;
    in property <bool> filtered: false;
    callback open-search();
    callback set-time-filter(int);
    callback set-app-filter(int);
    callback clear-filters();

    // ---- Notes mode ----
    in property <[NoteRow]> notes;
    in-out property <int> note-id: -1;
    in property <string> note-body;
    in property <string> note-provenance;
    in property <[string]> note-links;
    in property <[RefRow]> backlinks;
    in property <[RefRow]> unlinked;
    callback link-mention(int, int);
    in-out property <string> note-filter;
    // Distinct `#tag` tokens across all notes, for the tag-filter chip strip.
    in property <[string]> note-all-tags;
    // Active tag filter ("" = all notes).
    in-out property <string> note-tag-filter;
    callback filter-notes-by-tag(string);
    in-out property <bool> notes-mode: false;
    callback set-mode-notes(bool);
    callback open-note(int);
    callback new-note();
    callback open-page(string);
    callback edit-note-body(string);
    callback note-from-entry(int);
    // Promote the note line containing the given byte offset to a `- [ ]` task.
    callback promote-line(int);
    // Keyboard nav: move to the previous (-1) / next (+1) note and open it.
    callback nav-note(int);
    // ---- Notes mode: [[wiki-link]] autocomplete ----
    in property <[string]> note-suggestions;
    // Caret byte offset in note-body, kept in sync from the editor.
    in-out property <int> note-caret;
    // Edited text + caret byte offset together (drives suggestion computation).
    callback edit-note-body-at(string, int);
    // Accept a suggestion, closing the `[[…` link with the given note name.
    callback accept-note-suggestion(string);
    callback dismiss-note-suggestions();

    // ---- Tasks mode ----
    in property <[TaskRow]> tasks;
    in-out property <bool> tasks-mode: false;
    in-out property <bool> show-done: false;
    // Keyboard-selected task row index (Tasks mode).
    in-out property <int> task-selected: 0;
    in-out property <string> task-filter: "all";
    // Time tracking: the running task's title ("" if none) + live elapsed seconds.
    in property <string> active-title;
    in-out property <int> active-elapsed-sec;
    callback set-mode-tasks(bool);
    callback toggle-task(int, int);
    callback toggle-bookmark(int, int);
    callback toggle-timer(int, string);
    callback open-task-note(int);
    callback refresh-tasks();

    // ---- Bookmarks mode ----
    in-out property <bool> bookmarks-mode: false;
    in property <[BookmarkRow]> bookmarks;
    in-out property <string> bookmark-query;
    in-out property <string> bookmark-add-url;
    callback set-mode-bookmarks(bool);
    callback bookmark-search(string);
    callback add-bookmark(string);
    callback open-bookmark(string);
    callback delete-bookmark(int);
    callback bookmark-selected();
    // ⌘K "Create task from link": add the currently-selected entry as a task on
    callback task-from-link();

    // ---- Find everywhere (⌘⇧F): unified search over notes/tasks/bookmarks ----
    in-out property <bool> search-mode: false;
    in-out property <string> search-query;
    in property <[SearchNoteRow]> search-notes;
    in property <[SearchTaskRow]> search-tasks;
    in property <[SearchBookmarkRow]> search-bookmarks;
    callback run-unified-search(string);
    callback open-search-note(int);
    callback open-search-task(int);
    callback open-search-bookmark(string);
    callback close-search();

    // ---- Today mode ----
    in-out property <bool> today-mode: false;
    in property <[TaskRow]> today-due;
    in-out property <string> today-journal;
    in property <[ClipRow]> today-clips;
    callback set-mode-today(bool);
    callback edit-today-journal(string);
    callback today-paste-clip(int);

    // ---- Journal mode ----
    in-out property <bool> journal-mode: false;
    in property <[JournalRow]> journal;
    callback set-mode-journal(bool);
    callback edit-journal-entry(int, string);

    // ---- Board mode ----
    in-out property <bool> board-mode: false;
    callback set-mode-board(bool);
    in-out property <int> board-group: 0; // 0=Status, 1=Priority, 2=Project
    in-out property <int> board-layout: 0; // 0=Kanban, 1=List, 2=Grid, 3=Table
    in-out property <int> board-sort: 0; // 0=Due, 1=Priority, 2=Title, 3=Status
    in-out property <bool> board-hide-done: false;
    in-out property <string> board-project-filter; // "" = All
    in-out property <string> board-query;
    in property <[BoardColumn]> board;
    in property <[string]> board-projects;
    callback board-controls-changed();
    callback board-open-task(int);
    callback board-set-status(int, int, int); // note_id, line_index, status (0/1/2)
    // Kanban drag-to-move state — only meaningful while board-group == 0 (Status).
    in-out property <bool> board-drag-active;
    in-out property <int> board-drag-note;
    in-out property <int> board-drag-line;
    in-out property <string> board-drag-title;
    in-out property <length> board-drag-x;
    in-out property <length> board-drag-y;

    // ---- Graph mode ----
    in-out property <bool> graph-mode: false;
    callback set-mode-graph(bool);
    in property <[GraphNode]> graph-nodes;
    in property <[GraphEdge]> graph-edges;
    in property <int> graph-total;
    callback graph-open(int);

    // Re-focus the search field whenever we return to list mode.
    changed mode => {
        if root.mode == "list" {
            main.focus-input();
        }
    }

    // Rebuild the (virtualized) preview when the selection or reveal state changes.
    public function rebuild-preview() {
        if root.entries.length > 0 && root.selected >= 0 && root.selected < root.entries.length {
            root.preview-select(root.selected, entries[root.selected].masked, root.revealed);
        } else {
            root.preview-select(-1, false, false);
        }
    }
    changed selected => { root.rebuild-preview(); }
    changed revealed => { root.rebuild-preview(); }

    // Called from Rust right after the window is summoned to the front: return to
    public function summon() {
        root.mode = "list";
        root.selected = -1;
        root.selected = 0;
        main.focus-input();
    }

    // First-run welcome overlay: a one-time introduction shown by Rust on the
    in-out property <bool> show-welcome: false;
    callback dismiss-welcome();

    Rectangle {

        main := MainView {
            action-selected <=> root.action-selected;
            actions: root.actions;
            actions-backspace() => { root.actions-backspace(); }
            actions-key-char(a0) => { root.actions-key-char(a0); }
            activate(a0) => { root.activate(a0); }
            activate-keep(a0) => { root.activate-keep(a0); }
            activate-nth(a0) => { root.activate-nth(a0); }
            add-tag(a0, a1) => { root.add-tag(a0, a1); }
            add-tag-text <=> root.add-tag-text;
            all-tags: root.all-tags;
            assign-slot(a0, a1) => { root.assign-slot(a0, a1); }
            board-mode <=> root.board-mode;
            bookmarks-mode <=> root.bookmarks-mode;
            by-type-bars: root.by-type-bars;
            clear-filters() => { root.clear-filters(); }
            clear-merge() => { root.clear-merge(); }
            cmd-held <=> root.cmd-held;
            copy-only(a0) => { root.copy-only(a0); }
            delete-entry(a0) => { root.delete-entry(a0); }
            delete-time-entry(a0) => { root.delete-time-entry(a0); }
            dismiss-accessibility() => { root.dismiss-accessibility(); }
            entries: root.entries;
            filtered: root.filtered;
            graph-mode <=> root.graph-mode;
            hide-window() => { root.hide-window(); }
            journal-mode <=> root.journal-mode;
            merge-count: root.merge-count;
            merge-paste() => { root.merge-paste(); }
            merge-sep <=> root.merge-sep;
            mode <=> root.mode;
            most-copied-bars: root.most-copied-bars;
            nav-back() => { root.nav-back(); }
            nav-cycle-view(a0) => { root.nav-cycle-view(a0); }
            nav-forward() => { root.nav-forward(); }
            nav-leader <=> root.nav-leader;
            nav-previous() => { root.nav-previous(); }
            nav-section(a0) => { root.nav-section(a0); }
            needs-accessibility <=> root.needs-accessibility;
            new-snippet() => { root.new-snippet(); }
            note-from-entry(a0) => { root.note-from-entry(a0); }
            notes-mode <=> root.notes-mode;
            open-actions() => { root.open-actions(); }
            open-in-editor(a0) => { root.open-in-editor(a0); }
            open-search() => { root.open-search(); }
            open-slots() => { root.open-slots(); }
            over-time-bars: root.over-time-bars;
            over-time-caption: root.over-time-caption;
            paste-slot(a0) => { root.paste-slot(a0); }
            per-app-bars: root.per-app-bars;
            preview-font-size <=> root.preview-font-size;
            preview-has-image: root.preview-has-image;
            preview-image: root.preview-image;
            preview-lines: root.preview-lines;
            preview-text: root.preview-text;
            preview-truncated: root.preview-truncated;
            query <=> root.query;
            range-index <=> root.range-index;
            remove-tag(a0, a1) => { root.remove-tag(a0, a1); }
            revealed <=> root.revealed;
            run-action(a0) => { root.run-action(a0); }
            run-unified-search(a0) => { root.run-unified-search(a0); }
            screenshare: root.screenshare;
            search-changed(a0) => { root.search-changed(a0); }
            search-mode <=> root.search-mode;
            search-query <=> root.search-query;
            selected <=> root.selected;
            selected-tags: root.selected-tags;
            set-sort(a0) => { root.set-sort(a0); }
            set-tag-filter(a0) => { root.set-tag-filter(a0); }
            set-type-filter(a0) => { root.set-type-filter(a0); }
            sidebar-w <=> root.sidebar-w;
            slots: root.slots;
            sort-index <=> root.sort-index;
            start-edit(a0) => { root.start-edit(a0); }
            stats-range-changed(a0) => { root.stats-range-changed(a0); }
            tag-filter <=> root.tag-filter;
            target-app: root.target-app;
            target-has-icon: root.target-has-icon;
            target-icon: root.target-icon;
            tasks-mode <=> root.tasks-mode;
            time-by-day-bars: root.time-by-day-bars;
            time-by-project-bars: root.time-by-project-bars;
            time-entries: root.time-entries;
            time-week-total: root.time-week-total;
            today-mode <=> root.today-mode;
            toggle-merge(a0) => { root.toggle-merge(a0); }
            toggle-pin(a0) => { root.toggle-pin(a0); }
            toggle-screenshare() => { root.toggle-screenshare(); }
            totals-line: root.totals-line;
            type-index <=> root.type-index;
            view <=> root.view;
            zoom-preview(a0) => { root.zoom-preview(a0); }
        }

        // ---- Notes mode (opaque overlay covering the clipboard body) ----
        if root.notes-mode: NotesView {
            focus-search() => { main.focus-input(); }
            accept-note-suggestion(a0) => { root.accept-note-suggestion(a0); }
            backlinks: root.backlinks;
            dismiss-note-suggestions() => { root.dismiss-note-suggestions(); }
            edit-note-body-at(a0, a1) => { root.edit-note-body-at(a0, a1); }
            filter-notes-by-tag(a0) => { root.filter-notes-by-tag(a0); }
            link-mention(a0, a1) => { root.link-mention(a0, a1); }
            nav-back() => { root.nav-back(); }
            nav-cycle-view(a0) => { root.nav-cycle-view(a0); }
            nav-forward() => { root.nav-forward(); }
            nav-leader <=> root.nav-leader;
            nav-note(a0) => { root.nav-note(a0); }
            nav-previous() => { root.nav-previous(); }
            nav-section(a0) => { root.nav-section(a0); }
            new-note() => { root.new-note(); }
            note-all-tags: root.note-all-tags;
            note-body: root.note-body;
            note-caret <=> root.note-caret;
            note-filter <=> root.note-filter;
            note-id <=> root.note-id;
            note-links: root.note-links;
            note-provenance: root.note-provenance;
            note-suggestions: root.note-suggestions;
            note-tag-filter <=> root.note-tag-filter;
            notes: root.notes;
            notes-mode <=> root.notes-mode;
            notes-view <=> root.notes-view;
            open-note(a0) => { root.open-note(a0); }
            open-page(a0) => { root.open-page(a0); }
            promote-line(a0) => { root.promote-line(a0); }
            set-mode-notes(a0) => { root.set-mode-notes(a0); }
            set-note-view(a0) => { root.set-note-view(a0); }
            sidebar-w <=> root.sidebar-w;
            unlinked: root.unlinked;
        }

        // ---- Tasks mode (opaque overlay: flat, grouped/sorted task list) ----
        if root.tasks-mode: TasksView {
            focus-search() => { main.focus-input(); }
            active-elapsed-sec <=> root.active-elapsed-sec;
            active-title: root.active-title;
            nav-back() => { root.nav-back(); }
            nav-cycle-view(a0) => { root.nav-cycle-view(a0); }
            nav-forward() => { root.nav-forward(); }
            nav-leader <=> root.nav-leader;
            nav-previous() => { root.nav-previous(); }
            nav-section(a0) => { root.nav-section(a0); }
            open-task-note(a0) => { root.open-task-note(a0); }
            refresh-tasks() => { root.refresh-tasks(); }
            set-mode-tasks(a0) => { root.set-mode-tasks(a0); }
            set-task-view(a0) => { root.set-task-view(a0); }
            show-done <=> root.show-done;
            sidebar-w <=> root.sidebar-w;
            task-filter <=> root.task-filter;
            task-selected <=> root.task-selected;
            tasks: root.tasks;
            tasks-mode <=> root.tasks-mode;
            tasks-view <=> root.tasks-view;
            toggle-bookmark(a0, a1) => { root.toggle-bookmark(a0, a1); }
            toggle-task(a0, a1) => { root.toggle-task(a0, a1); }
            toggle-timer(a0, a1) => { root.toggle-timer(a0, a1); }
        }

        // ---- Board mode (opaque overlay: cross-project task board) ----
        if root.board-mode: BoardView {
            focus-search() => { main.focus-input(); }
            board: root.board;
            board-controls-changed() => { root.board-controls-changed(); }
            board-drag-active <=> root.board-drag-active;
            board-drag-line <=> root.board-drag-line;
            board-drag-note <=> root.board-drag-note;
            board-drag-title <=> root.board-drag-title;
            board-drag-x <=> root.board-drag-x;
            board-drag-y <=> root.board-drag-y;
            board-group <=> root.board-group;
            board-hide-done <=> root.board-hide-done;
            board-layout <=> root.board-layout;
            board-mode <=> root.board-mode;
            board-open-task(a0) => { root.board-open-task(a0); }
            board-project-filter <=> root.board-project-filter;
            board-projects: root.board-projects;
            board-query <=> root.board-query;
            board-set-status(a0, a1, a2) => { root.board-set-status(a0, a1, a2); }
            board-sort <=> root.board-sort;
            nav-back() => { root.nav-back(); }
            nav-cycle-view(a0) => { root.nav-cycle-view(a0); }
            nav-forward() => { root.nav-forward(); }
            nav-leader <=> root.nav-leader;
            nav-previous() => { root.nav-previous(); }
            nav-section(a0) => { root.nav-section(a0); }
            set-mode-board(a0) => { root.set-mode-board(a0); }
            set-task-view(a0) => { root.set-task-view(a0); }
            sidebar-w <=> root.sidebar-w;
            tasks-view <=> root.tasks-view;
        }

        // ---- Graph mode (opaque overlay: note-link graph) ----
        if root.graph-mode: GraphView {
            focus-search() => { main.focus-input(); }
            graph-edges: root.graph-edges;
            graph-mode <=> root.graph-mode;
            graph-nodes: root.graph-nodes;
            graph-open(a0) => { root.graph-open(a0); }
            graph-total: root.graph-total;
            nav-back() => { root.nav-back(); }
            nav-cycle-view(a0) => { root.nav-cycle-view(a0); }
            nav-forward() => { root.nav-forward(); }
            nav-leader <=> root.nav-leader;
            nav-previous() => { root.nav-previous(); }
            nav-section(a0) => { root.nav-section(a0); }
            notes-view <=> root.notes-view;
            set-mode-graph(a0) => { root.set-mode-graph(a0); }
            set-note-view(a0) => { root.set-note-view(a0); }
            sidebar-w <=> root.sidebar-w;
        }

        if root.bookmarks-mode: BookmarksView {
            add-bookmark(a0) => { root.add-bookmark(a0); }
            bookmark-add-url <=> root.bookmark-add-url;
            bookmark-query <=> root.bookmark-query;
            bookmark-search(a0) => { root.bookmark-search(a0); }
            bookmarks: root.bookmarks;
            bookmarks-mode <=> root.bookmarks-mode;
            delete-bookmark(a0) => { root.delete-bookmark(a0); }
            open-bookmark(a0) => { root.open-bookmark(a0); }
            sidebar-w <=> root.sidebar-w;
        }

        // ---- Today dashboard (full-window merge of the popover's Today +
        if root.today-mode: TodayView {
            active-elapsed-sec <=> root.active-elapsed-sec;
            active-title: root.active-title;
            edit-today-journal(a0) => { root.edit-today-journal(a0); }
            open-task-note(a0) => { root.open-task-note(a0); }
            set-task-view(a0) => { root.set-task-view(a0); }
            sidebar-w <=> root.sidebar-w;
            tasks-view <=> root.tasks-view;
            today-clips: root.today-clips;
            today-due: root.today-due;
            today-journal <=> root.today-journal;
            today-mode <=> root.today-mode;
            today-paste-clip(a0) => { root.today-paste-clip(a0); }
            toggle-task(a0, a1) => { root.toggle-task(a0, a1); }
        }

        // ---- Journal (chronological timeline over the daily notes) ----
        if root.journal-mode: JournalView {
            edit-journal-entry(a0, a1) => { root.edit-journal-entry(a0, a1); }
            journal: root.journal;
            journal-mode <=> root.journal-mode;
            notes-view <=> root.notes-view;
            set-note-view(a0) => { root.set-note-view(a0); }
            sidebar-w <=> root.sidebar-w;
        }

        // ---- Left sidebar: 5 section entry points (clipboard/tasks/notes/
        sidebar := Rectangle {
            x: 0;
            y: 0;
            width: root.sidebar-w;
            height: root.height;
            background: Theme.bg-sidebar;
            VerticalLayout {
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 2px;
                for s in [
                    { id: "clipboard", label: "Clip", icon: Icons.tab-clipboard, accent: Theme.sec-clip },
                    { id: "tasks", label: "Tasks", icon: Icons.tab-tasks, accent: Theme.sec-tasks },
                    { id: "notes", label: "Notes", icon: Icons.tab-notes, accent: Theme.sec-notes },
                    { id: "bookmarks", label: "Links", icon: Icons.type-link, accent: Theme.sec-links },
                    { id: "stats", label: "Stats", icon: Icons.tab-stats, accent: Theme.sec-stats },
                ]: Rectangle {
                    height: 54px;
                    // Active section = a solid fill in the section's accent color
                    background: root.section == s.id ? s.accent : (sbnav.has-hover ? Theme.bg-elevated : transparent);
                    sbnav := TouchArea { clicked => { root.set-section(s.id); } }
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: s.icon;
                                width: 18px;
                                height: 18px;
                                image-fit: contain;
                                colorize: root.section == s.id ? #16161a : Theme.text-dim;
                            }
                        }
                        Text {
                            text: s.label;
                            font-size: 9px;
                            horizontal-alignment: center;
                            color: root.section == s.id ? #16161a : Theme.text-dim;
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                // ---- Theme picker: bottom of the sidebar. Opens a popup of all
                Rectangle {
                    height: 40px;
                    background: themeta.has-hover ? Theme.bg-elevated : transparent;
                    themeta := TouchArea { clicked => { themepop.show(); } }
                    Image {
                        source: Icons.theme;
                        width: 16px;
                        height: 16px;
                        image-fit: contain;
                        colorize: Theme.text-dim;
                    }
                    themepop := PopupWindow {
                        x: parent.width + 6px;
                        y: parent.height - self.height;
                        width: 210px;
                        height: min(Theme.palettes.length * 34px + 12px, 360px);
                        Rectangle {
                            background: Theme.bg-panel;
                            border-color: Theme.border-strong;
                            border-width: 1px;
                            border-radius: 10px;
                            Flickable {
                                viewport-height: Theme.palettes.length * 34px + 12px;
                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 2px;
                                    for pal[i] in Theme.palettes: Rectangle {
                                        height: 30px;
                                        border-radius: 6px;
                                        background: root.theme-index == i
                                            ? Theme.bg-elevated
                                            : (themerowta.has-hover ? Theme.bg-elevated : transparent);
                                        themerowta := TouchArea {
                                            clicked => { root.set-theme(i); themepop.close(); }
                                        }
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 8px;
                                            alignment: start;
                                            VerticalLayout {
                                                alignment: center;
                                                // Swatch: the palette's app bg with an accent ring.
                                                Rectangle {
                                                    width: 16px; height: 16px;
                                                    border-radius: 4px;
                                                    background: pal.bg-app;
                                                    border-color: pal.accent;
                                                    border-width: 2px;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: pal.name;
                                                    color: Theme.text;
                                                    font-size: Theme.fs-body;
                                                    overflow: elide;
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            VerticalLayout {
                                                alignment: center;
                                                // Selected marker: a drawn accent dot (no glyphs).
                                                Rectangle {
                                                    width: 8px; height: 8px;
                                                    border-radius: 4px;
                                                    background: root.theme-index == i ? Theme.accent : transparent;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---- Find everywhere (⌘⇧F): unified search over notes/tasks/bookmarks.
        if root.search-mode: FindView {
            focus-search() => { main.focus-input(); }
            close-search() => { root.close-search(); }
            open-search-bookmark(a0) => { root.open-search-bookmark(a0); }
            open-search-note(a0) => { root.open-search-note(a0); }
            open-search-task(a0) => { root.open-search-task(a0); }
            run-unified-search(a0) => { root.run-unified-search(a0); }
            search-bookmarks: root.search-bookmarks;
            search-mode <=> root.search-mode;
            search-notes: root.search-notes;
            search-query <=> root.search-query;
            search-tasks: root.search-tasks;
        }

        // ---- Help modal (centered overlay) ----
        if root.mode == "help": HelpView {
            mode <=> root.mode;
        }

        // ---- Accessibility permission modal (macOS auto-paste) ----
        if root.needs-accessibility: AccessibilityView {
            dismiss-accessibility() => { root.dismiss-accessibility(); }
            needs-accessibility <=> root.needs-accessibility;
            open-accessibility-settings() => { root.open-accessibility-settings(); }
            recheck-accessibility() => { root.recheck-accessibility(); }
        }

        // ---- ⌘F advanced search overlay ----
        if root.mode == "search": FiltersView {
            app-index <=> root.app-index;
            apps: root.apps;
            clear-filters() => { root.clear-filters(); }
            mode <=> root.mode;
            pinned-only <=> root.pinned-only;
            set-app-filter(a0) => { root.set-app-filter(a0); }
            set-pinned-only(a0) => { root.set-pinned-only(a0); }
            set-sort(a0) => { root.set-sort(a0); }
            set-time-filter(a0) => { root.set-time-filter(a0); }
            sort-index <=> root.sort-index;
            time-index <=> root.time-index;
        }

        // ---- ⌘K actions palette overlay (searchable) ----
        if root.mode == "actions": ActionsView {
            action-selected <=> root.action-selected;
            actions: root.actions;
            actions-query <=> root.actions-query;
            mode <=> root.mode;
            run-action(a0) => { root.run-action(a0); }
        }

        // ---- ⌘S slot picker ----
        if root.mode == "slots": SlotsView {
            all-slots: root.all-slots;
            assign-slot(a0, a1) => { root.assign-slot(a0, a1); }
            entries: root.entries;
            mode <=> root.mode;
            selected <=> root.selected;
        }

        // ---- Edit / new-snippet modal ----
        if root.edit-mode != "none": EditorView {
            cancel-edit() => { root.cancel-edit(); }
            edit-mode <=> root.edit-mode;
            edit-text <=> root.edit-text;
            save-edit(a0) => { root.save-edit(a0); }
        }
    }

    // ---- First-run welcome overlay ----
    if root.show-welcome: WelcomeView {
        dismiss-welcome() => { root.dismiss-welcome(); }
        show-welcome <=> root.show-welcome;
    }

    // ---- Kanban drag ghost ----
    if root.board-drag-active: Rectangle {
        x: root.board-drag-x - 120px;
        y: root.board-drag-y - 18px;
        width: 240px;
        height: 36px;
        background: Theme.bg-elevated;
        border-radius: 6px;
        border-width: 1px;
        border-color: Pal.accent;
        opacity: 0.95;
        Text {
            text: root.board-drag-title;
            color: Theme.text;
            font-size: 13px;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ---- g-leader hint ----
    if root.nav-leader: Rectangle {
        x: 12px;
        y: root.height - 40px;
        height: 28px;
        width: hint-text.preferred-width + 20px;
        background: Theme.bg-app;
        border-radius: 6px;
        border-width: 1px;
        border-color: Pal.accent;
        hint-text := Text {
            x: 10px;
            text: "g → c·t·n·b·s";
            color: Theme.text;
            font-size: 12px;
            vertical-alignment: center;
            height: 100%;
        }
    }
}

export { Popover } from "views/popover.slint";
