import { LineEdit, ListView, TextEdit, ScrollView } from "std-widgets.slint";

struct EntryRow {
    title: string,
    subtitle: string,
    kind: string,
    slot: int,
    merged: bool,
    badge: string,
    glyph: string,
    source: string,
    when: string,
    copied: int,
    size: string,
    masked: bool,
    icon: image,
    has_icon: bool,
    words: int,
    section: string,
    copied_date: string,
    pinned: bool,
    // The entry's OWN content preview, as opposed to `icon` (the source app):
    // a thumbnail for image entries, a swatch colour for colour entries.
    thumb: image,
    has_thumb: bool,
    swatch: color,
    has_swatch: bool,
}

struct Bar {
    label: string,
    display: string,
    value_norm: float,
}

struct ActionItem {
    icon: string,
    label: string,
    key: string,
    id: string,
}

struct SlotItem {
    n: int,
    title: string,
    filled: bool,
}

struct AppItem {
    id: int,
    name: string,
}

struct NoteRow {
    id: int,
    title: string,
    when: string,
    is_daily: bool,
    tags: string,
}

struct BookmarkRow {
    id: int,
    title: string,
    domain: string,
    url: string,
    icon: image,
    has_icon: bool,
    tags: string,
}

struct JournalRow {
    note_id: int,
    date: string,
    body: string,
}

struct RefRow {
    note_id: int,
    line_index: int,
    source: string,
    line: string,
}

// A single task row (a `- [ ]` line parsed out of a note). `priority` is 0=High,
// 1=Medium, 2=Low, 3=None; `due` is a pre-formatted date string (empty if none);
// `source` is the owning note's name.
struct TaskRow {
    note_id: int,
    line_index: int,
    title: string,
    done: bool,
    // In-progress (`- [/]`), the Obsidian/Logseq convention. Mutually exclusive
    // with `done`; drives the amber half-filled checkbox glyph.
    doing: bool,
    priority: int,
    due: string,
    project: string,
    source: string,
    recur: string,
    overdue: bool,
    bookmarked: bool,
    tracking: bool,
    time_total: string,
}

// One column of the cross-project task Board (Kanban/List layouts share this
// shape — see `magpie_app::tasks::board_columns`).
struct BoardColumn {
    title: string,
    count: int,
    tasks: [TaskRow],
}

struct ClipRow {
    title: string,
    glyph: string,
    kind: string,
}

// A single tracked session in the Stats → "Recent sessions" list.
struct TimeEntryRow {
    id: int,
    title: string,
    when: string,      // e.g. "2h ago" (relative_time)
    duration: string,  // fmt_duration, or ignored when `running`
    running: bool,
}

// ---- "Find everywhere" palette rows (unified search over notes/tasks/bookmarks) ----
struct SearchNoteRow {
    id: int,
    title: string,
}

struct SearchTaskRow {
    id: int,
    title: string,
}

struct SearchBookmarkRow {
    url: string,
    title: string,
}

// Accent + the text colour that is legible ON the accent. White-on-accent only
// reaches ~2.9:1, so filled controls use `on-accent` for their label.
global Pal {
    out property <color> accent: #6a8cff;
    out property <color> on-accent: #101426;
}

// Custom monochrome line icons (replace emoji glyphs). Each is a single-colour SVG
// tinted at the use-site via `Image.colorize`, so one file serves every state.
global Icons {
    out property <image> tab-tasks: @image-url("../../../assets/icons/tab-tasks.svg");
    out property <image> tab-today: @image-url("../../../assets/icons/tab-today.svg");
    out property <image> tab-daily: @image-url("../../../assets/icons/tab-daily.svg");
    out property <image> tab-clipboard: @image-url("../../../assets/icons/tab-clipboard.svg");
    out property <image> type-text: @image-url("../../../assets/icons/type-text.svg");
    out property <image> type-link: @image-url("../../../assets/icons/type-link.svg");
    out property <image> type-color: @image-url("../../../assets/icons/type-color.svg");
    out property <image> type-email: @image-url("../../../assets/icons/type-email.svg");
    out property <image> type-image: @image-url("../../../assets/icons/type-image.svg");
    out property <image> type-file: @image-url("../../../assets/icons/type-file.svg");
    out property <image> act-paste: @image-url("../../../assets/icons/act-paste.svg");
    out property <image> act-copy: @image-url("../../../assets/icons/act-copy.svg");
    out property <image> act-keep: @image-url("../../../assets/icons/act-keep.svg");
    out property <image> act-edit: @image-url("../../../assets/icons/act-edit.svg");
    out property <image> act-snippet: @image-url("../../../assets/icons/act-snippet.svg");
    out property <image> act-pin: @image-url("../../../assets/icons/act-pin.svg");
    out property <image> act-slot: @image-url("../../../assets/icons/act-slot.svg");
    out property <image> act-merge: @image-url("../../../assets/icons/act-merge.svg");
    out property <image> act-note: @image-url("../../../assets/icons/act-note.svg");
    out property <image> act-delete: @image-url("../../../assets/icons/act-delete.svg");
    out property <image> act-export: @image-url("../../../assets/icons/act-export.svg");
}

// A type-kind glyph: picks the icon by `Kind::as_str()` value (rtf/html/text → text).
component TypeIcon inherits Image {
    in property <string> kind;
    in property <color> tint: #b8b8be;
    image-fit: contain;
    colorize: root.tint;
    source: root.kind == "link" ? Icons.type-link
        : root.kind == "color" ? Icons.type-color
        : root.kind == "email" ? Icons.type-email
        : root.kind == "image" ? Icons.type-image
        : root.kind == "file" ? Icons.type-file
        : Icons.type-text;
}

// A ⌘K action glyph: picks the icon by action id (unknown → paste).
component ActionIcon inherits Image {
    in property <string> id;
    in property <color> tint: #d0d0d4;
    image-fit: contain;
    colorize: root.tint;
    source: root.id == "copy" ? Icons.act-copy
        : root.id == "keep" ? Icons.act-keep
        : root.id == "edit" ? Icons.act-edit
        : root.id == "snippet" ? Icons.act-snippet
        : root.id == "pin" ? Icons.act-pin
        : root.id == "slot" ? Icons.act-slot
        : root.id == "merge" ? Icons.act-merge
        : root.id == "note" ? Icons.act-note
        : root.id == "delete" ? Icons.act-delete
        : root.id == "export" ? Icons.act-export
        : Icons.act-paste;
}

// A labeled horizontal bar: [ label ][=== track ===][ value ]
component HBar inherits Rectangle {
    in property <string> label;
    in property <string> display;
    in property <float> value_norm;
    height: 22px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: label;
            color: #d0d0d4;
            font-size: 11px;
            width: 180px;
            overflow: elide;
            vertical-alignment: center;
        }
        track := Rectangle {
            background: #2a2a30;
            border-radius: 3px;
            Rectangle {
                x: 0;
                y: 0;
                height: parent.height;
                width: track.width * value_norm;
                background: #6a8cff;
                border-radius: 3px;
            }
        }
        Text {
            text: display;
            color: #9a9aa0;
            font-size: 11px;
            width: 48px;
            vertical-alignment: center;
        }
    }
}

// A single task row shared by the popover's Tasks/Today tabs and the launcher's
// Today dashboard: a circle checkbox toggle + title + due/project/recur badges.
component PopoverTaskRow inherits Rectangle {
    in property <TaskRow> t;
    callback toggle();
    callback open();
    height: 40px;
    background: prow.has-hover ? #26262c : transparent;
    border-radius: 6px;
    prow := TouchArea { clicked => { root.open(); } }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Rectangle {
            width: 24px;
            Rectangle {
                y: 11px;
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: 1px;
                border-color: root.t.doing && !root.t.done ? #e0a44a : #6a6a72;
                background: root.t.done ? Pal.accent : (root.t.doing ? #e0a44a33 : transparent);
                if root.t.done: Text {
                    text: "✓";
                    color: Pal.on-accent;
                    font-size: 11px;
                    width: 18px;
                    height: 18px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if !root.t.done && root.t.doing: Text {
                    text: "◐";
                    color: #e0a44a;
                    font-size: 12px;
                    width: 18px;
                    height: 18px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            TouchArea { clicked => { root.toggle(); } }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            padding-top: 5px;
            padding-bottom: 5px;
            Text {
                text: root.t.title;
                color: root.t.done ? #6a6a70 : white;
                font-size: 13px;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if root.t.due != "": Text { text: root.t.due; color: root.t.overdue ? #e06a6a : #9a9aa0; font-size: 10px; vertical-alignment: center; }
                if root.t.project != "": Text { text: "#" + root.t.project; color: #9ab0ff; font-size: 10px; vertical-alignment: center; }
                if root.t.recur != "": Text { text: root.t.recur; color: #7ad7a0; font-size: 10px; vertical-alignment: center; }
            }
        }
    }
}

// A Board card: title + priority pill + due (red if overdue) + project chip,
// with three tiny status targets (To do / Doing / Done) and a click-through to
// the owning note. Shared by the Kanban and List board layouts.
component BoardCard inherits Rectangle {
    in property <TaskRow> t;
    callback open();
    callback set-status(int); // 0=Todo, 1=Doing, 2=Done
    height: 72px;
    background: bcta.has-hover ? #26262c : #202024;
    border-radius: 8px;
    bcta := TouchArea { clicked => { root.open(); } }
    VerticalLayout {
        padding: 8px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.t.title;
                color: root.t.done ? #6a6a70 : white;
                font-size: 13px;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            if root.t.priority <= 2: Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 4px;
                background: root.t.priority == 0 ? #e05a5a : (root.t.priority == 1 ? #e0a44a : #6a8cff);
                Text {
                    text: root.t.priority == 0 ? "H" : (root.t.priority == 1 ? "M" : "L");
                    color: #16161a;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            if root.t.due != "": Text { text: root.t.due; color: root.t.overdue ? #e06a6a : #9a9aa0; font-size: 10px; vertical-alignment: center; }
            if root.t.project != "": Text { text: "#" + root.t.project; color: #9ab0ff; font-size: 10px; vertical-alignment: center; overflow: elide; }
        }
        // Status targets: click one to move the card straight to that column.
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            for glyph[i] in ["○", "◐", "●"]: Rectangle {
                width: 18px;
                height: 16px;
                sst := TouchArea { clicked => { root.set-status(i); } }
                Text {
                    text: glyph;
                    color: (i == 0 && !root.t.done && !root.t.doing) ? Pal.accent
                        : (i == 1 && root.t.doing) ? #e0a44a
                        : (i == 2 && root.t.done) ? #7ad7a0
                        : (sst.has-hover ? #d0d0d4 : #55555f);
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component LauncherWindow inherits Window {
    title: "Magpie";
    preferred-width: 900px;
    preferred-height: 560px;
    background: #1e1e21;
    forward-focus: searchinput;

    in property <[EntryRow]> entries;
    in-out property <string> query;
    in-out property <int> selected: 0;
    // "list" | "edit" | "actions" — gates keyboard routing.
    in-out property <string> mode: "list";
    in-out property <int> type-index: 0;
    in-out property <int> sort-index: 0;
    in-out property <int> action-selected: 0;
    in property <bool> screenshare: false;
    in-out property <bool> revealed: false;
    // True while the primary modifier (⌘ on macOS / Ctrl elsewhere) is held —
    // lights up the 1-9 quick-paste badges.
    in-out property <bool> cmd-held: false;
    // The app that was frontmost when the launcher opened (paste target).
    in property <string> target-app: "";
    in property <image> target-icon;
    in property <bool> target-has-icon: false;

    in-out property <string> view: "list";
    in property <[Bar]> over-time-bars;
    in property <[Bar]> most-copied-bars;
    in property <[Bar]> per-app-bars;
    in property <[Bar]> by-type-bars;
    in property <string> time-week-total;
    in property <[Bar]> time-by-day-bars;
    in property <[Bar]> time-by-project-bars;
    in property <[TimeEntryRow]> time-entries;
    callback delete-time-entry(int);
    in property <string> totals-line;
    // "2026-08-04 → 2026-09-02 · peak 21 copies in a day" under the bar chart.
    in property <string> over-time-caption;
    in-out property <int> range-index: 1;

    callback search-changed(string);
    // Detail preview is a virtualized line list — Rust pushes the (bounded) lines
    // for the selected entry so only visible lines are ever shaped.
    in property <[string]> preview-lines;
    // Image entries: the decoded bitmap for the selected entry. Without this the
    // preview pane was simply blank for every image.
    in property <image> preview-image;
    in property <bool> preview-has-image: false;
    // Selectable preview text for normal-size entries (empty for huge ones, which
    // fall back to the fast virtualized line list). Lets the user select + ⌘C copy.
    in property <string> preview-text;
    in property <bool> preview-truncated: false;
    // Preview font size — ⌘+ / ⌘- adjust it, ⌘0 resets (clamped in Rust callbacks).
    in-out property <length> preview-font-size: 13px;
    callback zoom-preview(int); // +1 bigger, -1 smaller, 0 reset
    callback preview-select(int, bool, bool);
    callback open-in-editor(int);
    callback activate(int);
    callback activate-nth(int);
    callback copy-only(int);
    callback stats-range-changed(int);
    callback toggle-view();
    callback assign-slot(int, int);
    callback set-type-filter(int);
    callback set-sort(int);
    callback hide-window();
    // Accessibility (macOS auto-paste permission) modal.
    in-out property <bool> needs-accessibility: false;
    callback open-accessibility-settings();
    callback recheck-accessibility();
    callback dismiss-accessibility();
    callback toggle-pin(int);
    callback toggle-screenshare();
    callback delete-entry(int);
    callback activate-keep(int);
    // ⌘K actions menu (Rust owns the filtered model; Slint dispatches by id).
    in property <[ActionItem]> actions;
    in-out property <string> actions-query: "";
    callback open-actions();
    callback actions-key-char(string);
    callback actions-backspace();
    callback run-action(string);
    // Close the palette FIRST so an action that opens another overlay (⌘S) wins.
    run-action(id) => {
        root.mode = "list";
        if id == "paste" { root.activate(root.selected); }
        else if id == "copy" { root.copy-only(root.selected); }
        else if id == "keep" { root.activate-keep(root.selected); }
        else if id == "edit" { root.start-edit(root.selected); }
        else if id == "snippet" { root.new-snippet(); }
        else if id == "pin" { root.toggle-pin(root.selected); }
        else if id == "slot" { root.open-slots(); }
        else if id == "merge" { root.toggle-merge(root.selected); }
        else if id == "note" { root.note-from-entry(root.selected); }
        else if id == "delete" { root.delete-entry(root.selected); }
        else if id == "export" { root.export-data(); }
        else if id == "bookmark" { root.bookmark-selected(); }
    }
    callback export-data();

    // "none" | "entry" | "snippet" — also drives the edit modal.
    in-out property <string> edit-mode: "none";
    in-out property <string> edit-text;
    callback start-edit(int);
    callback new-snippet();
    callback save-edit(string);
    callback cancel-edit();

    in property <[string]> selected-tags;
    in property <[string]> all-tags;
    in-out property <string> add-tag-text;
    in-out property <string> tag-filter;
    callback add-tag(int, string);
    callback remove-tag(int, string);
    callback set-tag-filter(string);

    in property <int> merge-count;
    in-out property <int> merge-sep: 0;
    callback toggle-merge(int);
    callback merge-paste();
    callback clear-merge();

    // Pinned filter + speed-dial slots.
    in-out property <bool> pinned-only: false;
    callback set-pinned-only(bool);
    in property <[SlotItem]> slots;
    // All nine slots (empty ones included) for the ⌘S assign picker.
    in property <[SlotItem]> all-slots;
    callback open-slots();
    callback paste-slot(int);

    // ⌘F advanced search.
    in property <[AppItem]> apps;
    // Active source-app filter (-1 = any) so the overlay can mark the current one.
    in-out property <int> app-index: -1;
    in-out property <int> time-index: 0;
    in property <bool> filtered: false;
    callback open-search();
    callback set-time-filter(int);
    callback set-app-filter(int);
    callback clear-filters();

    // ---- Notes mode ----
    in property <[NoteRow]> notes;
    in-out property <int> note-id: -1;
    in property <string> note-body;
    in property <string> note-provenance;
    in property <[string]> note-links;
    in property <[RefRow]> backlinks;
    in property <[RefRow]> unlinked;
    callback link-mention(int, int);
    in-out property <string> note-filter;
    // Distinct `#tag` tokens across all notes, for the tag-filter chip strip.
    in property <[string]> note-all-tags;
    // Active tag filter ("" = all notes).
    in-out property <string> note-tag-filter;
    callback filter-notes-by-tag(string);
    in-out property <bool> notes-mode: false;
    callback set-mode-notes(bool);
    callback open-note(int);
    callback new-note();
    callback open-page(string);
    callback edit-note-body(string);
    callback note-from-entry(int);
    // Promote the note line containing the given byte offset to a `- [ ]` task.
    callback promote-line(int);
    // Keyboard nav: move to the previous (-1) / next (+1) note and open it.
    callback nav-note(int);
    // ---- Notes mode: [[wiki-link]] autocomplete ----
    // Matching note names for the currently-open `[[…` query (empty = no popup).
    in property <[string]> note-suggestions;
    // Caret byte offset in note-body, kept in sync from the editor.
    in-out property <int> note-caret;
    // Edited text + caret byte offset together (drives suggestion computation).
    callback edit-note-body-at(string, int);
    // Accept a suggestion, closing the `[[…` link with the given note name.
    callback accept-note-suggestion(string);
    callback dismiss-note-suggestions();

    // ---- Tasks mode ----
    in property <[TaskRow]> tasks;
    in-out property <bool> tasks-mode: false;
    in-out property <bool> show-done: false;
    // Keyboard-selected task row index (Tasks mode).
    in-out property <int> task-selected: 0;
    in-out property <string> task-filter: "all";
    // Time tracking: the running task's title ("" if none) + live elapsed seconds.
    in property <string> active-title;
    in-out property <int> active-elapsed-sec;
    callback set-mode-tasks(bool);
    callback toggle-task(int, int);
    callback toggle-bookmark(int, int);
    callback toggle-timer(int, string);
    callback open-task-note(int);
    callback refresh-tasks();

    // ---- Bookmarks mode ----
    in-out property <bool> bookmarks-mode: false;
    in property <[BookmarkRow]> bookmarks;
    in-out property <string> bookmark-query;
    in-out property <string> bookmark-add-url;
    callback set-mode-bookmarks(bool);
    callback bookmark-search(string);
    callback add-bookmark(string);
    callback open-bookmark(string);
    callback delete-bookmark(int);
    callback bookmark-selected();

    // ---- Find everywhere (⌘⇧F): unified search over notes/tasks/bookmarks ----
    in-out property <bool> search-mode: false;
    in-out property <string> search-query;
    in property <[SearchNoteRow]> search-notes;
    in property <[SearchTaskRow]> search-tasks;
    in property <[SearchBookmarkRow]> search-bookmarks;
    callback run-unified-search(string);
    callback open-search-note(int);
    callback open-search-task(int);
    callback open-search-bookmark(string);
    callback close-search();

    // ---- Today mode ----
    // A full-window dashboard merging the popover's Today + Daily + Clipboard
    // tabs: due/overdue tasks, the running timer, today's journal, and recent
    // clips.
    in-out property <bool> today-mode: false;
    in property <[TaskRow]> today-due;
    in-out property <string> today-journal;
    in property <[ClipRow]> today-clips;
    callback set-mode-today(bool);
    callback edit-today-journal(string);
    callback today-paste-clip(int);

    // ---- Journal mode ----
    // A chronological timeline over the daily notes, each rendered as an
    // editable card (newest first).
    in-out property <bool> journal-mode: false;
    in property <[JournalRow]> journal;
    callback set-mode-journal(bool);
    callback edit-journal-entry(int, string);

    // ---- Board mode ----
    // A cross-project task board: every task, grouped/sorted/filtered into
    // columns (`magpie_app::tasks::board_columns` is the single source of
    // truth — Rust rebuilds `board` on any control change).
    in-out property <bool> board-mode: false;
    callback set-mode-board(bool);
    in-out property <int> board-group: 0; // 0=Status, 1=Priority, 2=Project
    in-out property <int> board-layout: 0; // 0=Kanban, 1=List, 2=Grid, 3=Table
    in-out property <int> board-sort: 0; // 0=Due, 1=Priority, 2=Title, 3=Status
    in-out property <bool> board-hide-done: false;
    in-out property <string> board-project-filter; // "" = All
    in-out property <string> board-query;
    in property <[BoardColumn]> board;
    in property <[string]> board-projects;
    callback board-controls-changed();
    callback board-open-task(int);
    callback board-set-status(int, int, int); // note_id, line_index, status (0/1/2)

    // Re-focus the search field whenever we return to list mode.
    changed mode => {
        if root.mode == "list" {
            searchinput.focus();
        }
    }

    // Rebuild the (virtualized) preview when the selection or reveal state changes.
    public function rebuild-preview() {
        if root.entries.length > 0 && root.selected >= 0 && root.selected < root.entries.length {
            root.preview-select(root.selected, entries[root.selected].masked, root.revealed);
        } else {
            root.preview-select(-1, false, false);
        }
    }
    changed selected => { root.rebuild-preview(); }
    changed revealed => { root.rebuild-preview(); }

    // Called from Rust right after the window is summoned to the front: return to
    // the list, focus the search field so typing filters immediately, and select
    // the top item (the -1→0 nudge forces the scroll-follow + preview rebuild even
    // when the selection was already 0).
    public function summon() {
        root.mode = "list";
        root.selected = -1;
        root.selected = 0;
        searchinput.focus();
    }

    // First-run welcome overlay: a one-time introduction shown by Rust on the
    // very first launch (see `runtime::start`'s `.onboarded` marker).
    in-out property <bool> show-welcome: false;
    callback dismiss-welcome();

    Rectangle {

        VerticalLayout {
            padding: 8px;
            spacing: 8px;

            // Command-bar search — a real TextInput (native cursor + editing
            // shortcuts). It owns keyboard focus; nav/our ⌘-shortcuts are
            // intercepted in key-pressed, everything else falls through to editing.
            Rectangle {
                height: 44px;
                background: #161618;
                border-radius: 10px;
                border-width: 1px;
                border-color: searchinput.has-focus ? #4a4a58 : #33333c;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 12px;
                    spacing: 8px;
                    Rectangle {
                        horizontal-stretch: 1;
                        if root.query == "": Text {
                            x: 0;
                            text: "Search clipboard…";
                            color: #6a6a70;
                            font-size: 15px;
                            vertical-alignment: center;
                        }
                        searchinput := TextInput {
                            width: 100%;
                            height: 100%;
                            text <=> root.query;
                            color: white;
                            font-size: 15px;
                            single-line: true;
                            vertical-alignment: center;
                            edited => {
                                root.search-changed(self.text);
                            }
                            key-released(event) => {
                                root.cmd-held = event.modifiers.control;
                                return reject;
                            }
                            key-pressed(event) => {
                                root.cmd-held = event.modifiers.control;
                                // ---- overlays / non-list modes: swallow, route to overlay ----
                                if root.mode == "help" {
                                    if event.text == Key.Escape || event.text == "?" || (event.modifiers.control && event.text == "/") { root.mode = "list"; }
                                    return accept;
                                }
                                if root.mode == "search" {
                                    if event.text == Key.Escape { root.mode = "list"; }
                                    return accept;
                                }
                                // Slot picker: 1–9 assigns (or clears, if the slot
                                // already holds this entry) and returns to the list.
                                if root.mode == "slots" {
                                    if event.text == Key.Escape { root.mode = "list"; return accept; }
                                    if event.text == "1" { root.assign-slot(root.selected, 1); root.mode = "list"; return accept; }
                                    if event.text == "2" { root.assign-slot(root.selected, 2); root.mode = "list"; return accept; }
                                    if event.text == "3" { root.assign-slot(root.selected, 3); root.mode = "list"; return accept; }
                                    if event.text == "4" { root.assign-slot(root.selected, 4); root.mode = "list"; return accept; }
                                    if event.text == "5" { root.assign-slot(root.selected, 5); root.mode = "list"; return accept; }
                                    if event.text == "6" { root.assign-slot(root.selected, 6); root.mode = "list"; return accept; }
                                    if event.text == "7" { root.assign-slot(root.selected, 7); root.mode = "list"; return accept; }
                                    if event.text == "8" { root.assign-slot(root.selected, 8); root.mode = "list"; return accept; }
                                    if event.text == "9" { root.assign-slot(root.selected, 9); root.mode = "list"; return accept; }
                                    return accept;
                                }
                                if root.mode == "actions" {
                                    if event.text == Key.UpArrow { if root.action-selected > 0 { root.action-selected -= 1; } return accept; }
                                    if event.text == Key.DownArrow { if root.action-selected < root.actions.length - 1 { root.action-selected += 1; } return accept; }
                                    if event.text == Key.Escape { root.mode = "list"; return accept; }
                                    if event.text == Key.Return { if root.actions.length > 0 && root.action-selected < root.actions.length { root.run-action(root.actions[root.action-selected].id); } return accept; }
                                    if event.text == Key.Backspace { root.actions-backspace(); return accept; }
                                    if event.text == Key.Tab || event.text == Key.Delete || event.text == Key.Home
                                        || event.text == Key.End || event.text == Key.PageUp || event.text == Key.PageDown
                                        || event.text == Key.LeftArrow || event.text == Key.RightArrow
                                        || event.text == Key.Shift || event.text == Key.Control
                                        || event.text == Key.Alt || event.text == Key.Meta {
                                        return accept;
                                    }
                                    if event.text.character-count == 1 { root.actions-key-char(event.text); }
                                    return accept;
                                }
                                if root.view == "stats" {
                                    if event.text == Key.Escape { root.view = "list"; return accept; }
                                    // Type-to-search from Stats: a printable key drops back to
                                    // the list and lands in the search field (so the field is
                                    // never a dead control).
                                    if event.text == Key.Return || event.text == Key.Backspace
                                        || event.text == Key.Tab || event.text == Key.Delete
                                        || event.text == Key.UpArrow || event.text == Key.DownArrow
                                        || event.text == Key.LeftArrow || event.text == Key.RightArrow
                                        || event.text == Key.Home || event.text == Key.End
                                        || event.text == Key.PageUp || event.text == Key.PageDown
                                        || event.text == Key.Shift || event.text == Key.Control
                                        || event.text == Key.Alt || event.text == Key.Meta {
                                        return accept;
                                    }
                                    if !event.modifiers.control && event.text.character-count == 1 {
                                        root.view = "list";
                                        return reject;
                                    }
                                    return accept;
                                }
                                // ---- list mode: intercept nav + our shortcuts; rest is native editing ----
                                if event.text == Key.UpArrow {
                                    if root.selected > 0 { root.selected -= 1; }
                                    return accept;
                                }
                                if event.text == Key.DownArrow {
                                    if root.selected < root.entries.length - 1 { root.selected += 1; }
                                    return accept;
                                }
                                if event.text == Key.Return {
                                    if event.modifiers.control { root.activate-keep(root.selected); } else { root.activate(root.selected); }
                                    return accept;
                                }
                                if event.text == Key.Escape {
                                    if root.needs-accessibility { root.dismiss-accessibility(); return accept; }
                                    if root.query != "" { self.text = ""; root.search-changed(""); return accept; }
                                    root.hide-window();
                                    return accept;
                                }
                                if event.modifiers.control {
                                    // ⌘⌫ deletes the selected entry (Finder's "move to trash"
                                    // idiom). Esc still clears the whole query, ⌥⌫ a word.
                                    if event.text == Key.Backspace { root.delete-entry(root.selected); return accept; }
                                    if event.text == "c" { root.copy-only(root.selected); return accept; }
                                    if event.text == "k" { root.open-actions(); return accept; }
                                    if event.text == "s" { root.open-slots(); return accept; }
                                    // ⌘⇧F — "Find everywhere": must be checked before the
                                    // plain ⌘F filters shortcut below (some backends still
                                    // report the unshifted "f" while shift is held).
                                    if event.modifiers.shift && (event.text == "f" || event.text == "F") {
                                        root.notes-mode = false;
                                        root.tasks-mode = false;
                                        root.bookmarks-mode = false;
                                        root.today-mode = false;
                                        root.journal-mode = false;
                                        root.board-mode = false;
                                        root.search-query = "";
                                        root.search-mode = true;
                                        root.run-unified-search("");
                                        return accept;
                                    }
                                    if event.text == "f" { root.open-search(); return accept; }
                                    if event.text == "/" { root.mode = "help"; return accept; }
                                    if event.text == "e" { root.start-edit(root.selected); return accept; }
                                    if event.text == "n" { root.new-snippet(); return accept; }
                                    if event.text == "g" { root.toggle-merge(root.selected); return accept; }
                                    if event.text == "j" { root.note-from-entry(root.selected); return accept; }
                                    if event.text == "p" { root.toggle-pin(root.selected); return accept; }
                                    // Preview zoom: ⌘+ / ⌘= bigger, ⌘- smaller, ⌘0 reset.
                                    if event.text == "=" || event.text == "+" { root.zoom-preview(1); return accept; }
                                    if event.text == "-" { root.zoom-preview(-1); return accept; }
                                    if event.text == "0" { root.zoom-preview(0); return accept; }
                                    if event.text == "1" { root.activate-nth(1); return accept; }
                                    if event.text == "2" { root.activate-nth(2); return accept; }
                                    if event.text == "3" { root.activate-nth(3); return accept; }
                                    if event.text == "4" { root.activate-nth(4); return accept; }
                                    if event.text == "5" { root.activate-nth(5); return accept; }
                                    if event.text == "6" { root.activate-nth(6); return accept; }
                                    if event.text == "7" { root.activate-nth(7); return accept; }
                                    if event.text == "8" { root.activate-nth(8); return accept; }
                                    if event.text == "9" { root.activate-nth(9); return accept; }
                                    // ⌘A / ⌘V / ⌘X / ⌘←→ / ⌘⌫ etc. → native editing
                                    return reject;
                                }
                                // typing, ⌫, ⌥⌫, ⌥←→, Left/Right, etc. → native editing
                                return reject;
                            }
                        }
                    }
                }
            }

            // ---- List view ----
            if root.view == "list": VerticalLayout {
                spacing: 8px;

                // Row 1 — filter + sort the clipboard list.
                HorizontalLayout {
                    spacing: 6px;
                    // Order must match `viewmodel::type_filter_from_index` /
                    // `runtime::TYPE_CHIPS`.
                    for label[i] in ["All", "Text", "Link", "Email", "Color", "Image", "File"]: Rectangle {
                        height: 26px;
                        width: 52px;
                        background: i == root.type-index ? Pal.accent : (fta.has-hover ? #35353d : #2a2a30);
                        border-radius: 6px;
                        fta := TouchArea { clicked => { root.type-index = i; root.set-type-filter(i); } }
                        Text { text: label; color: i == root.type-index ? Pal.on-accent : white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    for label[i] in ["Recent", "Most copied"]: Rectangle {
                        height: 26px;
                        width: i == 0 ? 62px : 92px;
                        background: i == root.sort-index ? #3a3a40 : (sta.has-hover ? #2c2c33 : #202024);
                        border-radius: 6px;
                        sta := TouchArea { clicked => { root.sort-index = i; root.set-sort(i); } }
                        Text { text: label; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                // Row 2 — mode switch + utilities, right-aligned (secondary to the
                // list filters above). Separating the two rows keeps either from
                // crowding the other on narrow windows.
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 84px;
                        height: 26px;
                        background: root.today-mode ? Pal.accent : (todayta.has-hover ? #2c2c33 : #202024);
                        border-radius: 6px;
                        todayta := TouchArea { clicked => { root.set-mode-today(!root.today-mode); } }
                        Text { text: "Today"; color: root.today-mode ? Pal.on-accent : white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 84px;
                        height: 26px;
                        background: root.journal-mode ? Pal.accent : (jrnlta.has-hover ? #2c2c33 : #202024);
                        border-radius: 6px;
                        jrnlta := TouchArea { clicked => { root.set-mode-journal(!root.journal-mode); } }
                        Text { text: "Journal"; color: root.journal-mode ? Pal.on-accent : white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 84px;
                        height: 26px;
                        background: root.screenshare ? #b04a4a : (lockta.has-hover ? #2c2c33 : #202024);
                        border-radius: 6px;
                        lockta := TouchArea { clicked => { root.toggle-screenshare(); } }
                        Text { text: root.screenshare ? "🔒 Masked" : "🔒 Mask"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 62px;
                        height: 26px;
                        background: root.notes-mode ? Pal.accent : (notesta.has-hover ? #2c2c33 : #202024);
                        border-radius: 6px;
                        notesta := TouchArea { clicked => { root.set-mode-notes(!root.notes-mode); } }
                        Text { text: "Notes"; color: root.notes-mode ? Pal.on-accent : white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 58px;
                        height: 26px;
                        background: root.tasks-mode ? Pal.accent : (tasksta.has-hover ? #2c2c33 : #202024);
                        border-radius: 6px;
                        tasksta := TouchArea { clicked => { root.set-mode-tasks(!root.tasks-mode); } }
                        Text { text: "Tasks"; color: root.tasks-mode ? Pal.on-accent : white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 84px;
                        height: 26px;
                        background: root.bookmarks-mode ? Pal.accent : (bmksta.has-hover ? #2c2c33 : #202024);
                        border-radius: 6px;
                        bmksta := TouchArea { clicked => { root.set-mode-bookmarks(!root.bookmarks-mode); } }
                        Text { text: "Bookmarks"; color: root.bookmarks-mode ? Pal.on-accent : white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 58px;
                        height: 26px;
                        background: root.board-mode ? Pal.accent : (boardta.has-hover ? #2c2c33 : #202024);
                        border-radius: 6px;
                        boardta := TouchArea { clicked => { root.set-mode-board(!root.board-mode); } }
                        Text { text: "Board"; color: root.board-mode ? Pal.on-accent : white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 58px;
                        height: 26px;
                        background: statsta.has-hover ? #2c2c33 : #202024;
                        border-radius: 6px;
                        statsta := TouchArea { clicked => { root.toggle-view(); } }
                        Text { text: "Stats"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 34px;
                        height: 26px;
                        background: helpta.has-hover ? #2c2c33 : #202024;
                        border-radius: 6px;
                        helpta := TouchArea { clicked => { root.mode = "help"; } }
                        Text { text: "?"; color: white; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                // Screenshare mode is a big, silent change to every row — say so,
                // otherwise a wall of dots reads as broken data.
                if root.screenshare: Rectangle {
                    height: 26px;
                    background: #2e1f22;
                    border-radius: 6px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        Text {
                            text: "Screenshare mode — content hidden. Click “Masked” to turn it off.";
                            color: #e0a0a0;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }

                if root.all-tags.length > 0: HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    for t in root.all-tags: Rectangle {
                        height: 22px;
                        width: 64px;
                        background: root.tag-filter == t ? Pal.accent : (tagta.has-hover ? #35353d : #2a2a30);
                        border-radius: 11px;
                        tagta := TouchArea { clicked => { root.set-tag-filter(t); } }
                        Text {
                            text: "#" + t;
                            color: root.tag-filter == t ? Pal.on-accent : white;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                if root.merge-count > 0: HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Text {
                        // "Merge 3 · sep:" was cryptic, and the ↵ / ␣ glyphs below
                        // shaped as tofu — the options were literally unreadable.
                        text: root.merge-count == 1
                            ? "1 item queued · join with"
                            : root.merge-count + " items queued · join with";
                        color: white;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    // Segmented control (selected = the same grey as Recent/Most
                    // copied), NOT accent — accent is reserved for the one primary
                    // action in this row, and two blue pills side by side made it
                    // impossible to tell the selection from the button.
                    for label[si] in ["New line", "Space", "Comma"]: Rectangle {
                        width: 72px;
                        height: 26px;
                        background: si == root.merge-sep ? #3a3a40 : (msta.has-hover ? #2c2c33 : #202024);
                        border-radius: 6px;
                        msta := TouchArea { clicked => { root.merge-sep = si; } }
                        Text { text: label; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle { width: 6px; }
                    Rectangle {
                        width: 110px;
                        height: 26px;
                        background: mpta.has-hover ? #7f9dff : Pal.accent;
                        border-radius: 6px;
                        mpta := TouchArea { clicked => { root.merge-paste(); } }
                        Text { text: "Merge & paste"; color: Pal.on-accent; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 54px;
                        height: 26px;
                        background: mcta.has-hover ? #35353d : #2a2a30;
                        border-radius: 6px;
                        mcta := TouchArea { clicked => { root.clear-merge(); } }
                        Text { text: "Clear"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                // Speed-dial: assigned slots (⌘1-9). Shown only when any is filled.
                if root.slots.length > 0: HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    Text { text: "Slots ⌘S"; color: #85858d; font-size: 11px; vertical-alignment: center; }
                    for s in root.slots: Rectangle {
                        height: 24px;
                        width: 120px;
                        background: slotta.has-hover ? #2a2a30 : #202024;
                        border-radius: 6px;
                        slotta := TouchArea { clicked => { root.paste-slot(s.n); } }
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 4px;
                            Text { text: "⌘" + s.n; color: #6a8cff; font-size: 11px; vertical-alignment: center; }
                            Text { text: s.title; color: #d0d0d4; font-size: 11px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        }
                    }
                }

                // Two-pane body.
                HorizontalLayout {
                    spacing: 12px;

                    // Scroll-follow: mirror `selected` locally so the `changed`
                    // handler can reach `list` (an id inside this subtree).
                    property <int> sel-follow: root.selected;
                    changed sel-follow => {
                        root.revealed = false;
                        if root.selected * 52px < -list.viewport-y {
                            list.viewport-y = -root.selected * 52px;
                        } else if (root.selected + 1) * 52px > -list.viewport-y + list.visible-height {
                            list.viewport-y = -((root.selected + 1) * 52px - list.visible-height);
                        }
                    }

                    Rectangle {
                    horizontal-stretch: 1;
                    min-width: 340px;
                    list := ListView {
                        // Hide the native sliver; we draw our own scrollbar.
                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                        for row[i] in entries: VerticalLayout {
                            // Date group divider: a label with a full-width rule under it.
                            if i == 0 || entries[i - 1].section != row.section: VerticalLayout {
                                padding-top: 12px;
                                padding-bottom: 2px;
                                spacing: 5px;
                                Text {
                                    text: row.section;
                                    color: #8a8a92;
                                    font-size: 11px;
                                    font-weight: 600;
                                }
                                Rectangle { height: 1px; background: #2e2e35; }
                            }
                            Rectangle {
                            height: 52px;
                            // Selection is a soft rounded fill only — no border/underline.
                            background: i == root.selected ? #2f2f37 : (rowta.has-hover ? #232329 : transparent);
                            border-radius: 8px;
                            rowta := TouchArea {
                                clicked => { root.selected = i; }
                                double-clicked => { root.activate(i); }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 10px;
                                spacing: 8px;
                                // 1-9 quick-paste number on the LEFT, aligned with the
                                // top line of the copied text; brightens while ⌘/Ctrl held.
                                Rectangle {
                                    width: 20px;
                                    if i < 9: Text {
                                        y: 9px;
                                        text: i + 1;
                                        color: root.cmd-held ? #6a8cff : #45454e;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                    }
                                }
                                // Leading visual, most content-specific first: the
                                // image itself, then a colour swatch, then the
                                // source-app icon (or the kind glyph). Showing the
                                // app icon for an image entry told you where it came
                                // from but never WHICH image it was.
                                Rectangle {
                                    width: 28px;
                                    if row.has-thumb: Image {
                                        source: row.thumb;
                                        y: 8px;
                                        width: 24px;
                                        height: 20px;
                                        image-fit: contain;
                                    }
                                    if !row.has-thumb && row.has-swatch: Rectangle {
                                        y: 8px;
                                        width: 20px;
                                        height: 20px;
                                        border-radius: 4px;
                                        background: row.swatch;
                                        border-width: 1px;
                                        border-color: #55555f;
                                    }
                                    if !row.has-thumb && !row.has-swatch && row.has-icon: Image { source: row.icon; y: 8px; width: 20px; height: 20px; }
                                    if !row.has-thumb && !row.has-swatch && !row.has-icon: TypeIcon { kind: row.kind; y: 8px; width: 20px; height: 20px; tint: #c2c2c8; }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        if row.pinned: Text { text: "📌"; font-size: 11px; vertical-alignment: center; }
                                        Text { text: row.title; color: white; font-size: 14px; overflow: elide; horizontal-stretch: 1; }
                                        if row.badge != "": Text { text: row.badge; color: #9a9aa0; font-size: 10px; vertical-alignment: center; }
                                    }
                                    Text { text: row.subtitle; color: #9a9aa0; font-size: 11px; overflow: elide; }
                                }
                                // Merge checkmark only when this row is queued (via ⌘G / ⌘K).
                                if row.merged: Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    background: #6a8cff;
                                    border-radius: 6px;
                                    Text { text: "✓"; color: white; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                if row.slot > 0: Rectangle {
                                    width: 24px;
                                    height: 22px;
                                    border-radius: 6px;
                                    background: #3a3a40;
                                    Text { text: "⌘" + row.slot; color: #d0d0d4; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            }
                        }
                    }
                    // Empty state overlay. When a search or filter caused it, offer
                    // the one click back out — otherwise it's a dead end.
                    if entries.length == 0: VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: (root.query != "" || root.filtered) ? "No matching items" : "No clipboard history yet";
                                    color: #9a9aa0;
                                    font-size: 14px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: (root.query != "" || root.filtered)
                                        ? "Nothing here matches your search and filters."
                                        : "Copy something and it will show up here.";
                                    color: #6a6a70;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                }
                                if root.query != "" || root.filtered: HorizontalLayout {
                                    alignment: center;
                                    padding-top: 8px;
                                    Rectangle {
                                        height: 28px;
                                        width: 168px;
                                        background: resetta.has-hover ? #35353d : #2a2a30;
                                        border-radius: 6px;
                                        resetta := TouchArea {
                                            clicked => {
                                                root.query = "";
                                                root.search-changed("");
                                                root.clear-filters();
                                            }
                                        }
                                        Text { text: "Clear search & filters"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                    // Custom scrollbar (the native one is a barely-visible sliver).
                    if list.viewport-height > list.visible-height + 1px: sb := Rectangle {
                        x: parent.width - 6px;
                        width: 5px;
                        y: 0;
                        height: parent.height;
                        Rectangle {
                            width: parent.width;
                            border-radius: 3px;
                            background: sbta.pressed ? #6a6a72 : (sbta.has-hover ? #55555f : #3f3f47);
                            height: max(30px, sb.height * (list.visible-height / list.viewport-height));
                            y: -list.viewport-y / list.viewport-height * sb.height;
                        }
                        sbta := TouchArea {
                            property <length> anchor;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    self.anchor = list.viewport-y;
                                }
                            }
                            moved => {
                                list.viewport-y = min(0px, max(-(list.viewport-height - list.visible-height), self.anchor - (self.mouse-y - self.pressed-y) * (list.viewport-height / sb.height)));
                            }
                        }
                    }
                    }

                    // No entries → no detail to show. Dropping the pane entirely
                    // (rather than leaving an empty dark slab) gives the empty-state
                    // message the full width.
                    if entries.length > 0: Rectangle {
                        background: #161618;
                        border-radius: 8px;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;
                            // Preview header: the pane's own label plus its actions.
                            // These live ABOVE the text so they always sit in the same
                            // place — previously they floated in the middle of the
                            // empty space left by a short entry.
                            if entries.length > 0 && root.selected < entries.length: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Preview";
                                    color: #8a8a92;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                if entries[root.selected].masked && !root.revealed: Rectangle {
                                    height: 26px;
                                    width: 88px;
                                    background: revta.has-hover ? #35353d : #2a2a30;
                                    border-radius: 6px;
                                    revta := TouchArea { clicked => { root.revealed = true; } }
                                    Text { text: "Reveal"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Rectangle {
                                    height: 26px;
                                    width: 116px;
                                    background: oeta.has-hover ? #35353d : #2a2a30;
                                    border-radius: 6px;
                                    oeta := TouchArea { clicked => { root.open-in-editor(root.selected); } }
                                    Text { text: "↗ Open in editor"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }

                            // Detail preview — a VIRTUALIZED line list. Only the
                            // visible lines are shaped, so huge entries are instant.
                            // Rust pushes preview-lines (masked→bullets, else the
                            // real lines, bounded) for the selected entry.
                            Rectangle {
                                min-height: 100px;
                                vertical-stretch: 1;
                                // Image entries: the bitmap itself, scaled to fit.
                                if root.preview-has-image: Image {
                                    source: root.preview-image;
                                    width: parent.width;
                                    height: parent.height;
                                    image-fit: contain;
                                }
                                // Colour entries: a large swatch above the value, so
                                // "#333" is something you can actually see.
                                if !root.preview-has-image && root.selected < entries.length && entries[root.selected].has-swatch: VerticalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Rectangle {
                                        height: 72px;
                                        border-radius: 8px;
                                        background: entries[root.selected].swatch;
                                        border-width: 1px;
                                        border-color: #55555f;
                                    }
                                }
                                // Normal-size entries: a selectable, scrollable,
                                // zoomable read-only TextInput (drag to select, ⌘C).
                                // Plain TextInput (not std TextEdit) so we control the
                                // text color — the themed TextEdit rendered invisibly
                                // on the dark pane.
                                if !root.preview-has-image && root.preview-text != "": Flickable {
                                    y: (root.selected < entries.length && entries[root.selected].has-swatch) ? 88px : 0px;
                                    viewport-width: self.width;
                                    viewport-height: pvtext.preferred-height;
                                    pvtext := TextInput {
                                        width: parent.width;
                                        text: root.preview-text;
                                        color: #d0d0d4;
                                        font-size: root.preview-font-size;
                                        read-only: true;
                                        single-line: false;
                                        wrap: word-wrap;
                                    }
                                }
                                // Huge entries: fast virtualized line list (not
                                // selectable) so selection stays instant. Wrapped so
                                // `plist` stays in scope for its custom scrollbar.
                                if !root.preview-has-image && root.preview-text == "": Rectangle {
                                    plist := ListView {
                                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                        for ln in root.preview-lines: Rectangle {
                                            height: root.preview-font-size * 1.5;
                                            Text {
                                                x: 0;
                                                width: parent.width;
                                                text: ln;
                                                color: #d0d0d4;
                                                font-size: root.preview-font-size;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    // Custom scrollbar for the preview (flush right).
                                    if plist.viewport-height > plist.visible-height + 1px: pv := Rectangle {
                                        x: parent.width - 6px;
                                        width: 5px;
                                        y: 0;
                                        height: parent.height;
                                        Rectangle {
                                            width: parent.width;
                                            border-radius: 3px;
                                            background: pvta.pressed ? #6a6a72 : (pvta.has-hover ? #55555f : #3f3f47);
                                            height: max(30px, pv.height * (plist.visible-height / plist.viewport-height));
                                            y: -plist.viewport-y / plist.viewport-height * pv.height;
                                        }
                                        pvta := TouchArea {
                                            property <length> anchor;
                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.down) { self.anchor = plist.viewport-y; }
                                            }
                                            moved => {
                                                plist.viewport-y = min(0px, max(-(plist.viewport-height - plist.visible-height), self.anchor - (self.mouse-y - self.pressed-y) * (plist.viewport-height / pv.height)));
                                            }
                                        }
                                    }
                                }
                            }

                            if root.preview-truncated: Text {
                                text: "Preview truncated — open in editor to see all";
                                color: #6a6a70;
                                font-size: 11px;
                                wrap: word-wrap;
                            }

                            // Metadata "Information" block (Raycast-style; right-aligned values).
                            // `vertical-stretch: 0` + fixed row heights: in a tall
                            // window the block used to absorb the slack and its rows
                            // drifted apart unevenly. All spare height belongs to the
                            // preview area above.
                            if entries.length > 0 && root.selected < entries.length: VerticalLayout {
                                spacing: 5px;
                                vertical-stretch: 0;
                                alignment: start;
                                Rectangle { height: 1px; background: #2a2a30; }
                                Text { text: "Information"; color: #8a8a92; font-size: 12px; }
                                HorizontalLayout {
                                    height: 16px;
                                    spacing: 12px;
                                    Text { text: "Source"; color: #85858d; font-size: 11px; horizontal-stretch: 1; }
                                    if entries[root.selected].has-icon: Image { source: entries[root.selected].icon; width: 14px; height: 14px; }
                                    Text { text: entries[root.selected].source; color: #d0d0d4; font-size: 11px; overflow: elide; }
                                }
                                // spacing keeps the label and its right-aligned value from
                                // touching once the pane is narrow.
                                HorizontalLayout {
                                    height: 16px;
                                    spacing: 12px;
                                    Text { text: "Content type"; color: #85858d; font-size: 11px; horizontal-stretch: 1; }
                                    Text { text: entries[root.selected].kind; color: #d0d0d4; font-size: 11px; horizontal-alignment: right; }
                                }
                                HorizontalLayout {
                                    height: 16px;
                                    spacing: 12px;
                                    Text { text: "Size"; color: #85858d; font-size: 11px; horizontal-stretch: 1; }
                                    Text { text: entries[root.selected].size; color: #d0d0d4; font-size: 11px; horizontal-alignment: right; overflow: elide; }
                                }
                                // Images and file lists have no words — a hard "0"
                                // read as a bug rather than "not applicable".
                                if entries[root.selected].words > 0: HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: "Words"; color: #85858d; font-size: 11px; horizontal-stretch: 1; }
                                    Text { text: entries[root.selected].words; color: #d0d0d4; font-size: 11px; horizontal-alignment: right; }
                                }
                                HorizontalLayout {
                                    height: 16px;
                                    spacing: 12px;
                                    Text { text: "Times copied"; color: #85858d; font-size: 11px; horizontal-stretch: 1; }
                                    Text { text: entries[root.selected].copied; color: #d0d0d4; font-size: 11px; horizontal-alignment: right; }
                                }
                                HorizontalLayout {
                                    height: 16px;
                                    spacing: 12px;
                                    Text { text: "Last used"; color: #85858d; font-size: 11px; horizontal-stretch: 1; }
                                    Text { text: entries[root.selected].when; color: #d0d0d4; font-size: 11px; horizontal-alignment: right; }
                                }
                                HorizontalLayout {
                                    height: 16px;
                                    spacing: 12px;
                                    Text { text: "Copied"; color: #85858d; font-size: 11px; horizontal-stretch: 1; }
                                    Text { text: entries[root.selected].copied-date; color: #d0d0d4; font-size: 11px; horizontal-alignment: right; }
                                }
                                HorizontalLayout {
                                    height: 16px;
                                    spacing: 12px;
                                    Text { text: "Slot"; color: #85858d; font-size: 11px; horizontal-stretch: 1; }
                                    Text { text: entries[root.selected].slot > 0 ? "⌘" + entries[root.selected].slot : "—"; color: #d0d0d4; font-size: 11px; horizontal-alignment: right; }
                                }
                            }

                            // Tag chips for the selected entry (click to remove).
                            if root.selected-tags.length > 0: HorizontalLayout {
                                spacing: 4px;
                                alignment: start;
                                vertical-stretch: 0;
                                for t in root.selected-tags: Rectangle {
                                    height: 22px;
                                    width: 74px;
                                    background: chipta.has-hover ? #4a4a52 : #3a3a40;
                                    border-radius: 11px;
                                    chipta := TouchArea { clicked => { root.remove-tag(root.selected, t); } }
                                    Text {
                                        text: "#" + t + " ✕";
                                        color: #d0d0d4;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            // Add-tag input. Enter commits, so the button is a fallback.
                            if entries.length > 0 && root.selected < entries.length: HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                vertical-stretch: 0;
                                tagfield := LineEdit {
                                    placeholder-text: "Add tag…";
                                    width: 140px;
                                    text <=> root.add-tag-text;
                                    accepted => { root.add-tag(root.selected, root.add-tag-text); }
                                }
                                Rectangle {
                                    width: 48px;
                                    height: 26px;
                                    background: addta.has-hover ? #35353d : #2a2a30;
                                    border-radius: 6px;
                                    addta := TouchArea { clicked => { root.add-tag(root.selected, root.add-tag-text); } }
                                    Text { text: "Add"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }

                // Bottom action bar.
                Rectangle {
                    height: 34px;
                    background: #161618;
                    border-radius: 8px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;
                        // "From <app>" — a bare app name here read as a stray word.
                        Text {
                            text: (entries.length > 0 && root.selected < entries.length) ? "From " + entries[root.selected].source : "";
                            color: #9a9aa0;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        // With nothing selected these keys do nothing, so don't
                        // advertise them — the bar used to promise "⏎ Paste to X"
                        // over an empty list.
                        if entries.length > 0 && root.target-has-icon: Rectangle {
                            width: 14px;
                            Image { source: root.target-icon; width: 14px; height: 14px; }
                        }
                        if entries.length > 0: Text {
                            text: root.target-app == "" ? "⏎ Paste" : "⏎ Paste to " + root.target-app;
                            color: #9a9aa0;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        if entries.length > 0: Text { text: "⌘C Copy   ⌘K Actions"; color: #9a9aa0; font-size: 12px; vertical-alignment: center; }
                        if entries.length == 0: Text { text: "⌘/ Shortcuts"; color: #6a6a70; font-size: 12px; vertical-alignment: center; }
                    }
                }
            }

            // ---- Stats view ----
            if root.view == "stats": VerticalLayout {
                padding: 8px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Rectangle {
                        width: 70px;
                        height: 26px;
                        background: #202024;
                        border-radius: 6px;
                        TouchArea { clicked => { root.toggle-view(); } }
                        Text { text: "← Back"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    for label[i] in ["7d", "30d", "90d", "All"]: Rectangle {
                        width: 56px;
                        height: 26px;
                        background: i == root.range-index ? #3a3a40 : #202024;
                        border-radius: 6px;
                        TouchArea {
                            clicked => {
                                root.range-index = i;
                                root.stats-range-changed(i);
                            }
                        }
                        Text {
                            text: label;
                            color: white;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: root.totals-line; color: white; font-size: 13px; }

                        Text { text: "Copies over time"; color: #9a9aa0; font-size: 11px; }
                        if root.over-time-bars.length >= 2: Rectangle {
                            height: 64px;
                            HorizontalLayout {
                                alignment: start;
                                spacing: 3px;
                                for bar in root.over-time-bars: Rectangle {
                                    width: 10px;
                                    // baseline track so empty days read as a bar, not a gap
                                    Rectangle { width: parent.width; background: #2a2a30; border-radius: 2px; }
                                    Rectangle {
                                        width: parent.width;
                                        y: parent.height * (1.0 - bar.value_norm);
                                        height: parent.height * bar.value_norm;
                                        background: #6a8cff;
                                        border-radius: 2px;
                                    }
                                }
                            }
                        }
                        // Span + peak, so the bars aren't anonymous.
                        if root.over-time-bars.length >= 2 && root.over-time-caption != "": Text {
                            text: root.over-time-caption;
                            color: #6a6a70;
                            font-size: 11px;
                        }
                        if root.over-time-bars.length < 2: Text {
                            text: "Not enough data yet.";
                            color: #6a6a70;
                            font-size: 11px;
                        }

                        Text { text: "Most copied"; color: #9a9aa0; font-size: 11px; }
                        for bar in root.most-copied-bars: HBar {
                            label: bar.label;
                            display: bar.display;
                            value_norm: bar.value_norm;
                        }

                        Text { text: "By app"; color: #9a9aa0; font-size: 11px; }
                        for bar in root.per-app-bars: HBar {
                            label: bar.label;
                            display: bar.display;
                            value_norm: bar.value_norm;
                        }

                        Text { text: "By type"; color: #9a9aa0; font-size: 11px; }
                        for bar in root.by-type-bars: HBar {
                            label: bar.label;
                            display: bar.display;
                            value_norm: bar.value_norm;
                        }

                        Text { text: "Time tracked · last 7 days: " + root.time-week-total; color: #8a8a92; font-size: 12px; }
                        for bar in root.time-by-day-bars: HBar {
                            label: bar.label;
                            display: bar.display;
                            value_norm: bar.value_norm;
                        }
                        if root.time-by-project-bars.length > 0: Text { text: "By project (30 days)"; color: #8a8a92; font-size: 12px; }
                        for bar in root.time-by-project-bars: HBar {
                            label: bar.label;
                            display: bar.display;
                            value_norm: bar.value_norm;
                        }

                        if root.time-entries.length > 0: Text { text: "Recent sessions"; color: #8a8a92; font-size: 12px; }
                        for e in root.time-entries: Rectangle {
                            height: 30px;
                            background: terow.has-hover ? #26262c : transparent;
                            border-radius: 6px;
                            terow := TouchArea {}
                            HorizontalLayout {
                                padding-left: 6px; padding-right: 6px; spacing: 8px;
                                Text {
                                    text: e.title;
                                    color: #d0d0d4;
                                    font-size: 12px;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                Text { text: e.when; color: #6a6a70; font-size: 11px; vertical-alignment: center; }
                                if e.running: Rectangle {
                                    height: 18px;
                                    width: 52px;
                                    border-radius: 9px;
                                    background: #3a3a44;
                                    Text { text: "running"; color: #9aa8ff; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                if !e.running: Text { text: e.duration; color: #9a9aa0; font-size: 11px; vertical-alignment: center; }
                                Rectangle {
                                    width: 22px;
                                    tedel := TouchArea { clicked => { root.delete-time-entry(e.id); } }
                                    Text { text: "×"; color: tedel.has-hover ? #ff9a9a : #55555f; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
            }

        }

        // ---- Notes mode (opaque overlay covering the clipboard body) ----
        if root.notes-mode: Rectangle {
            background: #1e1e21;
            // Keyboard nav: the list is focused on entry; ↑/↓ switch notes (opening
            // each), ⏎ dives into the editor, Esc exits. Empty FocusScope → no layout
            // impact; mouse still works on the panes below.
            nlistfs := FocusScope {
                init => {
                    self.focus();
                }
                key-pressed(e) => {
                    if e.text == Key.Escape {
                        root.set-mode-notes(false);
                        searchinput.focus();
                        return accept;
                    }
                    if e.text == Key.DownArrow {
                        root.nav-note(1);
                        return accept;
                    }
                    if e.text == Key.UpArrow {
                        root.nav-note(-1);
                        return accept;
                    }
                    if e.text == Key.Return {
                        ned.focus();
                        return accept;
                    }
                    return reject;
                }
            }
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                // Left: back + filter + new + list
                VerticalLayout {
                    width: 300px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 92px;
                            height: 30px;
                            border-radius: 6px;
                            background: nback.has-hover ? #34343c : #2a2a30;
                            nback := TouchArea { clicked => { root.set-mode-notes(false); } }
                            Text { text: "← Clipboard"; color: #d0d0d4; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 30px;
                            background: #2a2a30;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                if root.note-filter == "": Text {
                                    text: "Filter notes…";
                                    color: #6a6a70;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                                nfilter := TextInput {
                                    text <=> root.note-filter;
                                    color: #d0d0d4;
                                    font-size: 13px;
                                    single-line: true;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle {
                            width: 60px;
                            height: 30px;
                            border-radius: 6px;
                            background: nnew.has-hover ? #34343c : #2a2a30;
                            nnew := TouchArea { clicked => { root.new-note(); } }
                            Text { text: "New"; color: #d0d0d4; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    // Tag-filter chip strip: "All" + one chip per distinct #tag across
                    // all notes. Horizontally scrollable so many tags don't overflow
                    // the narrow left column.
                    if root.note-all-tags.length > 0: Flickable {
                        height: 30px;
                        viewport-width: ntagrow.preferred-width;
                        viewport-height: self.height;
                        ntagrow := HorizontalLayout {
                            height: 30px;
                            spacing: 6px;
                            alignment: start;
                            Rectangle {
                                height: 24px;
                                border-radius: 12px;
                                background: root.note-tag-filter == "" ? Pal.accent : (ntagall.has-hover ? #34343c : #2a2a30);
                                ntagall := TouchArea { clicked => { root.filter-notes-by-tag(""); } }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text { text: "All"; color: root.note-tag-filter == "" ? Pal.on-accent : #d0d0d4; font-size: 12px; vertical-alignment: center; }
                                }
                            }
                            for tag in root.note-all-tags: Rectangle {
                                height: 24px;
                                border-radius: 12px;
                                background: root.note-tag-filter == tag ? Pal.accent : (ntagchip.has-hover ? #34343c : #2a2a30);
                                ntagchip := TouchArea { clicked => { root.filter-notes-by-tag(tag); } }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text { text: "#" + tag; color: root.note-tag-filter == tag ? Pal.on-accent : #9ab0ff; font-size: 12px; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                    ListView {
                        for n in root.notes: Rectangle {
                            height: 44px;
                            background: n.id == root.note-id ? #2f2f37 : (nrow.has-hover ? #26262c : transparent);
                            border-radius: 6px;
                            nrow := TouchArea { clicked => { root.open-note(n.id); } }
                            VerticalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                Text { text: (n.is_daily ? "📌 " : "") + n.title; color: #e6e6ea; font-size: 13px; overflow: elide; }
                                Text { text: n.when; color: #8a8a90; font-size: 11px; overflow: elide; }
                                if n.tags != "": Text { text: n.tags; color: #6a6a70; font-size: 10px; overflow: elide; }
                            }
                        }
                    }
                }
                // Right: editor pane (editor body filled in Task 5)
                Rectangle {
                    background: #161618;
                    border-radius: 8px;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: root.note-provenance; color: #8a8a90; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; }
                            // Promote the line the cursor is on to a `- [ ]` task
                            // (same as ⌘⏎ in the editor).
                            Rectangle {
                                width: 100px;
                                height: 26px;
                                border-radius: 6px;
                                background: mktask.has-hover ? #34343c : #2a2a30;
                                mktask := TouchArea { clicked => { root.promote-line(ned.cursor-position-byte-offset); } }
                                Text { text: "☑ Make task"; color: #d0d0d4; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        // Editor — a plain TextInput (not std TextEdit, which renders
                        // invisibly on the dark pane) with an explicit text colour.
                        Flickable {
                            vertical-stretch: 1;
                            viewport-width: self.width;
                            viewport-height: ned.preferred-height;
                            ned := TextInput {
                                width: parent.width;
                                text: root.note-body;
                                color: #d0d0d4;
                                font-size: 13px;
                                single-line: false;
                                wrap: word-wrap;
                                edited => {
                                    root.note-caret = self.cursor-position-byte-offset;
                                    root.edit-note-body-at(self.text, self.cursor-position-byte-offset);
                                }
                                key-pressed(event) => {
                                    // ⌘⏎ promotes the current line to a task; ⌘↑/⌘↓
                                    // switch notes while editing; Esc returns focus to
                                    // the note list. Everything else edits normally.
                                    if event.modifiers.control && event.text == Key.Return {
                                        root.promote-line(self.cursor-position-byte-offset);
                                        return accept;
                                    }
                                    if event.modifiers.control && event.text == Key.UpArrow {
                                        root.nav-note(-1);
                                        return accept;
                                    }
                                    if event.modifiers.control && event.text == Key.DownArrow {
                                        root.nav-note(1);
                                        return accept;
                                    }
                                    if root.note-suggestions.length > 0 {
                                        if event.text == Key.Tab {
                                            root.accept-note-suggestion(root.note-suggestions[0]);
                                            return accept;
                                        }
                                        if event.text == Key.Escape {
                                            root.dismiss-note-suggestions();
                                            return accept;
                                        }
                                    }
                                    if event.text == Key.Escape {
                                        nlistfs.focus();
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                        }
                        // [[wiki-link]] autocomplete popup, shown just below the
                        // editor while an open `[[…` query has matches.
                        if root.note-suggestions.length > 0: Rectangle {
                            max-height: 160px;
                            background: #26262c;
                            border-color: #3a3a40;
                            border-width: 1px;
                            border-radius: 6px;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 2px;
                                for name in root.note-suggestions: Rectangle {
                                    height: 24px;
                                    border-radius: 4px;
                                    background: srow.has-hover ? #34343c : transparent;
                                    srow := TouchArea { clicked => { root.accept-note-suggestion(name); } }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text { text: name; color: #d0d0d4; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                    }
                                }
                                Text { text: "Tab to insert"; color: #6a6a70; font-size: 10px; }
                            }
                        }
                        // Links strip: clickable [[page]] chips parsed from the body.
                        if root.note-links.length > 0: HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text { text: "Links:"; color: #8a8a90; font-size: 11px; vertical-alignment: center; }
                            for name in root.note-links: Rectangle {
                                height: 24px;
                                border-radius: 12px;
                                background: chip.has-hover ? #34343c : #2a2a30;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text { text: name; color: #9ab0ff; font-size: 12px; vertical-alignment: center; }
                                }
                                chip := TouchArea { clicked => { root.open-page(name); } }
                            }
                        }
                        if root.backlinks.length > 0 || root.unlinked.length > 0: Rectangle {
                            height: 176px;
                            background: #121214;
                            border-radius: 8px;
                            Flickable {
                                viewport-width: self.width;
                                VerticalLayout {
                                    width: parent.width;
                                    padding: 8px;
                                    spacing: 4px;
                                    if root.backlinks.length > 0: Text {
                                        text: "Linked references (" + root.backlinks.length + ")";
                                        color: #8a8a90;
                                        font-size: 11px;
                                        font-weight: 700;
                                    }
                                    for r in root.backlinks: Rectangle {
                                        height: 38px;
                                        background: lrow.has-hover ? #26262c : transparent;
                                        border-radius: 6px;
                                        lrow := TouchArea { clicked => { root.open-page(r.source); } }
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 8px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                padding-top: 4px;
                                                padding-bottom: 4px;
                                                Text { text: r.source; color: #7a7a80; font-size: 10px; }
                                                Text { text: r.line; color: #d0d0d4; font-size: 12px; overflow: elide; }
                                            }
                                        }
                                    }
                                    if root.unlinked.length > 0: Text {
                                        text: "Unlinked references (" + root.unlinked.length + ")";
                                        color: #8a8a90;
                                        font-size: 11px;
                                        font-weight: 700;
                                    }
                                    for r in root.unlinked: Rectangle {
                                        height: 38px;
                                        background: urow.has-hover ? #26262c : transparent;
                                        border-radius: 6px;
                                        urow := TouchArea { clicked => { root.open-page(r.source); } }
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 8px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                padding-top: 4px;
                                                padding-bottom: 4px;
                                                Text { text: r.source; color: #7a7a80; font-size: 10px; }
                                                Text { text: r.line; color: #d0d0d4; font-size: 12px; overflow: elide; }
                                            }
                                            Rectangle {
                                                width: 48px;
                                                height: 24px;
                                                y: 7px;
                                                border-radius: 6px;
                                                background: lk.has-hover ? #34343c : #2a2a30;
                                                lk := TouchArea { clicked => { root.link-mention(r.note_id, r.line_index); } }
                                                Text { text: "Link"; color: #9ab0ff; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---- Tasks mode (opaque overlay: flat, grouped/sorted task list) ----
        if root.tasks-mode: Rectangle {
            background: #1e1e21;
            // Keyboard nav: ↑/↓ select, Space toggles, ⏎ opens the note, Esc exits.
            // An empty FocusScope holds focus without affecting layout or mouse.
            tfs := FocusScope {
                init => {
                    self.focus();
                    root.task-selected = 0;
                }
                key-pressed(e) => {
                    if e.text == Key.Escape {
                        root.set-mode-tasks(false);
                        searchinput.focus();
                        return accept;
                    }
                    if e.text == Key.DownArrow {
                        if root.task-selected < root.tasks.length - 1 {
                            root.task-selected += 1;
                        }
                        return accept;
                    }
                    if e.text == Key.UpArrow {
                        if root.task-selected > 0 {
                            root.task-selected -= 1;
                        }
                        return accept;
                    }
                    if e.text == " " {
                        if root.tasks.length > 0 {
                            root.toggle-task(root.tasks[root.task-selected].note_id, root.tasks[root.task-selected].line_index);
                        }
                        return accept;
                    }
                    if e.text == Key.Return {
                        if root.tasks.length > 0 {
                            root.open-task-note(root.tasks[root.task-selected].note_id);
                        }
                        return accept;
                    }
                    if e.text == "b" {
                        if root.tasks.length > 0 {
                            root.toggle-bookmark(root.tasks[root.task-selected].note_id, root.tasks[root.task-selected].line_index);
                        }
                        return accept;
                    }
                    if e.text == "t" {
                        if root.tasks.length > 0 {
                            root.toggle-timer(root.tasks[root.task-selected].note_id, root.tasks[root.task-selected].title);
                        }
                        return accept;
                    }
                    return reject;
                }
            }
            VerticalLayout {
                padding: 8px;
                spacing: 8px;
                // Top bar: back to clipboard + a "Show done" toggle.
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 92px;
                        height: 30px;
                        border-radius: 6px;
                        background: tback.has-hover ? #34343c : #2a2a30;
                        tback := TouchArea { clicked => { root.set-mode-tasks(false); } }
                        Text { text: "← Clipboard"; color: #d0d0d4; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "Tasks"; color: white; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                    // Live running-timer indicator (only while a timer runs).
                    if root.active-title != "": Rectangle {
                        height: 30px;
                        border-radius: 6px;
                        background: #24352b;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            Text { text: "▶"; color: #7ad7a0; font-size: 12px; vertical-alignment: center; }
                            Text { text: root.active-title; color: #d7e6dd; font-size: 12px; vertical-alignment: center; overflow: elide; }
                            Text {
                                text: Math.floor(root.active-elapsed-sec / 60) + ":" + (Math.mod(root.active-elapsed-sec, 60) < 10 ? "0" : "") + Math.mod(root.active-elapsed-sec, 60);
                                color: #7ad7a0;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 100px;
                        height: 30px;
                        border-radius: 6px;
                        background: root.show-done ? Pal.accent : (tdone.has-hover ? #34343c : #2a2a30);
                        tdone := TouchArea {
                            clicked => {
                                root.show-done = !root.show-done;
                                root.refresh-tasks();
                            }
                        }
                        Text { text: "Show done"; color: root.show-done ? Pal.on-accent : #d0d0d4; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                // Tick the running-timer display once a second while active.
                Timer {
                    interval: 1s;
                    running: root.active-title != "";
                    triggered => {
                        root.active-elapsed-sec += 1;
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    for f in [
                        { id: "all", label: "All" },
                        { id: "today", label: "Today" },
                        { id: "recurring", label: "Recurring" },
                        { id: "star", label: "★" },
                    ]: Rectangle {
                        height: 26px;
                        width: f.id == "star" ? 34px : (f.id == "recurring" ? 96px : 60px);
                        border-radius: 6px;
                        background: root.task-filter == f.id ? Pal.accent : (chf.has-hover ? #34343c : #2a2a30);
                        chf := TouchArea { clicked => { root.task-filter = f.id; root.refresh-tasks(); } }
                        Text { text: f.label; color: root.task-filter == f.id ? Pal.on-accent : #d0d0d4; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                // The list. `group_sort` already clusters by project + orders within,
                // so a flat list reads correctly top-to-bottom.
                ListView {
                    for t[i] in root.tasks: VerticalLayout {
                        spacing: 0px;
                        // Project group header — shown once per project cluster so the
                        // grouping is legible.
                        if i == 0 || root.tasks[i - 1].project != t.project: Text {
                            text: t.project == "" ? "No project" : "#" + t.project;
                            color: #8a8a90;
                            font-size: 11px;
                            font-weight: 700;
                            height: 26px;
                            vertical-alignment: bottom;
                        }
                        Rectangle {
                        height: 48px;
                        background: i == root.task-selected ? #262b3d : (trow.has-hover ? #26262c : transparent);
                        border-radius: 6px;
                        // Accent bar marks the keyboard-selected row.
                        if i == root.task-selected: Rectangle {
                            x: 0;
                            y: 8px;
                            width: 3px;
                            height: 32px;
                            border-radius: 1.5px;
                            background: Pal.accent;
                        }
                        // Row click jumps to the note that owns this task. The checkbox
                        // has its own TouchArea (declared later → higher z-order) so it
                        // toggles instead of opening the note.
                        trow := TouchArea { clicked => { root.open-task-note(t.note_id); } }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 10px;
                            spacing: 8px;
                            // Checkbox column.
                            Rectangle {
                                width: 24px;
                                Rectangle {
                                    y: 13px;
                                    width: 22px;
                                    height: 22px;
                                    border-radius: 5px;
                                    border-width: 1px;
                                    border-color: t.doing && !t.done ? #e0a44a : #55555f;
                                    background: t.done ? Pal.accent : (t.doing ? #e0a44a33 : transparent);
                                    if t.done: Text {
                                        text: "✓";
                                        color: Pal.on-accent;
                                        font-size: 13px;
                                        width: 22px;
                                        height: 22px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    if !t.done && t.doing: Text {
                                        text: "◐";
                                        color: #e0a44a;
                                        font-size: 13px;
                                        width: 22px;
                                        height: 22px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                cbta := TouchArea { clicked => { root.toggle-task(t.note_id, t.line_index); } }
                            }
                            // Priority pill in the gutter: labeled H/M/L (0 red /
                            // 1 amber / 2 blue) so the colour isn't a mystery; blank
                            // for None.
                            Rectangle {
                                width: 20px;
                                if t.priority <= 2: Rectangle {
                                    y: 15px;
                                    width: 18px;
                                    height: 18px;
                                    border-radius: 5px;
                                    background: t.priority == 0 ? #e05a5a
                                        : (t.priority == 1 ? #e0a44a : #6a8cff);
                                    Text {
                                        text: t.priority == 0 ? "H" : (t.priority == 1 ? "M" : "L");
                                        color: #16161a;
                                        font-size: 11px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                Text {
                                    text: t.title;
                                    // Done tasks are dimmed (Slint Text has no strike).
                                    color: t.done ? #6a6a70 : white;
                                    font-size: 14px;
                                    overflow: elide;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    if t.due != "": Text { text: t.due; color: t.overdue ? #e06a6a : #9a9aa0; font-size: 11px; vertical-alignment: center; }
                                    if t.project != "": Text { text: "#" + t.project; color: #9ab0ff; font-size: 11px; vertical-alignment: center; }
                                    if t.recur != "": Text { text: t.recur; color: #7ad7a0; font-size: 11px; vertical-alignment: center; }
                                    if t.time_total != "": Text { text: "⏱ " + t.time_total; color: #9a9aa0; font-size: 11px; vertical-alignment: center; }
                                    // (bookmark shown by the trailing ★ toggle, not a badge)
                                    if t.source != "": Text { text: t.source; color: #62626a; font-size: 10px; vertical-alignment: center; overflow: elide; }
                                }
                            }
                            Rectangle {
                                width: 30px;
                                bmk := TouchArea { clicked => { root.toggle-bookmark(t.note_id, t.line_index); } }
                                Text {
                                    text: t.bookmarked ? "★" : "☆";
                                    color: t.bookmarked ? #e0c04a : (bmk.has-hover ? #d0d0d4 : #55555f);
                                    font-size: 16px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle {
                                width: 30px;
                                tmr := TouchArea { clicked => { root.toggle-timer(t.note_id, t.title); } }
                                Text {
                                    text: t.tracking ? "⏹" : "▶";
                                    color: t.tracking ? #7ad7a0 : (tmr.has-hover ? #d0d0d4 : #55555f);
                                    font-size: 14px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        }
                    }
                }
                // Empty state.
                if root.tasks.length == 0: HorizontalLayout {
                    alignment: center;
                    Text {
                        text: root.show-done ? "No tasks yet." : "No open tasks. Add “- [ ] …” to a note.";
                        color: #6a6a70;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ---- Board mode (opaque overlay: cross-project task board) ----
        if root.board-mode: Rectangle {
            background: #1e1e21;
            bfs := FocusScope {
                init => { self.focus(); }
                key-pressed(e) => {
                    if e.text == Key.Escape {
                        root.set-mode-board(false);
                        searchinput.focus();
                        return accept;
                    }
                    return reject;
                }
            }
            VerticalLayout {
                padding: 8px;
                spacing: 8px;
                // Top bar: back to clipboard + title.
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 92px;
                        height: 30px;
                        border-radius: 6px;
                        background: bdback.has-hover ? #34343c : #2a2a30;
                        bdback := TouchArea { clicked => { root.set-mode-board(false); } }
                        Text { text: "← Clipboard"; color: #d0d0d4; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "Board"; color: white; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
                // Controls row 1: Group / Layout / Sort chip groups + Hide done.
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "Group:"; color: #8a8a90; font-size: 11px; vertical-alignment: center; }
                        for g[i] in ["Status", "Priority", "Project"]: Rectangle {
                            height: 24px;
                            width: 66px;
                            border-radius: 6px;
                            background: root.board-group == i ? Pal.accent : (bgta.has-hover ? #34343c : #2a2a30);
                            bgta := TouchArea { clicked => { root.board-group = i; root.board-controls-changed(); } }
                            Text { text: g; color: root.board-group == i ? Pal.on-accent : #d0d0d4; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "Layout:"; color: #8a8a90; font-size: 11px; vertical-alignment: center; }
                        for lo[i] in ["Kanban", "List", "Grid", "Table"]: Rectangle {
                            height: 24px;
                            width: 58px;
                            border-radius: 6px;
                            background: root.board-layout == i ? Pal.accent : (blta.has-hover ? #34343c : #2a2a30);
                            blta := TouchArea { clicked => { root.board-layout = i; root.board-controls-changed(); } }
                            Text { text: lo; color: root.board-layout == i ? Pal.on-accent : #d0d0d4; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "Sort:"; color: #8a8a90; font-size: 11px; vertical-alignment: center; }
                        for so[i] in ["Due", "Priority", "Title", "Status"]: Rectangle {
                            height: 24px;
                            width: 66px;
                            border-radius: 6px;
                            background: root.board-sort == i ? Pal.accent : (bsta.has-hover ? #34343c : #2a2a30);
                            bsta := TouchArea { clicked => { root.board-sort = i; root.board-controls-changed(); } }
                            Text { text: so; color: root.board-sort == i ? Pal.on-accent : #d0d0d4; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    Rectangle {
                        height: 24px;
                        width: 84px;
                        border-radius: 6px;
                        background: root.board-hide-done ? Pal.accent : (bhdta.has-hover ? #34343c : #2a2a30);
                        bhdta := TouchArea { clicked => { root.board-hide-done = !root.board-hide-done; root.board-controls-changed(); } }
                        Text { text: "Hide done"; color: root.board-hide-done ? Pal.on-accent : #d0d0d4; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                // Controls row 2: project filter chips + title search.
                HorizontalLayout {
                    spacing: 10px;
                    Flickable {
                        width: 240px;
                        height: 26px;
                        viewport-width: bprow.preferred-width;
                        viewport-height: self.height;
                        bprow := HorizontalLayout {
                            height: 26px;
                            spacing: 4px;
                            alignment: start;
                            Rectangle {
                                height: 24px;
                                width: 40px;
                                border-radius: 6px;
                                background: root.board-project-filter == "" ? Pal.accent : (bpallta.has-hover ? #34343c : #2a2a30);
                                bpallta := TouchArea { clicked => { root.board-project-filter = ""; root.board-controls-changed(); } }
                                Text { text: "All"; color: root.board-project-filter == "" ? Pal.on-accent : #d0d0d4; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            for p in root.board-projects: Rectangle {
                                height: 24px;
                                width: 76px;
                                border-radius: 6px;
                                background: root.board-project-filter == p ? Pal.accent : (bpta.has-hover ? #34343c : #2a2a30);
                                bpta := TouchArea { clicked => { root.board-project-filter = p; root.board-controls-changed(); } }
                                Text { text: p; color: root.board-project-filter == p ? Pal.on-accent : #d0d0d4; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: #2a2a30;
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            if root.board-query == "": Text { text: "Search title…"; color: #6a6a70; font-size: 12px; vertical-alignment: center; }
                            bqta := TextInput {
                                text <=> root.board-query;
                                color: #d0d0d4;
                                font-size: 12px;
                                single-line: true;
                                vertical-alignment: center;
                                edited => { root.board-controls-changed(); }
                            }
                        }
                    }
                }
                // Body: Kanban scrolls columns horizontally; List (and the Grid/Table
                // placeholders, for this pass) stack column header + cards vertically.
                if root.board-layout == 0: Flickable {
                    vertical-stretch: 1;
                    viewport-width: kanbanrow.preferred-width;
                    viewport-height: self.height;
                    kanbanrow := HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        for col in root.board: Rectangle {
                            width: 260px;
                            background: #202024;
                            border-radius: 8px;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 8px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text { text: col.title; color: white; font-size: 13px; font-weight: 700; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: col.count; color: #8a8a90; font-size: 12px; vertical-alignment: center; }
                                }
                                ListView {
                                    for t in col.tasks: BoardCard {
                                        t: t;
                                        open => { root.board-open-task(t.note_id); }
                                        set-status(s) => { root.board-set-status(t.note_id, t.line_index, s); }
                                    }
                                }
                            }
                        }
                    }
                }
                if root.board-layout != 0: ListView {
                    vertical-stretch: 1;
                    for col in root.board: VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 6px;
                            height: 24px;
                            Text { text: col.title; color: #8a8a90; font-size: 12px; font-weight: 700; vertical-alignment: bottom; }
                            Text { text: "(" + col.count + ")"; color: #6a6a70; font-size: 11px; vertical-alignment: bottom; }
                        }
                        for t in col.tasks: BoardCard {
                            t: t;
                            open => { root.board-open-task(t.note_id); }
                            set-status(s) => { root.board-set-status(t.note_id, t.line_index, s); }
                        }
                    }
                }
                if root.board.length == 0: HorizontalLayout {
                    alignment: center;
                    Text { text: "No tasks match these filters."; color: #6a6a70; font-size: 13px; vertical-alignment: center; }
                }
            }
        }

        if root.bookmarks-mode: Rectangle {
            background: #1e1e21;
            VerticalLayout {
                padding: 8px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 92px; height: 30px; border-radius: 6px;
                        background: bkback.has-hover ? #34343c : #2a2a30;
                        bkback := TouchArea { clicked => { root.set-mode-bookmarks(false); } }
                        Text { text: "← Clipboard"; color: #d0d0d4; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "Bookmarks"; color: white; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
                // Search + add-url row.
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        horizontal-stretch: 1; height: 30px; background: #2a2a30; border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px;
                            if root.bookmark-query == "": Text { text: "Search bookmarks…"; color: #6a6a70; font-size: 13px; vertical-alignment: center; }
                            bkq := TextInput {
                                text <=> root.bookmark-query;
                                color: #d0d0d4; font-size: 13px; single-line: true; vertical-alignment: center;
                                edited => { root.bookmark-search(self.text); }
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1; height: 30px; background: #2a2a30; border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px;
                            if root.bookmark-add-url == "": Text { text: "Add URL  (optionally  #tags)…"; color: #6a6a70; font-size: 13px; vertical-alignment: center; }
                            bkadd := TextInput {
                                text <=> root.bookmark-add-url;
                                color: #d0d0d4; font-size: 13px; single-line: true; vertical-alignment: center;
                                key-pressed(e) => {
                                    if e.text == Key.Return { root.add-bookmark(self.text); self.text = ""; return accept; }
                                    return reject;
                                }
                            }
                        }
                    }
                }
                ListView {
                    for b in root.bookmarks: Rectangle {
                        height: 46px;
                        background: bkrow.has-hover ? #26262c : transparent;
                        border-radius: 6px;
                        bkrow := TouchArea { clicked => { root.open-bookmark(b.url); } }
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 8px;
                            if b.has-icon: Image { source: b.icon; width: 16px; height: 16px; }
                            if !b.has-icon: Text { text: "🔖"; font-size: 15px; vertical-alignment: center; }
                            VerticalLayout {
                                horizontal-stretch: 1; padding-top: 5px; padding-bottom: 5px;
                                Text { text: b.title == "" ? b.url : b.title; color: white; font-size: 13px; overflow: elide; }
                                Text { text: b.domain; color: #8a8a90; font-size: 11px; overflow: elide; }
                                if b.tags != "": Text { text: b.tags; color: #6a6a70; font-size: 10px; overflow: elide; }
                            }
                            Rectangle {
                                width: 28px;
                                bkdel := TouchArea { clicked => { root.delete-bookmark(b.id); } }
                                Text { text: "×"; color: bkdel.has-hover ? #ff9a9a : #55555f; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }
                if root.bookmarks.length == 0: HorizontalLayout {
                    alignment: center;
                    Text { text: "No bookmarks yet. Add a URL above, or ⌘K → Bookmark a copied link."; color: #6a6a70; font-size: 13px; vertical-alignment: center; }
                }
            }
        }

        // ---- Find everywhere (⌘⇧F): unified search over notes/tasks/bookmarks.
        // The clipboard already has its own search box; this covers the other
        // three surfaces in one palette. Styled to match the Bookmarks overlay. ----
        if root.search-mode: Rectangle {
            background: #1e1e21;
            VerticalLayout {
                padding: 8px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 92px; height: 30px; border-radius: 6px;
                        background: sback.has-hover ? #34343c : #2a2a30;
                        sback := TouchArea { clicked => { root.close-search(); } }
                        Text { text: "← Clipboard"; color: #d0d0d4; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "Find everywhere"; color: white; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle {
                    height: 30px; background: #2a2a30; border-radius: 6px;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        if root.search-query == "": Text { text: "Find in notes, tasks, bookmarks…"; color: #6a6a70; font-size: 13px; vertical-alignment: center; }
                        sq := TextInput {
                            text <=> root.search-query;
                            color: #d0d0d4; font-size: 13px; single-line: true; vertical-alignment: center;
                            init => { self.focus(); }
                            edited => { root.run-unified-search(self.text); }
                            accepted => { root.run-unified-search(self.text); }
                            key-pressed(e) => {
                                if e.text == Key.Escape {
                                    root.close-search();
                                    searchinput.focus();
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;

                        Text { text: "Notes"; color: #8a8a90; font-size: 11px; font-weight: 700; }
                        for n in root.search-notes: Rectangle {
                            height: 34px;
                            background: snrow.has-hover ? #26262c : transparent;
                            border-radius: 6px;
                            snrow := TouchArea { clicked => { root.open-search-note(n.id); } }
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 8px;
                                Text { text: "📝"; font-size: 13px; vertical-alignment: center; }
                                Text { text: n.title; color: white; font-size: 13px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                            }
                        }
                        if root.search-notes.length == 0: Text { text: "—"; color: #55555f; font-size: 12px; }

                        Text { text: "Tasks"; color: #8a8a90; font-size: 11px; font-weight: 700; }
                        for t in root.search-tasks: Rectangle {
                            height: 34px;
                            background: strow.has-hover ? #26262c : transparent;
                            border-radius: 6px;
                            strow := TouchArea { clicked => { root.open-search-task(t.id); } }
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 8px;
                                Text { text: "☑"; font-size: 13px; vertical-alignment: center; }
                                Text { text: t.title; color: white; font-size: 13px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                            }
                        }
                        if root.search-tasks.length == 0: Text { text: "—"; color: #55555f; font-size: 12px; }

                        Text { text: "Bookmarks"; color: #8a8a90; font-size: 11px; font-weight: 700; }
                        for b in root.search-bookmarks: Rectangle {
                            height: 34px;
                            background: sbrow.has-hover ? #26262c : transparent;
                            border-radius: 6px;
                            sbrow := TouchArea { clicked => { root.open-search-bookmark(b.url); } }
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 8px;
                                Text { text: "🔖"; font-size: 13px; vertical-alignment: center; }
                                Text { text: b.title; color: white; font-size: 13px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                            }
                        }
                        if root.search-bookmarks.length == 0: Text { text: "—"; color: #55555f; font-size: 12px; }
                    }
                }
            }
        }

        // ---- Today dashboard (full-window merge of the popover's Today +
        // Daily + Clipboard tabs) ----
        if root.today-mode: Rectangle {
            background: #1e1e21;
            VerticalLayout {
                padding: 8px;
                spacing: 8px;
                // Top bar: back to clipboard + the running-timer chip (copied
                // from the Tasks-mode header).
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 92px;
                        height: 30px;
                        border-radius: 6px;
                        background: todback.has-hover ? #34343c : #2a2a30;
                        todback := TouchArea { clicked => { root.set-mode-today(false); } }
                        Text { text: "← Clipboard"; color: #d0d0d4; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "Today"; color: white; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    if root.active-title != "": Rectangle {
                        height: 30px;
                        border-radius: 6px;
                        background: #24352b;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            Text { text: "▶"; color: #7ad7a0; font-size: 12px; vertical-alignment: center; }
                            Text { text: root.active-title; color: #d7e6dd; font-size: 12px; vertical-alignment: center; overflow: elide; }
                            Text {
                                text: Math.floor(root.active-elapsed-sec / 60) + ":" + (Math.mod(root.active-elapsed-sec, 60) < 10 ? "0" : "") + Math.mod(root.active-elapsed-sec, 60);
                                color: #7ad7a0;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                // Tick the running-timer display once a second while active.
                Timer {
                    interval: 1s;
                    running: root.active-title != "";
                    triggered => {
                        root.active-elapsed-sec += 1;
                    }
                }
                Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 12px;

                        Text { text: "Due & overdue"; color: #8a8a90; font-size: 11px; font-weight: 700; }
                        for t in root.today-due: PopoverTaskRow {
                            t: t;
                            toggle => { root.toggle-task(t.note_id, t.line_index); }
                            open => { root.open-task-note(t.note_id); }
                        }
                        if root.today-due.length == 0: Text { text: "Nothing due — you're clear ✨"; color: #6a6a70; font-size: 13px; }

                        Text { text: "Journal"; color: #8a8a90; font-size: 11px; font-weight: 700; }
                        Rectangle {
                            height: 140px;
                            background: #2a2a30;
                            border-radius: 8px;
                            Flickable {
                                x: 10px;
                                y: 8px;
                                width: parent.width - 20px;
                                height: parent.height - 16px;
                                TextInput {
                                    width: parent.width;
                                    text <=> root.today-journal;
                                    color: #d0d0d4;
                                    font-size: 13px;
                                    single-line: false;
                                    wrap: word-wrap;
                                    edited => { root.edit-today-journal(self.text); }
                                }
                            }
                        }

                        Text { text: "Recent clips"; color: #8a8a90; font-size: 11px; font-weight: 700; }
                        for c[i] in root.today-clips: Rectangle {
                            height: 34px;
                            background: crow.has-hover ? #26262c : transparent;
                            border-radius: 6px;
                            crow := TouchArea { clicked => { root.today-paste-clip(i); } }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                Text { text: c.glyph; font-size: 13px; vertical-alignment: center; }
                                Text { text: c.title; color: white; font-size: 13px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }
        }

        // ---- Journal (chronological timeline over the daily notes) ----
        if root.journal-mode: Rectangle {
            background: #1e1e21;
            VerticalLayout {
                padding: 8px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 92px; height: 30px; border-radius: 6px;
                        background: jrback.has-hover ? #34343c : #2a2a30;
                        jrback := TouchArea { clicked => { root.set-mode-journal(false); } }
                        Text { text: "← Clipboard"; color: #d0d0d4; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "Journal"; color: white; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
                ListView {
                    vertical-stretch: 1;
                    for j in root.journal: Rectangle {
                        // Card height grows with content.
                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;
                            Text { text: j.date; color: #9ab0ff; font-size: 13px; font-weight: 700; }
                            Rectangle {
                                background: #161618;
                                border-radius: 8px;
                                VerticalLayout {
                                    padding: 8px;
                                    jed := TextInput {
                                        text: j.body;
                                        color: #d0d0d4;
                                        font-size: 13px;
                                        single-line: false;
                                        wrap: word-wrap;
                                        edited => { root.edit-journal-entry(j.note_id, self.text); }
                                    }
                                    if j.body == "": Text { text: "Empty — jot something…"; color: #55555f; font-size: 12px; }
                                }
                            }
                        }
                    }
                }
                if root.journal.length == 0: Text { text: "No journal entries yet."; color: #6a6a70; font-size: 13px; }
            }
        }

        // ---- Help modal (centered overlay) ----
        if root.mode == "help": Rectangle {
            background: #000000aa;
            TouchArea { clicked => { root.mode = "list"; } }
            Rectangle {
                width: 460px;
                // Tall enough for the whole table — at 460px the last row was clipped
                // mid-line, which reads as a rendering bug rather than "scroll me".
                height: 540px;
                background: #1e1e21;
                border-radius: 12px;
                border-width: 1px;
                border-color: #3a3a40;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "Keyboard Shortcuts"; color: white; font-size: 15px; font-weight: 700; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;

                            Text { text: "Navigation"; color: Pal.accent; font-size: 12px; }
                            for row in [
                                { k: "↑ / ↓", d: "Move selection" },
                                { k: "⏎", d: "Paste to the previous app + close" },
                                { k: "⌘⏎", d: "Paste + keep Magpie open" },
                                { k: "Esc", d: "Clear search, then close" },
                                { k: "type", d: "Filter entries" },
                                { k: "⌘1–9", d: "Paste the Nth entry" },
                            ]: HorizontalLayout {
                                Text { text: row.k; color: #d0d0d4; font-size: 12px; width: 130px; }
                                Text { text: row.d; color: #9a9aa0; font-size: 12px; }
                            }

                            Text { text: "Actions"; color: Pal.accent; font-size: 12px; }
                            for row in [
                                { k: "⌘K", d: "Open the actions menu" },
                                { k: "⌘F", d: "Filters (source app / time)" },
                                { k: "⌘⇧F", d: "Find everywhere (notes/tasks/bookmarks)" },
                                { k: "⌘C", d: "Copy (no paste)" },
                                { k: "⌘E", d: "Edit the entry" },
                                { k: "⌘N", d: "New snippet" },
                                { k: "⌘P", d: "Pin / unpin" },
                                { k: "⌘S", d: "Assign to a ⌘1–9 slot" },
                                { k: "⌘G", d: "Add to merge" },
                                { k: "⌘J", d: "New note from this entry" },
                                { k: "⌘V", d: "Paste clipboard into search" },
                                { k: "⌘⌫", d: "Delete the entry" },
                            ]: HorizontalLayout {
                                Text { text: row.k; color: #d0d0d4; font-size: 12px; width: 130px; }
                                Text { text: row.d; color: #9a9aa0; font-size: 12px; }
                            }

                            Text { text: "Views"; color: Pal.accent; font-size: 12px; }
                            for row in [
                                { k: "⌘/  or  ?", d: "This help" },
                                { k: "⌘+ / ⌘− / ⌘0", d: "Preview text size" },
                                { k: "🔒 Mask", d: "Screenshare mode (hide all content)" },
                                { k: "Notes", d: "Notes & pages" },
                                { k: "⌘⏎", d: "Make task (in a note)" },
                                { k: "Tasks", d: "Task list from your notes" },
                                { k: "Stats", d: "Copy analytics" },
                            ]: HorizontalLayout {
                                Text { text: row.k; color: #d0d0d4; font-size: 12px; width: 130px; }
                                Text { text: row.d; color: #9a9aa0; font-size: 12px; }
                            }
                        }
                    }
                    Text { text: "Esc to close"; color: #6a6a70; font-size: 11px; horizontal-alignment: center; }
                }
            }
        }

        // ---- Accessibility permission modal (macOS auto-paste) ----
        if root.needs-accessibility: Rectangle {
            background: #000000cc;
            TouchArea {} // swallow clicks behind the modal
            Rectangle {
                width: 460px;
                height: 300px;
                background: #1e1e21;
                border-radius: 12px;
                border-width: 1px;
                border-color: #3a3a40;
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Text {
                        text: "Enable auto-paste";
                        color: white;
                        font-size: 16px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Magpie needs Accessibility permission to paste into other apps (it sends ⌘V for you). Your clipboard history still works without it — you can paste manually.";
                        color: #b0b0b6;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "1. Click “Open System Settings”.\n2. Enable Magpie under Privacy & Security ▸ Accessibility.\n3. Come back and click “I’ve enabled it”.";
                        color: #9a9aa0;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            height: 34px;
                            background: openta.has-hover ? #7f9dff : Pal.accent;
                            border-radius: 8px;
                            openta := TouchArea {
                                clicked => { root.open-accessibility-settings(); }
                            }
                            Text { text: "Open System Settings"; color: Pal.on-accent; font-size: 13px; }
                        }
                        Rectangle {
                            height: 34px;
                            width: 130px;
                            background: recheckta.has-hover ? #34343c : #2a2a30;
                            border-radius: 8px;
                            recheckta := TouchArea {
                                clicked => { root.recheck-accessibility(); }
                            }
                            Text { text: "I’ve enabled it"; color: #d0d0d4; font-size: 13px; }
                        }
                    }
                    Rectangle {
                        height: 28px;
                        dismissta := TouchArea {
                            clicked => { root.dismiss-accessibility(); }
                        }
                        Text {
                            text: "Not now";
                            color: dismissta.has-hover ? #c0c0c6 : #7a7a80;
                            font-size: 12px;
                        }
                    }
                }
            }
        }

        // ---- ⌘F advanced search overlay ----
        if root.mode == "search": Rectangle {
            background: #000000aa;
            TouchArea { clicked => { root.mode = "list"; } }
            Rectangle {
                width: 460px;
                height: 520px;
                background: #1e1e21;
                border-radius: 12px;
                border-width: 1px;
                border-color: #3a3a40;
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    Text { text: "Filters"; color: white; font-size: 14px; font-weight: 700; }

                    Text { text: "Time range"; color: #8a8a92; font-size: 11px; }
                    HorizontalLayout {
                        spacing: 6px;
                        for label[i] in ["All", "Today", "Last 7 days", "Last 30 days"]: Rectangle {
                            height: 28px;
                            width: 100px;
                            background: i == root.time-index ? Pal.accent : (tfta.has-hover ? #35353d : #2a2a30);
                            border-radius: 6px;
                            tfta := TouchArea { clicked => { root.time-index = i; root.set-time-filter(i); } }
                            Text { text: label; color: i == root.time-index ? Pal.on-accent : white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }

                    Text { text: "Show"; color: #8a8a92; font-size: 11px; }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for label[i] in ["Everything", "Pinned only"]: Rectangle {
                            height: 28px;
                            width: 110px;
                            background: (i == 1) == root.pinned-only ? Pal.accent : (pota.has-hover ? #35353d : #2a2a30);
                            border-radius: 6px;
                            pota := TouchArea {
                                clicked => {
                                    root.pinned-only = (i == 1);
                                    root.set-pinned-only(i == 1);
                                }
                            }
                            Text {
                                text: label;
                                color: (i == 1) == root.pinned-only ? Pal.on-accent : white;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text { text: "Sort"; color: #8a8a92; font-size: 11px; }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for label[i] in ["Recent", "Most copied"]: Rectangle {
                            height: 28px;
                            width: 110px;
                            background: i == root.sort-index ? #3a3a40 : (sota.has-hover ? #2c2c33 : #202024);
                            border-radius: 6px;
                            sota := TouchArea { clicked => { root.sort-index = i; root.set-sort(i); } }
                            Text { text: label; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }

                    Text { text: "Source app"; color: #8a8a92; font-size: 11px; }
                    // Left-aligned rows with hover + a ✓ on the active filter — the
                    // previous centred labels read as floating text, and there was no
                    // way to tell which app was filtered.
                    Rectangle {
                        height: 30px;
                        border-radius: 6px;
                        background: root.app-index == -1 ? #2f2f37 : (anyta.has-hover ? #232329 : transparent);
                        anyta := TouchArea { clicked => { root.set-app-filter(-1); } }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text { text: "Any app"; color: white; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                            Text { text: root.app-index == -1 ? "✓" : ""; color: Pal.accent; font-size: 12px; vertical-alignment: center; }
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for a in root.apps: Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            background: root.app-index == a.id ? #2f2f37 : (apta.has-hover ? #232329 : transparent);
                            apta := TouchArea { clicked => { root.set-app-filter(a.id); } }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                Text { text: a.name; color: white; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                Text { text: root.app-index == a.id ? "✓" : ""; color: Pal.accent; font-size: 12px; vertical-alignment: center; }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            height: 30px;
                            width: 110px;
                            background: cfta.has-hover ? #35353d : #2a2a30;
                            border-radius: 6px;
                            cfta := TouchArea { clicked => { root.clear-filters(); } }
                            Text { text: "Clear filters"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: "Esc to close"; color: #6a6a70; font-size: 11px; vertical-alignment: center; horizontal-alignment: right; horizontal-stretch: 1; }
                    }
                }
            }
        }

        // ---- ⌘K actions palette overlay (searchable) ----
        if root.mode == "actions": Rectangle {
            background: #000000aa;
            TouchArea { clicked => { root.mode = "list"; } }
            Rectangle {
                width: 440px;
                height: 360px;
                background: #1e1e21;
                border-radius: 12px;
                border-width: 1px;
                border-color: #3a3a40;
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    // Search field on TOP, the way every command palette does it
                    // (Spotlight / Raycast / ⌘K). Keys are fed in by the search
                    // field's key handler while actions are open, so a drawn caret
                    // stands in for the real one.
                    Rectangle {
                        height: 34px;
                        background: #161618;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #33333c;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 2px;
                            Text { text: "🔍"; font-size: 13px; vertical-alignment: center; }
                            Rectangle { width: 4px; }
                            Text {
                                text: root.actions-query;
                                color: white;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Rectangle { width: 2px; height: 17px; background: Pal.accent; }
                            if root.actions-query == "": Text {
                                text: "Search actions…";
                                color: #6a6a70;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for a[i] in root.actions: Rectangle {
                            height: 34px;
                            background: i == root.action-selected ? #2f2f37 : (acta.has-hover ? #232329 : transparent);
                            border-radius: 6px;
                            acta := TouchArea { clicked => { root.run-action(a.id); } }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                ActionIcon { id: a.id; width: 22px; height: 18px; tint: a.id == "delete" ? #ff9a9a : #d0d0d4; }
                                Text { text: a.label; color: a.id == "delete" ? #ff9a9a : white; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: a.key; color: #85858d; font-size: 12px; vertical-alignment: center; }
                            }
                        }
                    }
                    if root.actions.length == 0: Text {
                        text: "No matching action";
                        color: #6a6a70;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "↑↓ Move · ⏎ Run · Esc Close";
                        color: #6a6a70;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // ---- ⌘S slot picker ----
        // Assigning a slot had no entry point at all before this: the DB, the
        // ⌘1–9 paste hotkeys and the "Slot" metadata row all existed, but nothing
        // in the UI could put an entry into a slot.
        if root.mode == "slots": Rectangle {
            background: #000000aa;
            TouchArea { clicked => { root.mode = "list"; } }
            Rectangle {
                width: 420px;
                height: 420px;
                background: #1e1e21;
                border-radius: 12px;
                border-width: 1px;
                border-color: #3a3a40;
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    Text { text: "Assign to slot"; color: white; font-size: 14px; font-weight: 700; }
                    Text {
                        text: "Slotted entries paste from anywhere with ⌘1–9, even when Magpie is closed. Picking a slot that already holds this entry clears it.";
                        color: #9a9aa0;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    VerticalLayout {
                        spacing: 2px;
                        vertical-stretch: 1;
                        // Pack the rows at the top — stretched-apart rows leave gaps
                        // that look clickable but aren't.
                        alignment: start;
                        for s in root.all-slots: Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            background: (entries.length > 0 && root.selected < entries.length && entries[root.selected].slot == s.n)
                                ? #2f2f37 : (slpta.has-hover ? #232329 : transparent);
                            slpta := TouchArea {
                                clicked => {
                                    root.assign-slot(root.selected, s.n);
                                    root.mode = "list";
                                }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                Text { text: "⌘" + s.n; color: Pal.accent; font-size: 12px; width: 30px; vertical-alignment: center; }
                                Text {
                                    text: s.title;
                                    color: s.filled ? white : #6a6a70;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: (entries.length > 0 && root.selected < entries.length && entries[root.selected].slot == s.n) ? "✓" : "";
                                    color: Pal.accent;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    Text {
                        text: "1–9 Assign · Esc Cancel";
                        color: #6a6a70;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // ---- Edit / new-snippet modal ----
        // A centred modal like the other overlays. It used to be squeezed into the
        // bottom of the (narrow) detail pane, which pushed Save/Cancel off the
        // window edge and left no way to tell edit from new-snippet.
        if root.edit-mode != "none": Rectangle {
            background: #000000cc;
            TouchArea {} // swallow clicks behind the modal
            Rectangle {
                width: 540px;
                height: 420px;
                background: #1e1e21;
                border-radius: 12px;
                border-width: 1px;
                border-color: #3a3a40;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text {
                        text: root.edit-mode == "snippet" ? "New snippet" : "Edit entry";
                        color: white;
                        font-size: 15px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.edit-mode == "snippet"
                            ? "Snippets are saved alongside your history — search and paste them like any other entry."
                            : "Saving replaces this entry’s text. The original is not kept.";
                        color: #9a9aa0;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    // FocusScope so Esc / ⌘⏎ still work while the editor has focus
                    // (TextEdit rejects them, so they bubble up here).
                    FocusScope {
                        vertical-stretch: 1;
                        key-pressed(event) => {
                            if event.text == Key.Escape { root.cancel-edit(); return accept; }
                            if event.modifiers.control && event.text == Key.Return {
                                root.save-edit(root.edit-text);
                                return accept;
                            }
                            return reject;
                        }
                        editor := TextEdit {
                            width: 100%;
                            height: 100%;
                            text <=> root.edit-text;
                            init => { editor.focus(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "⌘⏎ Save · Esc Cancel";
                            color: #6a6a70;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: 74px;
                            height: 30px;
                            background: cancelta.has-hover ? #35353d : #2a2a30;
                            border-radius: 6px;
                            cancelta := TouchArea { clicked => { root.cancel-edit(); } }
                            Text { text: "Cancel"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            width: 74px;
                            height: 30px;
                            background: saveta.has-hover ? #7f9dff : Pal.accent;
                            border-radius: 6px;
                            saveta := TouchArea { clicked => { root.save-edit(root.edit-text); } }
                            Text { text: "Save"; color: Pal.on-accent; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }

    // ---- First-run welcome overlay ----
    // The VERY LAST child of the root Window, so it draws on top of every other
    // overlay (help, accessibility, edit) above.
    if root.show-welcome: Rectangle {
        background: #000000cc;
        TouchArea { clicked => { root.dismiss-welcome(); } } // click backdrop to dismiss
        Rectangle {
            width: 460px;
            height: 340px;
            background: #1e1e21;
            border-radius: 14px;
            border-width: 1px;
            border-color: #3a3a40;
            // Swallow clicks on the card so they don't dismiss.
            TouchArea {}
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text { text: "Welcome to Magpie 🐦"; color: white; font-size: 20px; font-weight: 700; }
                Text {
                    text: "Your clipboard, notes, tasks, bookmarks and time — in one local-first place.";
                    color: #b0b0b8; font-size: 13px; wrap: word-wrap;
                }
                Text { text: "Keys that matter"; color: #8a8a92; font-size: 11px; font-weight: 700; }
                Text { text: "⌘⇧Space — summon Magpie anywhere"; color: #d0d0d4; font-size: 13px; }
                Text { text: "⌘K — actions on any clipboard entry"; color: #d0d0d4; font-size: 13px; }
                Text { text: "Menu-bar icon — a quick popover"; color: #d0d0d4; font-size: 13px; }
                Text { text: "Today · Notes · Tasks · Bookmarks — the top bar"; color: #d0d0d4; font-size: 13px; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    Rectangle {
                        width: 130px; height: 34px; border-radius: 8px;
                        background: gsb.has-hover ? #7a97ff : Pal.accent;
                        gsb := TouchArea { clicked => { root.dismiss-welcome(); } }
                        Text { text: "Get started"; color: Pal.on-accent; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}

// A single popover task row (circle toggle + title + due/#project badges),
// extracted so the Tasks and Today panels can share it.
// The menubar popover: a chromeless, always-on-top second window shown on a
// tray left-click. Slice A carries a single "My tasks" tab (open tasks from your
// notes, quick-add to today's daily note, circle-toggle to complete, jump to the
// owning note, and "Open Magpie ↗" to the full window). Reuses the file-scope
// `TaskRow` struct and `Pal` global.
export component Popover inherits Window {
    no-frame: true;
    always-on-top: true;
    width: 360px;
    height: 440px;
    background: transparent;
    forward-focus: fs;

    in property <[TaskRow]> ptasks;
    in-out property <string> quick-add;

    in-out property <int> tab: 0;
    in property <[TaskRow]> overdue-tasks;
    in property <[TaskRow]> today-tasks;
    in-out property <string> daily-body;
    in property <[ClipRow]> clips;
    callback edit-daily(string);
    callback paste-clip(int);

    callback add-task(string);
    callback toggle-ptask(int, int);
    callback open-task-note(int);
    callback open-full();
    callback dismiss();

    // Rounded panel — the window itself is transparent + frameless, so this draws
    // the visible chrome (border + fill + padding).
    Rectangle {
        background: #1e1e21;
        border-radius: 12px;
        border-width: 1px;
        border-color: #3a3a40;

        fs := FocusScope {
            width: 100%;
            height: 100%;
            // Esc closes the popover; ←/→ switch tabs; everything else falls through
            // to the quick-add field.
            key-pressed(e) => {
                if e.text == Key.Escape {
                    root.dismiss();
                    return accept;
                }
                if e.text == Key.RightArrow {
                    if root.tab < 3 {
                        root.tab += 1;
                    }
                    return accept;
                }
                if e.text == Key.LeftArrow {
                    if root.tab > 0 {
                        root.tab -= 1;
                    }
                    return accept;
                }
                return reject;
            }
            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                // Interactive 4-icon tab row: click a glyph to switch panels.
                // Each tab is a FIXED-size Rectangle (so the row doesn't stretch and
                // push the icons down) with the TouchArea as the last child, so it
                // overlays the whole cell and the click lands on the icon.
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;
                    for i in [0, 1, 2, 3]: Rectangle {
                        width: 30px;
                        height: 28px;
                        VerticalLayout {
                            spacing: 3px;
                            alignment: center;
                            Image {
                                source: i == 0 ? Icons.tab-tasks
                                    : i == 1 ? Icons.tab-today
                                    : i == 2 ? Icons.tab-daily
                                    : Icons.tab-clipboard;
                                colorize: root.tab == i ? Pal.accent : #7a7a80;
                                width: 22px;
                                height: 22px;
                                image-fit: contain;
                            }
                            Rectangle { height: 2px; background: root.tab == i ? Pal.accent : transparent; }
                        }
                        ta := TouchArea { clicked => { root.tab = i; } }
                    }
                }

                if root.tab == 0: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 10px;

                    Text { text: "My tasks"; font-size: 16px; font-weight: 700; color: white; }

                    // Quick-add: Enter appends "- [ ] <text>" to today's daily note
                    // (wired in Task 3) and clears the field.
                    Rectangle {
                        height: 34px;
                        background: #2a2a30;
                        border-radius: 8px;
                        Rectangle {
                            x: 10px;
                            width: parent.width - 20px;
                            if root.quick-add == "": Text {
                                x: 0;
                                text: "Add a task…";
                                color: #6a6a70;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                            qa := TextInput {
                                width: 100%;
                                height: 100%;
                                text <=> root.quick-add;
                                color: #d0d0d4;
                                font-size: 13px;
                                single-line: true;
                                vertical-alignment: center;
                                key-pressed(e) => {
                                    if e.text == Key.Return {
                                        root.add-task(self.text);
                                        self.text = "";
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                        }
                    }

                    // Open tasks. Row click jumps to the owning note; the circle
                    // toggle completes it.
                    ListView {
                        vertical-stretch: 1;
                        for t in root.ptasks: PopoverTaskRow {
                            t: t;
                            toggle => { root.toggle-ptask(t.note_id, t.line_index); }
                            open => { root.open-task-note(t.note_id); }
                        }
                    }
                }

                if root.tab == 1: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 6px;
                    Text { text: "Today"; font-size: 16px; font-weight: 700; color: white; }
                    if root.overdue-tasks.length == 0 && root.today-tasks.length == 0: Text {
                        text: "Nothing due today.";
                        color: #6a6a70;
                        font-size: 13px;
                    }
                    if root.overdue-tasks.length > 0: Text { text: "Overdue"; color: #e06a6a; font-size: 11px; font-weight: 700; }
                    for t in root.overdue-tasks: PopoverTaskRow {
                        t: t;
                        toggle => { root.toggle-ptask(t.note_id, t.line_index); }
                        open => { root.open-task-note(t.note_id); }
                    }
                    if root.today-tasks.length > 0: Text { text: "Due today"; color: #9a9aa0; font-size: 11px; font-weight: 700; }
                    for t in root.today-tasks: PopoverTaskRow {
                        t: t;
                        toggle => { root.toggle-ptask(t.note_id, t.line_index); }
                        open => { root.open-task-note(t.note_id); }
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                if root.tab == 2: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 8px;
                    Text { text: "Daily"; font-size: 16px; font-weight: 700; color: white; }
                    Rectangle {
                        vertical-stretch: 1;
                        background: #2a2a30;
                        border-radius: 8px;
                        Flickable {
                            x: 10px;
                            y: 8px;
                            width: parent.width - 20px;
                            height: parent.height - 16px;
                            TextInput {
                                width: parent.width;
                                text <=> root.daily-body;
                                color: #d0d0d4;
                                font-size: 13px;
                                single-line: false;
                                wrap: word-wrap;
                                edited => { root.edit-daily(self.text); }
                            }
                        }
                    }
                }

                if root.tab == 3: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 6px;
                    Text { text: "Clipboard"; font-size: 16px; font-weight: 700; color: white; }
                    if root.clips.length == 0: Text { text: "No recent clips."; color: #6a6a70; font-size: 13px; }
                    ListView {
                        vertical-stretch: 1;
                        for c[i] in root.clips: Rectangle {
                            height: 34px;
                            background: crow.has-hover ? #26262c : transparent;
                            border-radius: 6px;
                            crow := TouchArea { clicked => { root.paste-clip(i); } }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                TypeIcon { kind: c.kind; width: 16px; height: 16px; tint: #b8b8be; }
                                Text {
                                    text: c.title;
                                    color: white;
                                    font-size: 13px;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Footer: jump to the full Magpie window.
                foot := TouchArea {
                    height: 24px;
                    clicked => { root.open-full(); }
                    Text {
                        text: "Open Magpie ↗";
                        color: foot.has-hover ? white : #9ab0ff;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
