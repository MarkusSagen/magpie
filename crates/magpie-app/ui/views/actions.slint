import { LineEdit, ListView, TextEdit, ScrollView } from "std-widgets.slint";
import { Theme, Pal } from "../theme.slint";
import { Icons } from "../icons.slint";
import { EntryRow, Bar, ActionItem, SlotItem, AppItem, NoteRow, BookmarkRow, JournalRow, RefRow, TaskRow, BoardColumn, GraphNode, GraphEdge, ClipRow, TimeEntryRow, SearchNoteRow, SearchTaskRow, SearchBookmarkRow } from "../types.slint";
import { TypeIcon, ActionIcon } from "../components/glyphs.slint";
import { HBar } from "../components/hbar.slint";
import { PopoverTaskRow } from "../components/task_row.slint";
import { BoardCard } from "../components/board_card.slint";
import { Keycap } from "../components/keycap.slint";

export component ActionsView inherits Rectangle {
    in-out property <int> action-selected;
    in property <[ActionItem]> actions;
    in-out property <string> actions-query;
    in-out property <string> mode;
    in property <string> entry-preview;
    callback run-action(string);
            background: Theme.scrim;
            TouchArea { clicked => { root.mode = "list"; } }
            Rectangle {
                width: 560px;
                height: 540px;
                background: Theme.bg-app;
                border-radius: Theme.r-lg;
                border-width: 1px;
                border-color: Theme.line-strong;
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    // Header: the target entry as a chip + "Search actions" (screen 03).
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            height: 34px;
                            background: Theme.bg-elevated;
                            border-radius: Theme.r-sm;
                            border-width: 1px;
                            border-color: Theme.line;
                            clip: true;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px;
                                Text { text: root.entry-preview == "" ? "entry" : root.entry-preview;
                                    color: Theme.text-dim; font-family: Theme.mono; font-size: Theme.fs-sm;
                                    vertical-alignment: center; overflow: elide; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 2px;
                            Text {
                                text: root.actions-query;
                                color: Theme.text;
                                font-size: Theme.fs-body;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Rectangle { width: 2px; height: 17px; background: Pal.accent; y: (parent.height - self.height) / 2; }
                            if root.actions-query == "": Text {
                                text: "Search actions";
                                color: Theme.text-faint;
                                font-size: Theme.fs-body;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for a[i] in root.actions: VerticalLayout {
                            spacing: 0;
                            // Group header (Entry / Convert), shown once per group.
                            if a.group != "" && (i == 0 || root.actions[i - 1].group != a.group): Text {
                                text: a.group; color: Theme.text-faint; font-size: Theme.fs-xs; font-weight: 600;
                            }
                            // A separator above the ungrouped trailing row (Delete).
                            if a.group == "" && i > 0: Rectangle { height: 9px;
                                Rectangle { y: 4px; height: 1px; background: Theme.line; } }
                            Rectangle {
                                height: 38px;
                                background: i == root.action-selected ? Theme.bg-elevated : (acta.has-hover ? Theme.bg-panel : transparent);
                                border-radius: Theme.r-sm;
                                acta := TouchArea { clicked => { root.run-action(a.id); } }
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    VerticalLayout {
                                        alignment: center;
                                        width: 16px;
                                        ActionIcon { id: a.id; width: 16px; height: 16px; tint: a.id == "delete" ? Theme.danger : Theme.text-dim; }
                                    }
                                    Text { text: a.label; color: a.id == "delete" ? Theme.danger : Theme.text; font-size: Theme.fs-body; vertical-alignment: center; horizontal-stretch: 1; }
                                    if a.key != "": VerticalLayout {
                                        alignment: center;
                                        Keycap { text: a.key; }
                                    }
                                }
                            }
                        }
                    }
                    if root.actions.length == 0: Text {
                        text: "No matching action";
                        color: Theme.text-faint;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                    // Footer.
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout { alignment: center; Keycap { text: "↑"; } }
                        VerticalLayout { alignment: center; Keycap { text: "↓"; } }
                        VerticalLayout { alignment: center; Text { text: "Navigate"; color: Theme.text-dim; font-size: 12.5px; } }
                        VerticalLayout { alignment: center; Keycap { text: "⏎"; strong: true; } }
                        VerticalLayout { alignment: center; Text { text: "Run"; color: Theme.text-dim; font-size: 12.5px; } }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout { alignment: center; Keycap { text: "esc"; } }
                        VerticalLayout { alignment: center; Text { text: "Back"; color: Theme.text-dim; font-size: 12.5px; } }
                    }
                }
            }
        }
