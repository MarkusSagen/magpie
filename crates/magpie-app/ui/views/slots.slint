import { LineEdit, ListView, TextEdit, ScrollView } from "std-widgets.slint";
import { Theme, Pal } from "../theme.slint";
import { Icons } from "../icons.slint";
import { EntryRow, Bar, ActionItem, SlotItem, AppItem, NoteRow, BookmarkRow, JournalRow, RefRow, TaskRow, BoardColumn, GraphNode, GraphEdge, ClipRow, TimeEntryRow, SearchNoteRow, SearchTaskRow, SearchBookmarkRow } from "../types.slint";
import { TypeIcon, ActionIcon } from "../components/glyphs.slint";
import { HBar } from "../components/hbar.slint";
import { PopoverTaskRow } from "../components/task_row.slint";
import { BoardCard } from "../components/board_card.slint";

export component SlotsView inherits Rectangle {
    in property <[SlotItem]> all-slots;
    callback assign-slot(int, int);
    in property <[EntryRow]> entries;
    in-out property <string> mode;
    in-out property <int> selected;
            background: #000000aa;
            TouchArea { clicked => { root.mode = "list"; } }
            Rectangle {
                width: 420px;
                height: 420px;
                background: Theme.bg-app;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.border-strong;
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    Text { text: "Assign to slot"; color: Theme.text; font-size: 14px; font-weight: 700; }
                    Text {
                        text: "Slotted entries paste from anywhere with ⌘1–9, even when Magpie is closed. Picking a slot that already holds this entry clears it.";
                        color: Theme.text-dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    VerticalLayout {
                        spacing: 2px;
                        vertical-stretch: 1;
                        // Pack the rows at the top — stretched-apart rows leave gaps
                        // that look clickable but aren't.
                        alignment: start;
                        for s in root.all-slots: Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            background: (entries.length > 0 && root.selected < entries.length && entries[root.selected].slot == s.n)
                                ? Theme.bg-elevated : (slpta.has-hover ? Theme.bg-panel : transparent);
                            slpta := TouchArea {
                                clicked => {
                                    root.assign-slot(root.selected, s.n);
                                    root.mode = "list";
                                }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                Text { text: "⌘" + s.n; color: Pal.accent; font-size: 12px; width: 30px; vertical-alignment: center; }
                                Text {
                                    text: s.title;
                                    color: s.filled ? Theme.text : Theme.text-faint;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: (entries.length > 0 && root.selected < entries.length && entries[root.selected].slot == s.n) ? "✓" : "";
                                    color: Pal.accent;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    Text {
                        text: "1–9 Assign · Esc Cancel";
                        color: Theme.text-faint;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }
                }
            }
        }
