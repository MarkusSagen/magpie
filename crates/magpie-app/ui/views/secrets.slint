import { ListView, LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { SecretRow } from "../types.slint";
import { SecretsStore } from "../secrets_store.slint";

// Secrets vault. Top: a search box (matches key OR value). Below: a list of secrets
// (key + masked value) on the left, and the selected secret's key / value (masked with
// a reveal toggle) / notes on the right, with Reveal · Copy · Edit · Delete. State lives
// in the SecretsStore global; values are only shown in the clear when explicitly revealed.
export component SecretsView inherits Rectangle {
    // A layered root so the edit modal can overlay the list.
    VerticalLayout {
    padding: 16px;
    spacing: 12px;

    // ---- top row: search + New ----
    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            horizontal-stretch: 1;
            height: 34px;
            border-radius: Theme.r-sm;
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.line;
            HorizontalLayout {
                padding-left: 10px; padding-right: 10px; spacing: 8px;
                VerticalLayout { alignment: center;
                    Image { source: Icons.search; colorize: Theme.text-faint;
                        width: 14px; height: 14px; image-fit: contain; } }
                se := LineEdit {
                    placeholder-text: "Search secrets by key or value…";
                    text <=> SecretsStore.query;
                    edited(t) => { SecretsStore.search(t); }
                }
            }
        }
        Rectangle {
            width: 96px; height: 34px; border-radius: Theme.r-sm;
            background: nta.has-hover ? Theme.bg-elevated : Theme.accent;
            nta := TouchArea { clicked => { SecretsStore.new-secret(); } }
            Text { text: "New"; color: Theme.on-accent; font-size: Theme.fs-body;
                horizontal-alignment: center; vertical-alignment: center; }
        }
    }

    // ---- body: list + detail ----
    HorizontalLayout {
        spacing: 16px;
        vertical-stretch: 1;

        // list
        VerticalLayout {
            horizontal-stretch: 40;
            min-width: 300px;
            ListView {
                vertical-stretch: 1;
                for row[i] in SecretsStore.rows: Rectangle {
                    height: 50px;
                    border-radius: Theme.r-sm;
                    background: i == SecretsStore.selected ? Theme.bg-elevated : (rta.has-hover ? Theme.bg-elevated : transparent);
                    rta := TouchArea { clicked => { SecretsStore.select(i); } }
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 10px;
                        VerticalLayout { alignment: center;
                            Image { source: Icons.lock; colorize: Theme.text-faint;
                                width: 14px; height: 14px; image-fit: contain; } }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 1; spacing: 2px;
                            Text { text: row.key; color: Theme.text; font-size: Theme.fs-body;
                                overflow: elide; }
                            Text { text: row.value-masked; color: Theme.text-faint;
                                font-family: "Geist Mono"; font-size: Theme.fs-sm; overflow: elide; }
                        }
                    }
                }
            }
            Text { text: "Promote a clip with ⌘K → Save as secret"; color: Theme.text-faint;
                font-size: Theme.fs-xs; }
        }

        // detail
        VerticalLayout {
            horizontal-stretch: 60;
            min-width: 360px;
            spacing: 14px;
            if SecretsStore.has-selection: VerticalLayout {
                spacing: 14px;
                Text { text: SecretsStore.detail-key; color: Theme.text; font-size: 24px; font-weight: 700;
                    overflow: elide; }
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Value"; color: Theme.text-faint; font-size: Theme.fs-xs; }
                    Rectangle {
                        height: 44px; border-radius: Theme.r-sm;
                        background: Theme.bg-panel; border-width: 1px; border-color: Theme.line;
                        HorizontalLayout { padding-left: 12px; padding-right: 12px;
                            Text { text: SecretsStore.detail-value; color: Theme.text;
                                font-family: "Geist Mono"; font-size: Theme.fs-body;
                                vertical-alignment: center; overflow: elide; } }
                    }
                }
                if SecretsStore.detail-notes != "": VerticalLayout {
                    spacing: 4px;
                    Text { text: "Notes"; color: Theme.text-faint; font-size: Theme.fs-xs; }
                    Text { text: SecretsStore.detail-notes; color: Theme.text-dim;
                        font-size: Theme.fs-body; wrap: word-wrap; }
                }
                // actions
                HorizontalLayout {
                    spacing: 8px;
                    for a in [
                        { label: SecretsStore.detail-revealed ? "Hide" : "Reveal", act: "reveal" },
                        { label: "Copy", act: "copy" },
                        { label: "Edit", act: "edit" },
                        { label: "Delete", act: "delete" },
                    ]: Rectangle {
                        height: 32px; width: 92px; border-radius: Theme.r-sm;
                        background: ata.has-hover ? Theme.bg-elevated : Theme.bg-panel;
                        border-width: 1px; border-color: a.act == "delete" ? Theme.danger : Theme.line;
                        ata := TouchArea { clicked => {
                            if a.act == "reveal" { SecretsStore.reveal-selected(); }
                            if a.act == "copy" { SecretsStore.copy-selected(); }
                            if a.act == "edit" { SecretsStore.edit-selected(); }
                            if a.act == "delete" { SecretsStore.delete-selected(); }
                        } }
                        Text { text: a.label; color: a.act == "delete" ? Theme.danger : Theme.text;
                            font-size: Theme.fs-body; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle { vertical-stretch: 1; }
            }
            if !SecretsStore.has-selection: VerticalLayout {
                alignment: center;
                Text { text: "No secret selected. Press New, or promote a clip with ⌘K → Save as secret.";
                    color: Theme.text-faint; font-size: Theme.fs-body; horizontal-alignment: center; wrap: word-wrap; }
            }
        }
    }
    }

    // ---- edit / create / promote modal ----
    if SecretsStore.editing: Rectangle {
        background: #000000.with-alpha(0.5);
        TouchArea { clicked => { SecretsStore.cancel-edit(); } }
        Rectangle {
            width: 460px;
            height: content.preferred-height + 32px;
            background: Theme.bg-panel;
            border-radius: Theme.r-lg;
            border-width: 1px;
            border-color: Theme.line;
            // Swallow clicks inside the card so they don't dismiss.
            TouchArea {}
            content := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: SecretsStore.edit-id < 0 ? "Save as secret" : (SecretsStore.edit-id == 0 ? "New secret" : "Edit secret");
                    color: Theme.text; font-size: 20px; font-weight: 700; }
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Key"; color: Theme.text-faint; font-size: Theme.fs-xs; }
                    LineEdit { placeholder-text: "e.g. STRIPE_API_KEY"; text <=> SecretsStore.edit-key; }
                }
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Value"; color: Theme.text-faint; font-size: Theme.fs-xs; }
                    // For a promote (edit-id < 0) the value comes from the clip — shown read-only.
                    if SecretsStore.edit-id >= 0: LineEdit { placeholder-text: "secret value"; text <=> SecretsStore.edit-value; }
                    if SecretsStore.edit-id < 0: Rectangle {
                        height: 34px; border-radius: Theme.r-sm; background: Theme.bg-elevated;
                        border-width: 1px; border-color: Theme.line;
                        HorizontalLayout { padding-left: 10px;
                            Text { text: SecretsStore.edit-value; color: Theme.text-dim; font-family: "Geist Mono";
                                font-size: Theme.fs-sm; vertical-alignment: center; overflow: elide; } }
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Notes (optional)"; color: Theme.text-faint; font-size: Theme.fs-xs; }
                    LineEdit { placeholder-text: ""; text <=> SecretsStore.edit-notes; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 96px; height: 34px; border-radius: Theme.r-sm;
                        background: cta.has-hover ? Theme.bg-elevated : Theme.bg-panel;
                        border-width: 1px; border-color: Theme.line;
                        cta := TouchArea { clicked => { SecretsStore.cancel-edit(); } }
                        Text { text: "Cancel"; color: Theme.text; font-size: Theme.fs-body;
                            horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 96px; height: 34px; border-radius: Theme.r-sm;
                        background: sta.has-hover ? Theme.bg-elevated : Theme.accent;
                        sta := TouchArea { clicked => { SecretsStore.save-edit(); } }
                        Text { text: "Save"; color: Theme.on-accent; font-size: Theme.fs-body;
                            horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
