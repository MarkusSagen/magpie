import { LineEdit, ListView, TextEdit, ScrollView } from "std-widgets.slint";
import { Theme, Pal } from "../theme.slint";
import { Icons } from "../icons.slint";
import { EntryRow, Bar, ActionItem, SlotItem, AppItem, NoteRow, BookmarkRow, JournalRow, RefRow, TaskRow, BoardColumn, GraphNode, GraphEdge, ClipRow, TimeEntryRow, SearchNoteRow, SearchTaskRow, SearchBookmarkRow } from "../types.slint";
import { TypeIcon, ActionIcon } from "../components/glyphs.slint";
import { HBar } from "../components/hbar.slint";
import { PopoverTaskRow } from "../components/task_row.slint";
import { BoardCard } from "../components/board_card.slint";

export component AccessibilityView inherits Rectangle {
    callback dismiss-accessibility();
    in-out property <bool> needs-accessibility;
    callback open-accessibility-settings();
    callback recheck-accessibility();
            background: #000000cc;
            TouchArea {} // swallow clicks behind the modal
            Rectangle {
                width: 460px;
                height: 300px;
                background: Theme.bg-app;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.border-strong;
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Text {
                        text: "Enable auto-paste";
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Magpie needs Accessibility permission to paste into other apps (it sends ⌘V for you). Your clipboard history still works without it — you can paste manually.";
                        color: Theme.text-dim;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "1. Click “Open System Settings”.\n2. Enable Magpie under Privacy & Security ▸ Accessibility.\n3. Come back and click “I’ve enabled it”.";
                        color: Theme.text-dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            height: 34px;
                            background: openta.has-hover ? Theme.accent.brighter(0.25) : Pal.accent;
                            border-radius: 8px;
                            openta := TouchArea {
                                clicked => { root.open-accessibility-settings(); }
                            }
                            Text { text: "Open System Settings"; color: Pal.on-accent; font-size: 13px; }
                        }
                        Rectangle {
                            height: 34px;
                            width: 130px;
                            background: recheckta.has-hover ? Theme.bg-elevated : Theme.bg-panel;
                            border-radius: 8px;
                            recheckta := TouchArea {
                                clicked => { root.recheck-accessibility(); }
                            }
                            Text { text: "I’ve enabled it"; color: Theme.text; font-size: 13px; }
                        }
                    }
                    Rectangle {
                        height: 28px;
                        dismissta := TouchArea {
                            clicked => { root.dismiss-accessibility(); }
                        }
                        Text {
                            text: "Not now";
                            color: dismissta.has-hover ? Theme.text-dim : Theme.text-faint;
                            font-size: 12px;
                        }
                    }
                }
            }
        }
