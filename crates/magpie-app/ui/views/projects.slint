import { ListView } from "std-widgets.slint";
import { Theme, Pal } from "../theme.slint";
import { Icons } from "../icons.slint";
import { ProjectListRow, ProjTaskRow } from "../types.slint";
import { ProjectsStore } from "../projects_store.slint";
import { TaskListBody } from "../components/task_list.slint";
import { BoardView } from "board.slint";

// Local projects (screens 25/26): a Found-inbox + projects list (left) and the
// selected project's tasks grouped by source file (right). State lives in the
// ProjectsStore global (Rust scans the configured roots).
export component ProjectsView inherits HorizontalLayout {
    padding: 16px;
    spacing: 16px;

    // ---- list ----
    VerticalLayout {
        width: 320px;
        spacing: 10px;
        // Found · not added yet. Bounded to a scroll area — the scan can turn up
        // dozens of repos, and an unbounded list stretched the whole window.
        if ProjectsStore.found.length > 0: VerticalLayout {
            spacing: 6px;
            vertical-stretch: 0;
            Text { text: "Found · not added yet"; color: Theme.text-dim; font-size: Theme.fs-sm; font-weight: 600; }
            ListView {
                height: min(ProjectsStore.found.length * 70px, 210px);
                for f[i] in ProjectsStore.found: Rectangle {
                height: 68px;
                background: Theme.bg-panel; border-radius: Theme.r-md; border-width: 1px; border-color: Theme.line;
                HorizontalLayout {
                    padding: 10px; spacing: 8px;
                    VerticalLayout {
                        alignment: center; spacing: 2px; horizontal-stretch: 1;
                        Text { text: f.name; color: Theme.text; font-size: Theme.fs-body; font-weight: 500; overflow: elide; }
                        Text { text: f.path + "  " + f.extra; color: Theme.text-faint; font-size: Theme.fs-xs; overflow: elide; }
                    }
                    VerticalLayout { alignment: center;
                        Rectangle { width: 56px; height: 28px; border-radius: Theme.r-sm; background: Theme.bg-elevated;
                            addta := TouchArea { clicked => { ProjectsStore.add-found(i); } }
                            Text { text: "Add"; color: Theme.text; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; } } }
                    VerticalLayout { alignment: center;
                        Rectangle { width: 56px; height: 28px; border-radius: Theme.r-sm; background: igta.has-hover ? Theme.bg-elevated : transparent;
                            igta := TouchArea { clicked => { ProjectsStore.ignore-found(i); } }
                            Text { text: "Ignore"; color: Theme.text-dim; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; } } }
                }
                }
            }
        }
        Text { text: "Projects"; color: Theme.text-dim; font-size: Theme.fs-sm; font-weight: 600; }
        ListView {
            vertical-stretch: 1;
            for p[i] in ProjectsStore.projects: Rectangle {
                height: 62px;
                border-radius: Theme.r-md;
                background: i == ProjectsStore.selected ? Theme.bg-elevated : (pta.has-hover ? Theme.bg-elevated : transparent);
                border-width: p.conflict ? 1px : 0px;
                border-color: Theme.accent;
                pta := TouchArea { clicked => { ProjectsStore.select(i); } }
                VerticalLayout {
                    padding: 10px; spacing: 4px;
                    HorizontalLayout {
                        Image { source: Icons.tab-clipboard; colorize: Theme.text-faint; width: 14px; height: 14px;
                            y: 1px; image-fit: contain; }
                        Text { text: " " + p.name; color: Theme.text; font-size: Theme.fs-body; font-weight: 500;
                            vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        Text { text: p.conflict ? "1 conflict" : p.open-count; color: p.conflict ? Theme.accent : Theme.text-faint;
                            font-size: Theme.fs-sm; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: p.path; color: Theme.text-faint; font-size: Theme.fs-xs; vertical-alignment: center; overflow: elide; }
                        Text { text: p.badges; color: Theme.text-ghost; font-family: "Geist Mono"; font-size: Theme.fs-xs;
                            vertical-alignment: center; }
                    }
                }
            }
        }
        Text { text: ProjectsStore.scanning; color: Theme.text-faint; font-size: Theme.fs-xs; }
    }

    // ---- detail ----
    VerticalLayout {
        horizontal-stretch: 1;
        min-width: 0px;
        spacing: 12px;
        if ProjectsStore.has-selection: VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                spacing: 12px;
                Text { text: ProjectsStore.detail-name; color: Theme.text; font-size: 26px; font-weight: 700; vertical-alignment: center; }
                Text { text: ProjectsStore.detail-path; color: Theme.text-faint; font-size: Theme.fs-body; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Rectangle { width: 96px; height: 30px; border-radius: Theme.r-sm; background: ofta.has-hover ? Theme.bg-elevated : transparent;
                    ofta := TouchArea { clicked => { ProjectsStore.open-folder(); } }
                    Text { text: "Open folder"; color: Theme.text-dim; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; } }
            }
            // Chips.
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                for chip in [ProjectsStore.detail-branch, ProjectsStore.detail-tag, ProjectsStore.detail-tags, ProjectsStore.detail-week]: Rectangle {
                    height: 28px; background: Theme.bg-elevated; border-radius: Theme.r-sm;
                    visible: chip != "";
                    HorizontalLayout { padding-left: 10px; padding-right: 10px;
                        Text { text: chip; color: Theme.text-dim; font-size: Theme.fs-sm; vertical-alignment: center; } }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            // Sync conflict banner + Review (PNG 25). Accent outline; "Review" reveals
            // the keep-mine / keep-disk / edit choices.
            if ProjectsStore.detail-has-conflict: Rectangle {
                background: Theme.bg-panel;
                border-radius: Theme.r-md;
                border-width: 1px;
                border-color: Theme.accent;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: ProjectsStore.conflict-summary;
                            color: Theme.text;
                            font-size: Theme.fs-body;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: 84px;
                            height: 30px;
                            y: (parent.height - self.height) / 2;
                            border-radius: Theme.r-sm;
                            background: revta.has-hover ? Theme.bg-elevated : Theme.bg-app;
                            border-width: 1px;
                            border-color: Theme.line-strong;
                            revta := TouchArea { clicked => { ProjectsStore.review(); } }
                            Text { text: "Review"; color: Theme.text; font-size: Theme.fs-sm;
                                horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    if ProjectsStore.reviewing: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        for choice in [
                            { label: "Keep mine", act: "mine" },
                            { label: "Keep disk", act: "theirs" },
                            { label: "Edit merged", act: "edit" },
                        ]: Rectangle {
                            width: 108px;
                            height: 28px;
                            border-radius: Theme.r-sm;
                            background: chta.has-hover ? Theme.bg-elevated : transparent;
                            border-width: 1px;
                            border-color: Theme.line;
                            chta := TouchArea {
                                clicked => {
                                    if (choice.act == "mine") { ProjectsStore.resolve-mine(); }
                                    if (choice.act == "theirs") { ProjectsStore.resolve-theirs(); }
                                    if (choice.act == "edit") { ProjectsStore.resolve-edit(); }
                                }
                            }
                            Text { text: choice.label; color: Theme.text-dim; font-size: Theme.fs-sm;
                                horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }
            // ---- Task hub: this project's TODOs/tasks (merged note #tags +
            // on-disk file tasks), in the same List/Board views as the Tasks tab. ----
            HorizontalLayout {
                spacing: 8px;
                for tv in ["list", "board"]: Rectangle {
                    height: 30px;
                    width: 56px;
                    border-radius: 6px;
                    background: ProjectsStore.detail-view == tv ? Pal.accent : (hsw.has-hover ? Theme.bg-elevated : Theme.bg-panel);
                    hsw := TouchArea { clicked => { ProjectsStore.set-detail-view(tv); } }
                    Text {
                        text: tv == "list" ? "List" : "Board";
                        color: ProjectsStore.detail-view == tv ? Pal.on-accent : Theme.text;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if ProjectsStore.detail-view == "list": Rectangle {
                    width: 100px;
                    height: 30px;
                    border-radius: 6px;
                    background: ProjectsStore.detail-show-done ? Pal.accent : (sdta.has-hover ? Theme.bg-elevated : Theme.bg-panel);
                    sdta := TouchArea { clicked => { ProjectsStore.toggle-show-done(); } }
                    Text {
                        text: "Show done";
                        color: ProjectsStore.detail-show-done ? Pal.on-accent : Theme.text;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            if ProjectsStore.detail-view == "list": TaskListBody {
                vertical-stretch: 1;
                tasks: ProjectsStore.detail-task-rows;
                task-selected <=> ProjectsStore.detail-task-selected;
                task-edit-note <=> ProjectsStore.task-edit-note;
                task-edit-line <=> ProjectsStore.task-edit-line;
                task-edit-draft <=> ProjectsStore.task-edit-draft;
                toggle-task(a0, a1) => { ProjectsStore.task-toggle(a0, a1); }
                open-task-note(a0) => { ProjectsStore.task-open(a0); }
                toggle-bookmark(a0, a1) => { ProjectsStore.task-bookmark(a0, a1); }
                toggle-timer(a0, a1) => { ProjectsStore.task-timer(a0, a1); }
                rename-task(a0, a1, a2) => { ProjectsStore.task-rename(a0, a1, a2); }
            }
            if ProjectsStore.detail-view == "board": BoardView {
                vertical-stretch: 1;
                board: ProjectsStore.detail-board;
                board-caption: "";
                board-controls-changed() => { ProjectsStore.board-controls-changed(); }
                board-drag-active <=> ProjectsStore.board-drag-active;
                board-drag-line <=> ProjectsStore.board-drag-line;
                board-drag-note <=> ProjectsStore.board-drag-note;
                board-drag-title <=> ProjectsStore.board-drag-title;
                board-drag-x <=> ProjectsStore.board-drag-x;
                board-drag-y <=> ProjectsStore.board-drag-y;
                board-group <=> ProjectsStore.board-group;
                board-hide-done <=> ProjectsStore.board-hide-done;
                board-layout <=> ProjectsStore.board-layout;
                board-open-task(a0) => { ProjectsStore.task-open(a0); }
                board-project-filter: "";
                board-projects: [];
                board-set-status(a0, a1, a2) => { ProjectsStore.task-set-status(a0, a1, a2); }
                board-sort <=> ProjectsStore.board-sort;
            }
            if ProjectsStore.detail-view == "list" && ProjectsStore.detail-task-rows.length == 0: Text {
                text: "No tasks for this project yet. Tag a note task with #" + ProjectsStore.detail-name + " or add one to a TODO file.";
                color: Theme.text-faint;
                font-size: Theme.fs-body;
                wrap: word-wrap;
            }
            // ---- Extras: project notes + code-comment TODO/FIXME (read-only) ----
            if ProjectsStore.detail-tasks.length > 0: Rectangle {
                height: 150px;
                ListView {
                    for row[i] in ProjectsStore.detail-tasks: Rectangle {
                        height: row.is-file-header ? 34px : 32px;
                        if row.is-file-header: HorizontalLayout {
                            padding-top: 8px; spacing: 8px;
                            Image { source: Icons.act-note; colorize: Theme.text-faint; width: 13px; height: 13px; y: 10px; image-fit: contain; }
                            Text { text: row.file-label; color: Theme.text-dim; font-family: "Geist Mono"; font-size: Theme.fs-sm;
                                vertical-alignment: center; horizontal-stretch: 1; }
                            Text { text: row.sync-label; color: Theme.text-faint; font-size: Theme.fs-sm; vertical-alignment: center; }
                        }
                        if !row.is-file-header: HorizontalLayout {
                            padding-left: 10px; spacing: 10px;
                            Rectangle {
                                width: 18px; height: 18px; y: (parent.height - 18px) / 2;
                                Rectangle { width: 4px; height: 4px; border-radius: 2px; background: Theme.text-ghost; }
                            }
                            Text { text: row.title; color: Theme.text; font-size: Theme.fs-body;
                                vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Text { text: row.source; color: Theme.text-ghost; font-family: "Geist Mono"; font-size: Theme.fs-xs;
                                vertical-alignment: center; }
                            Rectangle { width: 22px; height: 22px; y: (parent.height - 22px)/2; border-radius: Theme.r-xs;
                                background: edta.has-hover ? Theme.bg-elevated : transparent;
                                Text { text: "↗"; color: Theme.text-faint; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                edta := TouchArea { clicked => { ProjectsStore.open-source(row.source); } } }
                        }
                    }
                }
            }
        }
        if !ProjectsStore.has-selection: VerticalLayout {
            alignment: center;
            Text { text: "Scanning for projects…"; color: Theme.text-faint; font-size: Theme.fs-body; horizontal-alignment: center; }
        }
    }
}
