import { LineEdit, ListView, TextEdit, ScrollView } from "std-widgets.slint";
import { Theme, Pal } from "../theme.slint";
import { Icons } from "../icons.slint";
import { ShortcutRow, Shortcuts } from "../components/shortcuts.slint";

export component HelpView inherits Rectangle {
    in-out property <string> mode;
            background: Theme.scrim;
            TouchArea { clicked => { root.mode = "list"; } }
            Rectangle {
                width: 520px;
                height: 600px;
                background: Theme.bg-app;
                border-radius: Theme.r-lg;
                border-width: 1px;
                border-color: Theme.line-strong;
                TouchArea {}  // swallow panel clicks
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Text { text: "Keyboard Shortcuts"; color: Theme.text; font-size: Theme.fs-title; font-weight: 600; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            // One list, grouped: a header prints whenever the group changes,
                            // so the sheet can never drift from `Shortcuts.rows`.
                            for row[i] in Shortcuts.rows: VerticalLayout {
                                spacing: 2px;
                                if i == 0 || Shortcuts.rows[i - 1].group != row.group: Text {
                                    text: row.group;
                                    color: Theme.text-faint;
                                    font-size: Theme.fs-xs;
                                    font-weight: 600;
                                }
                                HorizontalLayout {
                                    height: 22px;
                                    spacing: 12px;
                                    Text { text: row.desc; color: Theme.text-dim; font-size: Theme.fs-sm;
                                        vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    Text { text: row.keys; color: Theme.text; font-family: Theme.mono;
                                        font-size: Theme.fs-xs; vertical-alignment: center; horizontal-alignment: right; }
                                }
                            }
                        }
                    }
                    Text { text: "Hold ⌘ to reveal the keys on screen · Esc to close";
                        color: Theme.text-faint; font-size: Theme.fs-xs; horizontal-alignment: center; }
                }
            }
        }
