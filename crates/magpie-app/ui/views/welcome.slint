import { LineEdit, ListView, TextEdit, ScrollView } from "std-widgets.slint";
import { Theme, Pal } from "../theme.slint";
import { Icons } from "../icons.slint";
import { EntryRow, Bar, ActionItem, SlotItem, AppItem, NoteRow, BookmarkRow, JournalRow, RefRow, TaskRow, BoardColumn, GraphNode, GraphEdge, ClipRow, TimeEntryRow, SearchNoteRow, SearchTaskRow, SearchBookmarkRow } from "../types.slint";
import { TypeIcon, ActionIcon } from "../components/glyphs.slint";
import { HBar } from "../components/hbar.slint";
import { PopoverTaskRow } from "../components/task_row.slint";
import { BoardCard } from "../components/board_card.slint";

export component WelcomeView inherits Rectangle {
    callback dismiss-welcome();
    in-out property <bool> show-welcome;
        background: #000000cc;
        TouchArea { clicked => { root.dismiss-welcome(); } } // click backdrop to dismiss
        Rectangle {
            width: 460px;
            height: 340px;
            background: Theme.bg-app;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border-strong;
            // Swallow clicks on the card so they don't dismiss.
            TouchArea {}
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text { text: "Welcome to Magpie"; color: Theme.text; font-size: 20px; font-weight: 700; }
                Text {
                    text: "Your clipboard, notes, tasks, bookmarks and time — in one local-first place.";
                    color: Theme.text-dim; font-size: 13px; wrap: word-wrap;
                }
                Text { text: "Keys that matter"; color: Theme.text-dim; font-size: 11px; font-weight: 700; }
                Text { text: "⌘⇧Space — summon Magpie anywhere"; color: Theme.text; font-size: 13px; }
                Text { text: "⌘K — actions on any clipboard entry"; color: Theme.text; font-size: 13px; }
                Text { text: "Menu-bar icon — a quick popover"; color: Theme.text; font-size: 13px; }
                Text { text: "Today · Notes · Tasks · Bookmarks — the top bar"; color: Theme.text; font-size: 13px; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    Rectangle {
                        width: 130px; height: 34px; border-radius: 8px;
                        background: gsb.has-hover ? Theme.accent.brighter(0.15) : Pal.accent;
                        gsb := TouchArea { clicked => { root.dismiss-welcome(); } }
                        Text { text: "Get started"; color: Pal.on-accent; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }
