import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Keycap } from "../components/keycap.slint";
import { AnswerCard } from "../components/answer_card.slint";
import { CalcStore } from "../calc_store.slint";
import { WorldClockStore } from "../worldclock_store.slint";
import { CalcRow, ChartPoint, WorldClockRow } from "../types.slint";

// Calculator view (screens 11 + 12). History mode shows the answer card + a
// day-grouped history list; Graphs mode plots saved functions. All state is in
// the CalcStore global (set by Rust `refresh_calc` / `compute_graph`); the answer
// card is driven by the shared answer-* properties threaded from MainView.
export component CalcView inherits VerticalLayout {
    in property <bool> answer-has;
    in property <string> answer-kind;
    in property <string> answer-display;
    in property <string> answer-explanation;
    in property <[string]> answer-formats;
    in property <int> answer-format-index;

    padding: 16px;
    spacing: 12px;

    // Mode tabs: History · Graphs · World clock (screen 16).
    HorizontalLayout {
        spacing: 6px;
        for t[i] in ["History", "Graphs", "World clock"]: Rectangle {
            property <bool> active: (i == 0 && !CalcStore.graphs-open && !CalcStore.worldclock-open)
                || (i == 1 && CalcStore.graphs-open)
                || (i == 2 && CalcStore.worldclock-open);
            height: 34px;
            width: 116px;
            border-radius: Theme.r-sm;
            background: active ? Theme.bg-elevated : (mta.has-hover ? Theme.bg-elevated : transparent);
            mta := TouchArea {
                clicked => {
                    if i == 0 {
                        CalcStore.close-graphs();
                        CalcStore.close-worldclock();
                    } else if i == 1 {
                        CalcStore.close-worldclock();
                        CalcStore.graphs-open = true;
                    } else {
                        CalcStore.close-graphs();
                        CalcStore.open-worldclock();
                    }
                }
            }
            Text {
                text: t;
                color: active ? Theme.text : Theme.text-dim;
                font-size: Theme.fs-body;
                font-weight: active ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        // Add city (world-clock mode only).
        if CalcStore.worldclock-open: Rectangle {
            height: 34px;
            width: 120px;
            border-radius: Theme.r-sm;
            background: aca.has-hover ? Theme.bg-elevated : transparent;
            border-width: 1px;
            border-color: Theme.line;
            aca := TouchArea { clicked => { WorldClockStore.add-city(); } }
            HorizontalLayout {
                alignment: center; spacing: 6px;
                Text { text: "+ Add city"; color: Theme.text-dim; font-size: Theme.fs-sm; vertical-alignment: center; }
            }
        }
    }

    // ======================== WORLD CLOCK (16) =========================
    if CalcStore.worldclock-open: VerticalLayout {
        spacing: 2px;
        for row[ri] in WorldClockStore.rows: Rectangle {
            height: 54px;
            border-radius: Theme.r-sm;
            background: row.is-home ? Theme.bg-elevated : transparent;
            border-width: row.is-home ? 1px : 0px;
            border-color: Theme.accent;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px; spacing: 10px;
                // City name.
                Text { text: row.name; color: Theme.text; font-size: Theme.fs-body; font-weight: 500;
                    vertical-alignment: center; width: 116px; overflow: elide; }
                // Abbrev · offset.
                Text { text: row.abbrev + " · " + row.offset-label; color: Theme.text-dim;
                    font-family: "Geist Mono"; font-size: Theme.fs-sm; vertical-alignment: center; width: 92px; }
                // Relative to home.
                Text { text: row.rel-label; color: Theme.text-faint; font-family: "Geist Mono";
                    font-size: Theme.fs-sm; vertical-alignment: center; width: 44px; }
                // Big local time.
                Text { text: row.big-time; color: Theme.text; font-size: 20px; font-weight: 700;
                    vertical-alignment: center; width: 72px; }
                // 24-hour strip aligned to the home day.
                HorizontalLayout {
                    spacing: 1px;
                    for h[c] in row.hours: Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.r-xs;
                        background: row.shades[c] == 2 ? Theme.bg-elevated
                            : (row.shades[c] == 1 ? Theme.bg-panel : Theme.bg-sidebar);
                        border-width: c == WorldClockStore.chosen-hour ? 1px : 0px;
                        border-color: Theme.accent;
                        Text {
                            text: h;
                            color: c == WorldClockStore.chosen-hour ? Theme.text : Theme.text-faint;
                            font-size: Theme.fs-xs;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { WorldClockStore.set-hour(c); } }
                    }
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
    }

    // ============================ HISTORY (11) ============================
    if !CalcStore.graphs-open && !CalcStore.worldclock-open: VerticalLayout {
        spacing: 12px;
        // Filter tabs + Clear.
        HorizontalLayout {
            spacing: 6px;
            for t[i] in [
                { label: "All", n: CalcStore.count-all },
                { label: "Math", n: CalcStore.count-math },
                { label: "Dates", n: CalcStore.count-date },
                { label: "Graphs", n: CalcStore.count-graph },
            ]: Rectangle {
                height: 30px;
                width: 96px;
                border-radius: Theme.r-sm;
                background: i == CalcStore.tab ? Theme.bg-elevated : (tta.has-hover ? Theme.bg-elevated : transparent);
                tta := TouchArea { clicked => { CalcStore.set-tab(i); } }
                HorizontalLayout {
                    alignment: center; spacing: 6px;
                    Text { text: t.label; color: i == CalcStore.tab ? Theme.text : Theme.text-dim;
                        font-size: Theme.fs-body; vertical-alignment: center; }
                    Text { text: t.n; color: Theme.text-faint; font-size: Theme.fs-sm; vertical-alignment: center; }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout { alignment: center;
                Text { text: "Kept for 30 days"; color: Theme.text-faint; font-size: Theme.fs-xs; } }
            Rectangle {
                width: 60px; height: 30px; border-radius: Theme.r-sm;
                background: cla.has-hover ? Theme.bg-elevated : transparent;
                cla := TouchArea { clicked => { CalcStore.clear-history(); } }
                Text { text: "Clear"; color: Theme.text-dim; font-size: Theme.fs-body;
                    horizontal-alignment: center; vertical-alignment: center; }
            }
        }

        // Big answer card for the current evaluation.
        if root.answer-has || CalcStore.math-has: AnswerCard {
            kind: CalcStore.math-has ? "Math · read as " + (CalcStore.syntax-mode == 2 ? "Typst" : "LaTeX") : root.answer-kind;
            display: root.answer-display;
            explanation: root.answer-explanation;
            formats: root.answer-formats;
            format-index: root.answer-format-index;
            show-syntax-toggle: true;
            math-has: CalcStore.math-has;
            math-svg: CalcStore.math-svg;
            syntax-mode: CalcStore.syntax-mode;
            set-syntax(i) => { CalcStore.set-syntax(i); }
            copy-latex() => { CalcStore.copy-latex(); }
            copy-typst() => { CalcStore.copy-typst(); }
        }
        if !root.answer-has && !CalcStore.math-has: Rectangle {
            height: 72px;
            border-radius: Theme.r-lg;
            border-width: 1px;
            border-color: Theme.line;
            Text { text: "Type an expression, date or unit conversion in the search bar above";
                color: Theme.text-faint; font-size: Theme.fs-body;
                horizontal-alignment: center; vertical-alignment: center; }
        }

        // Day-grouped history list.
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            ListView {
                for row[i] in CalcStore.history: VerticalLayout {
                    spacing: 0;
                    if i == 0 || CalcStore.history[i - 1].group != row.group: Text {
                        text: row.group; color: Theme.text-faint; font-size: Theme.fs-xs;
                        font-weight: 600;
                    }
                    Rectangle {
                        height: 34px;
                        border-radius: Theme.r-sm;
                        background: i == CalcStore.selected ? Theme.bg-elevated : (rowta.has-hover ? Theme.bg-elevated : transparent);
                        rowta := TouchArea {
                            clicked => { CalcStore.selected = i; }
                            double-clicked => { CalcStore.reuse(i); }
                        }
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 12px;
                            spacing: 10px;
                            // Kind glyph.
                            VerticalLayout { alignment: center;
                                Text { text: row.kind == "date" ? "▦" : (row.kind == "graph" ? "⋀" : "∑");
                                    color: Theme.text-faint; font-family: "Geist Mono";
                                    font-size: Theme.fs-body; } }
                            VerticalLayout { alignment: center; horizontal-stretch: 1;
                                Text { text: row.input; color: Theme.text; font-family: "Geist Mono";
                                    font-size: Theme.fs-sm; overflow: elide; } }
                            VerticalLayout { alignment: center;
                                Text { text: row.result; color: Theme.text-dim; font-family: "Geist Mono";
                                    font-size: Theme.fs-sm; horizontal-alignment: right; } }
                            VerticalLayout { alignment: center; min-width: 44px;
                                Text { text: row.time; color: Theme.text-faint; font-size: Theme.fs-xs;
                                    horizontal-alignment: right; } }
                        }
                    }
                }
            }
        }

        // Footer.
        HorizontalLayout {
            spacing: 14px;
            VerticalLayout { alignment: center;
                Text { text: "Everything you evaluate — here or in the search bar — lands in this history";
                    color: Theme.text-faint; font-size: 12px; } }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout { alignment: center; Text { text: "Copy"; color: Theme.text; font-size: 12.5px; font-weight: 500; } }
            VerticalLayout { alignment: center; Keycap { text: "↵"; strong: true; } }
            VerticalLayout { alignment: center; Text { text: "Reuse"; color: Theme.text-dim; font-size: 12.5px; } }
            VerticalLayout { alignment: center; Keycap { text: "Tab"; } }
            VerticalLayout { alignment: center; Text { text: "Delete"; color: Theme.text-dim; font-size: 12.5px; } }
            VerticalLayout { alignment: center; Keycap { text: "⌘⌫"; } }
        }
    }

    // ============================ GRAPHS (12) ============================
    if CalcStore.graphs-open: HorizontalLayout {
        spacing: 16px;
        // Saved graphs rail.
        Rectangle {
            width: 220px;
            VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    // History / Graphs toggle.
                    Rectangle {
                        width: 90px; height: 30px; border-radius: Theme.r-sm;
                        background: hta.has-hover ? Theme.bg-elevated : transparent;
                        hta := TouchArea { clicked => { CalcStore.close-graphs(); } }
                        Text { text: "History"; color: Theme.text-dim; font-size: Theme.fs-body;
                            horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 90px; height: 30px; border-radius: Theme.r-sm;
                        background: Theme.bg-elevated;
                        Text { text: "Graphs"; color: Theme.text; font-size: Theme.fs-body;
                            horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                Text { text: "Saved graphs"; color: Theme.text-faint; font-size: Theme.fs-xs; font-weight: 600; }
                for g[i] in CalcStore.saved-graphs: Rectangle {
                    height: 44px;
                    border-radius: Theme.r-md;
                    background: gta.has-hover ? Theme.bg-elevated : transparent;
                    gta := TouchArea { clicked => { CalcStore.open-graphs(i); } }
                    VerticalLayout {
                        padding-left: 10px; padding-right: 10px; alignment: center; spacing: 1px;
                        Text { text: g.input; color: Theme.text; font-family: "Geist Mono"; font-size: Theme.fs-sm; overflow: elide; }
                        Text { text: g.group; color: Theme.text-faint; font-size: Theme.fs-xs; }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                Text { text: "Kept for 30 days"; color: Theme.text-faint; font-size: Theme.fs-xs; }
            }
        }
        // Plot + stats.
        VerticalLayout {
            spacing: 12px;
            // Function chips.
            HorizontalLayout {
                spacing: 10px; alignment: start;
                Rectangle {
                    height: 34px; border-radius: Theme.r-sm; border-width: 1px; border-color: Theme.line;
                    HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 8px;
                        Rectangle { width: 14px; height: 3px; background: Theme.accent; y: parent.height / 2; }
                        Text { text: CalcStore.graph-f; color: Theme.text; font-family: "Geist Mono";
                            font-size: Theme.fs-sm; vertical-alignment: center; } }
                }
                Rectangle {
                    height: 34px; border-radius: Theme.r-sm; border-width: 1px; border-color: Theme.line;
                    HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 8px;
                        Rectangle { width: 14px; height: 3px; background: Theme.text-faint; y: parent.height / 2; }
                        Text { text: CalcStore.graph-g; color: Theme.text; font-family: "Geist Mono";
                            font-size: Theme.fs-sm; vertical-alignment: center; } }
                }
            }
            // Canvas.
            Rectangle {
                vertical-stretch: 1;
                background: Theme.bg-panel;
                border-radius: Theme.r-md;
                border-width: 1px;
                border-color: Theme.line;
                clip: true;
                plot := Rectangle {
                    // g(x) behind (dim), f(x) in accent. Commands are in 0..1 space.
                    Path {
                        width: plot.width; height: plot.height;
                        viewbox-x: 0; viewbox-y: 0; viewbox-width: 1; viewbox-height: 1; fit: fill;
                        stroke: Theme.text-faint; stroke-width: 1.5px;
                        commands: CalcStore.graph-g-cmd;
                    }
                    Path {
                        width: plot.width; height: plot.height;
                        viewbox-x: 0; viewbox-y: 0; viewbox-width: 1; viewbox-height: 1; fit: fill;
                        stroke: Theme.accent; stroke-width: 2px;
                        commands: CalcStore.graph-f-cmd;
                    }
                    for p[i] in CalcStore.graph-intersections: Rectangle {
                        width: 10px; height: 10px; border-radius: 5px;
                        background: Theme.bg-app; border-width: 2px; border-color: Theme.text;
                        x: p.x * plot.width - 5px;
                        y: (1 - p.y) * plot.height - 5px;
                    }
                }
            }
            // Stats.
            HorizontalLayout {
                spacing: 40px;
                VerticalLayout { spacing: 4px;
                    Text { text: "Intersections"; color: Theme.text-dim; font-size: Theme.fs-xs; }
                    Text { text: CalcStore.graph-stats-intersections; color: Theme.text; font-family: "Geist Mono"; font-size: Theme.fs-sm; wrap: word-wrap; } }
                VerticalLayout { spacing: 4px;
                    Text { text: "Area f − g"; color: Theme.text-dim; font-size: Theme.fs-xs; }
                    Text { text: CalcStore.graph-stats-area; color: Theme.text; font-family: "Geist Mono"; font-size: Theme.fs-sm; } }
                VerticalLayout { spacing: 4px;
                    Text { text: "Max f in view"; color: Theme.text-dim; font-size: Theme.fs-xs; }
                    Text { text: CalcStore.graph-stats-max; color: Theme.text; font-family: "Geist Mono"; font-size: Theme.fs-sm; } }
            }
        }
    }
}
