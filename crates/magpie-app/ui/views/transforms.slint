import { Theme } from "../theme.slint";
import { Keycap } from "../components/keycap.slint";

struct TxRow { group: string, name: string, hint: string }

// ⌘T Transforms palette (screen 05): an input chip in the header, a grouped
// transform list on the left, and a live result + stats on the right. The result
// and stats are computed by the pure `transform-run` / `transform-stats` callbacks.
export component TransformsView inherits Rectangle {
    in-out property <string> mode;
    in-out property <int> transform-selected;
    in property <string> transform-input;
    pure callback transform-run(int, string) -> string;
    pure callback transform-stats(int, string) -> string;
    pure callback transform-input-summary(string) -> string;
    callback transform-action(string, int); // 0=paste, 1=copy, 2=save-as-entry

    property <[TxRow]> rows: [
        { group: "Format", name: "SQL IN clause", hint: "('a', 'b')" },
        { group: "Format", name: "Wrap and join lines", hint: "a, b" },
        { group: "Format", name: "Sort · unique · trim", hint: "" },
        { group: "Encode", name: "Base64", hint: "" },
        { group: "Encode", name: "URL encode", hint: "%20" },
        { group: "Encode", name: "HTML entities", hint: "&amp;" },
        { group: "Other", name: "Hash · SHA-256, MD5", hint: "" },
        { group: "Other", name: "Count words, lines, chars", hint: "" },
        { group: "Other", name: "QR code", hint: "" },
    ];
    property <string> result: root.transform-run(root.transform-selected, root.transform-input);
    property <string> stats: root.transform-stats(root.transform-selected, root.transform-input);

    background: Theme.scrim;
    TouchArea { clicked => { root.mode = "list"; } }
    Rectangle {
        width: 680px;
        height: 460px;
        background: Theme.bg-app;
        border-radius: Theme.r-lg;
        border-width: 1px;
        border-color: Theme.line-strong;
        TouchArea {}
        VerticalLayout {
            padding: 14px;
            spacing: 12px;
            // Header: input-preview chip + "Transform" label.
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                Rectangle {
                    height: 34px;
                    background: Theme.bg-elevated;
                    border-radius: Theme.r-sm;
                    border-width: 1px;
                    border-color: Theme.line;
                    horizontal-stretch: 1;
                    clip: true;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px;
                        Text {
                            text: root.transform-input-summary(root.transform-input);
                            color: Theme.text-dim;
                            font-family: "Geist Mono";
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text { text: "Transform"; color: Theme.text; font-size: Theme.fs-title; font-weight: 600; }
                }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 16px;
                // Left: transform list (grouped, with example hints).
                Rectangle {
                    width: 300px;
                    VerticalLayout {
                        spacing: 1px;
                        for row[i] in root.rows: VerticalLayout {
                            spacing: 1px;
                            if i == 0 || root.rows[i - 1].group != row.group: Text {
                                text: row.group; color: Theme.text-faint; font-size: Theme.fs-xs;
                                font-weight: 600;
                            }
                            Rectangle {
                                height: 32px;
                                border-radius: Theme.r-sm;
                                background: root.transform-selected == i ? Theme.bg-elevated : (txta.has-hover ? Theme.bg-elevated : transparent);
                                txta := TouchArea { clicked => { root.transform-selected = i; } }
                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 10px;
                                    spacing: 8px;
                                    Text { text: row.name; color: root.transform-selected == i ? Theme.text : Theme.text-dim;
                                        font-size: Theme.fs-body; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    if row.hint != "": Text { text: row.hint; color: Theme.text-faint;
                                        font-family: "Geist Mono"; font-size: Theme.fs-xs; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
                // Right: "Result" label + live result box + stats line.
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    Text { text: "Result"; color: Theme.text-dim; font-size: Theme.fs-xs; font-weight: 600; }
                    Rectangle {
                        background: Theme.bg-panel;
                        border-radius: Theme.r-md;
                        border-width: 1px;
                        border-color: Theme.line;
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 12px;
                            Text {
                                text: root.result;
                                color: Theme.text;
                                font-family: "Geist Mono";
                                font-size: Theme.fs-sm;
                                wrap: word-wrap;
                                vertical-stretch: 1;
                            }
                        }
                    }
                    Text { text: root.stats; color: Theme.text-faint; font-size: Theme.fs-xs; }
                }
            }
            // Footer: keycap · label pairs matching 05.
            HorizontalLayout {
                spacing: 16px;
                VerticalLayout { alignment: center; Keycap { text: "↵"; strong: true; } }
                VerticalLayout { alignment: center; Text { text: "Paste result"; color: Theme.text; font-size: 12.5px; font-weight: 500; } }
                VerticalLayout { alignment: center; Keycap { text: "⌘C"; } }
                VerticalLayout { alignment: center; Text { text: "Copy"; color: Theme.text-dim; font-size: 12.5px; } }
                VerticalLayout { alignment: center; Keycap { text: "⌥↵"; } }
                VerticalLayout { alignment: center; Text { text: "Save as new entry"; color: Theme.text-dim; font-size: 12.5px; } }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; Keycap { text: "esc"; } }
                VerticalLayout { alignment: center; Text { text: "Back"; color: Theme.text-dim; font-size: 12.5px; } }
            }
        }
    }
}
