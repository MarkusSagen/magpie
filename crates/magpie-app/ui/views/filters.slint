import { LineEdit, ListView, TextEdit, ScrollView } from "std-widgets.slint";
import { Theme, Pal } from "../theme.slint";
import { Icons } from "../icons.slint";
import { EntryRow, Bar, ActionItem, SlotItem, AppItem, NoteRow, BookmarkRow, JournalRow, RefRow, TaskRow, BoardColumn, GraphNode, GraphEdge, ClipRow, TimeEntryRow, SearchNoteRow, SearchTaskRow, SearchBookmarkRow } from "../types.slint";
import { TypeIcon, ActionIcon } from "../components/glyphs.slint";
import { HBar } from "../components/hbar.slint";
import { PopoverTaskRow } from "../components/task_row.slint";
import { BoardCard } from "../components/board_card.slint";
import { Keycap } from "../components/keycap.slint";

export component FiltersView inherits Rectangle {
    in-out property <int> app-index;
    in property <[AppItem]> apps;
    callback clear-filters();
    in-out property <string> mode;
    in-out property <bool> pinned-only;
    in-out property <int> match-index;
    callback set-app-filter(int);
    callback set-match-mode(int);
    callback set-pinned-only(bool);
    callback set-sort(int);
    callback set-time-filter(int);
    in-out property <int> sort-index;
    in-out property <int> time-index;
            background: Theme.scrim;
            TouchArea { clicked => { root.mode = "list"; } }
            // Right-anchored popover under the Filter button (screen 02).
            Rectangle {
                width: 340px;
                x: parent.width - self.width - 14px;
                y: 14px;
                height: min(640px, parent.height - 28px);
                background: Theme.bg-app;
                border-radius: Theme.r-lg;
                border-width: 1px;
                border-color: Theme.line-strong;
                TouchArea {}
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    // ---- Match ----
                    Text { text: "Match"; color: Theme.text-dim; font-size: Theme.fs-xs; font-weight: 600; }
                    Rectangle {
                        height: 34px;
                        background: Theme.bg-sidebar;
                        border-radius: Theme.r-sm;
                        HorizontalLayout {
                            padding: 3px; spacing: 2px;
                            for label[i] in ["Words", "Fuzzy", "Regex"]: Rectangle {
                                horizontal-stretch: 1;
                                border-radius: Theme.r-xs;
                                background: i == root.match-index ? Theme.bg-elevated : (mmta.has-hover ? Theme.bg-elevated : transparent);
                                mmta := TouchArea { clicked => { root.set-match-mode(i); } }
                                Text { text: label; color: i == root.match-index ? Theme.text : Theme.text-dim;
                                    font-size: Theme.fs-body; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }

                    // ---- Source app (checkbox rows + counts) ----
                    Text { text: "Source app"; color: Theme.text-dim; font-size: Theme.fs-xs; font-weight: 600; }
                    ListView {
                        vertical-stretch: 1;
                        for a in root.apps: Rectangle {
                            height: 32px;
                            border-radius: Theme.r-sm;
                            background: apta.has-hover ? Theme.bg-elevated : transparent;
                            apta := TouchArea { clicked => { root.set-app-filter(root.app-index == a.id ? -1 : a.id); } }
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 10px; spacing: 10px;
                                // Checkbox.
                                VerticalLayout { alignment: center;
                                    Rectangle {
                                        width: 16px; height: 16px; border-radius: 4px;
                                        border-width: 1.5px;
                                        border-color: root.app-index == a.id ? Theme.accent : Theme.text-faint;
                                        background: root.app-index == a.id ? Theme.accent : transparent;
                                        if root.app-index == a.id: Text { text: "✓"; color: Theme.on-accent;
                                            font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                                Text { text: a.name; color: Theme.text; font-size: Theme.fs-body;
                                    vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                Text { text: a.count; color: Theme.text-faint; font-size: Theme.fs-sm; vertical-alignment: center; }
                            }
                        }
                    }

                    // ---- Copied (time range, radio rows) ----
                    Text { text: "Copied"; color: Theme.text-dim; font-size: Theme.fs-xs; font-weight: 600; }
                    for label[i] in ["Any time", "Today", "Last 7 days", "Last 30 days"]: Rectangle {
                        height: 32px;
                        border-radius: Theme.r-sm;
                        background: i == root.time-index ? Theme.bg-elevated : (tfta.has-hover ? Theme.bg-elevated : transparent);
                        tfta := TouchArea { clicked => { root.time-index = i; root.set-time-filter(i); } }
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 10px; spacing: 10px;
                            VerticalLayout { alignment: center;
                                Rectangle {
                                    width: 16px; height: 16px; border-radius: 8px;
                                    border-width: 1.5px;
                                    border-color: i == root.time-index ? Theme.accent : Theme.text-faint;
                                    if i == root.time-index: Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; }
                                }
                            }
                            Text { text: label; color: Theme.text; font-size: Theme.fs-body; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                    }

                    // ---- Pinned only (kept — no other entry point) ----
                    Rectangle {
                        height: 32px;
                        border-radius: Theme.r-sm;
                        background: pota.has-hover ? Theme.bg-elevated : transparent;
                        pota := TouchArea { clicked => { root.pinned-only = !root.pinned-only; root.set-pinned-only(root.pinned-only); } }
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 10px; spacing: 10px;
                            VerticalLayout { alignment: center;
                                Rectangle {
                                    width: 16px; height: 16px; border-radius: 4px;
                                    border-width: 1.5px;
                                    border-color: root.pinned-only ? Theme.accent : Theme.text-faint;
                                    background: root.pinned-only ? Theme.accent : transparent;
                                    if root.pinned-only: Text { text: "✓"; color: Theme.on-accent; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            Text { text: "Pinned only"; color: Theme.text; font-size: Theme.fs-body; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                    }

                    // ---- Footer ----
                    Rectangle { height: 1px; background: Theme.line; }
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout { alignment: center; Keycap { text: "↑"; } }
                        VerticalLayout { alignment: center; Keycap { text: "↓"; } }
                        VerticalLayout { alignment: center; Text { text: "Move"; color: Theme.text-dim; font-size: 12px; } }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            height: 26px; width: 78px; border-radius: Theme.r-sm;
                            background: cfta.has-hover ? Theme.bg-elevated : transparent;
                            cfta := TouchArea { clicked => { root.clear-filters(); } }
                            Text { text: "Clear all"; color: Theme.text-dim; font-size: 12.5px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
