import { LineEdit, ListView, TextEdit, ScrollView } from "std-widgets.slint";
import { Theme, Pal } from "../theme.slint";
import { Icons } from "../icons.slint";
import { EntryRow, Bar, ActionItem, SlotItem, AppItem, NoteRow, BookmarkRow, JournalRow, RefRow, TaskRow, BoardColumn, GraphNode, GraphEdge, ClipRow, TimeEntryRow, SearchNoteRow, SearchTaskRow, SearchBookmarkRow } from "../types.slint";
import { TypeIcon, ActionIcon } from "../components/glyphs.slint";
import { HBar } from "../components/hbar.slint";
import { PopoverTaskRow } from "../components/task_row.slint";
import { BoardCard } from "../components/board_card.slint";

export component FindView inherits Rectangle {
    callback focus-search();
    callback close-search();
    callback open-search-bookmark(string);
    callback open-search-note(int);
    callback open-search-task(int);
    callback run-unified-search(string);
    in property <[SearchBookmarkRow]> search-bookmarks;
    in-out property <bool> search-mode;
    in property <[SearchNoteRow]> search-notes;
    in-out property <string> search-query;
    in property <[SearchTaskRow]> search-tasks;
            background: Theme.bg-app;
            VerticalLayout {
                padding: 8px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 92px; height: 30px; border-radius: 6px;
                        background: sback.has-hover ? Theme.bg-elevated : Theme.bg-panel;
                        sback := TouchArea { clicked => { root.close-search(); } }
                        Text { text: "← Clipboard"; color: Theme.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "Find everywhere"; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle {
                    height: 30px; background: Theme.bg-panel; border-radius: 6px;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        if root.search-query == "": Text { text: "Find in notes, tasks, bookmarks…"; color: Theme.text-faint; font-size: 13px; vertical-alignment: center; }
                        sq := TextInput {
                            text <=> root.search-query;
                            color: Theme.text; font-size: 13px; single-line: true; vertical-alignment: center;
                            init => { self.focus(); }
                            edited => { root.run-unified-search(self.text); }
                            accepted => { root.run-unified-search(self.text); }
                            key-pressed(e) => {
                                if e.text == Key.Escape {
                                    root.close-search();
                                    root.focus-search();
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;

                        Text { text: "Notes"; color: Theme.text-dim; font-size: 11px; font-weight: 700; }
                        for n in root.search-notes: Rectangle {
                            height: 34px;
                            background: snrow.has-hover ? Theme.bg-elevated : transparent;
                            border-radius: 6px;
                            snrow := TouchArea { clicked => { root.open-search-note(n.id); } }
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 8px;
                                Image { source: Icons.tab-notes; colorize: Theme.text-dim; width: 13px; height: 13px; image-fit: contain; }
                                Text { text: n.title; color: Theme.text; font-size: 13px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                            }
                        }
                        if root.search-notes.length == 0: Text { text: "—"; color: Theme.text-faint; font-size: 12px; }

                        Text { text: "Tasks"; color: Theme.text-dim; font-size: 11px; font-weight: 700; }
                        for t in root.search-tasks: Rectangle {
                            height: 34px;
                            background: strow.has-hover ? Theme.bg-elevated : transparent;
                            border-radius: 6px;
                            strow := TouchArea { clicked => { root.open-search-task(t.id); } }
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 8px;
                                Image { source: Icons.tab-tasks; colorize: Theme.text-dim; width: 13px; height: 13px; image-fit: contain; }
                                Text { text: t.title; color: Theme.text; font-size: 13px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                            }
                        }
                        if root.search-tasks.length == 0: Text { text: "—"; color: Theme.text-faint; font-size: 12px; }

                        Text { text: "Bookmarks"; color: Theme.text-dim; font-size: 11px; font-weight: 700; }
                        for b in root.search-bookmarks: Rectangle {
                            height: 34px;
                            background: sbrow.has-hover ? Theme.bg-elevated : transparent;
                            border-radius: 6px;
                            sbrow := TouchArea { clicked => { root.open-search-bookmark(b.url); } }
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 8px;
                                Image { source: Icons.bookmark; colorize: Theme.text-dim; width: 13px; height: 13px; image-fit: contain; }
                                Text { text: b.title; color: Theme.text; font-size: 13px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                            }
                        }
                        if root.search-bookmarks.length == 0: Text { text: "—"; color: Theme.text-faint; font-size: 12px; }
                    }
                }
            }
        }
