import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { SearchNoteRow, SearchTaskRow, SearchBookmarkRow, FavoriteRow } from "../types.slint";
import { SearchBar } from "../components/search_bar.slint";
import { Keycap } from "../components/keycap.slint";

// A group label (Favorites / Notes / Tasks / Bookmarks).
component GroupLabel inherits Text {
    color: Theme.text-faint;
    font-size: Theme.fs-xs;
    font-weight: 600;
}

// One result row: icon (or glyph) · title · faint type hint. Selection = bg-elevated.
component FindRow inherits Rectangle {
    in property <image> icon;
    in property <string> glyph;          // used when non-empty (favorites)
    in property <string> title;
    in property <string> hint;
    in property <bool> selected;
    callback clicked();
    height: 34px;
    border-radius: Theme.r-sm;
    background: root.selected || ta.has-hover ? Theme.bg-elevated : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 10px;
        if root.glyph != "": VerticalLayout { alignment: center;
            Text { text: root.glyph; color: Theme.text-faint; font-size: 12px; width: 14px;
                horizontal-alignment: center; } }
        if root.glyph == "": VerticalLayout { alignment: center;
            Image { source: root.icon; colorize: Theme.text-faint; width: 14px; height: 14px; image-fit: contain; } }
        Text { text: root.title; color: root.selected ? Theme.text : Theme.text-dim; font-size: Theme.fs-body;
            overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
        if root.hint != "": Text { text: root.hint; color: Theme.text-ghost; font-family: Theme.mono;
            font-size: Theme.fs-xs; vertical-alignment: center; }
    }
}

// ⌘⇧F Find everywhere: unified search over notes / tasks / bookmarks, with Favorites
// on top while the query is empty. Graphite skeleton: shared SearchBar · grouped rows
// (one flat ↑↓ selection) · bottom bar with keycaps.
export component FindView inherits Rectangle {
    callback focus-search();
    callback close-search();
    callback open-search-bookmark(string);
    callback open-search-note(int);
    callback open-search-task(int);
    callback run-unified-search(string);
    in property <[SearchBookmarkRow]> search-bookmarks;
    in-out property <bool> search-mode;
    in property <[SearchNoteRow]> search-notes;
    in-out property <string> search-query;
    in property <[SearchTaskRow]> search-tasks;
    // Shown at the top while the query is empty (same model as the sidebar group).
    in property <[FavoriteRow]> favorites;
    callback activate-favorite(int);

    // Flat selection across the visible groups.
    property <int> sel: 0;
    property <bool> empty-query: root.search-query == "";
    property <int> n-notes: root.search-notes.length;
    property <int> n-tasks: root.search-tasks.length;
    property <int> total: root.empty-query ? root.favorites.length
        : root.n-notes + root.n-tasks + root.search-bookmarks.length;
    changed search-query => { root.sel = 0; }

    function close() {
        root.close-search();
        root.focus-search();
    }
    function open-selected() {
        if root.total == 0 { return; }
        if root.empty-query {
            root.close-search();
            root.activate-favorite(root.favorites[root.sel].id);
        } else if root.sel < root.n-notes {
            root.open-search-note(root.search-notes[root.sel].id);
        } else if root.sel < root.n-notes + root.n-tasks {
            root.open-search-task(root.search-tasks[root.sel - root.n-notes].id);
        } else {
            root.open-search-bookmark(root.search-bookmarks[root.sel - root.n-notes - root.n-tasks].url);
        }
    }

    background: Theme.bg-app;
    TouchArea {}  // swallow clicks behind the panel
    VerticalLayout {
        bar := SearchBar {
            placeholder: "Find in notes, tasks, bookmarks…";
            text <=> root.search-query;
            capture-arrows: true;
            init => { self.focus-input(); }
            edited(t) => { root.run-unified-search(t); }
            submit => { root.open-selected(); }
            dismiss => { root.close(); }
            move(d) => {
                if root.total > 0 {
                    root.sel = Math.max(0, Math.min(root.total - 1, root.sel + d));
                }
            }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 16px;
                spacing: 4px;
                alignment: start;

                // Empty query: favorites, then a hint.
                if root.empty-query && root.favorites.length > 0: GroupLabel { text: "Favorites"; }
                if root.empty-query: VerticalLayout {
                    spacing: 2px;
                    alignment: start;
                    for f[i] in root.favorites: FindRow {
                        glyph: f.kind == "quicklink" || f.kind == "bookmark" ? "↗" : (f.kind == "note" ? "◇" : (f.kind == "search" ? "⌕" : "★"));
                        title: f.label;
                        hint: f.keyword;
                        selected: root.sel == i;
                        clicked => { root.sel = i; root.open-selected(); }
                    }
                    Rectangle { height: 8px; }
                    Text { text: "Type to search notes, tasks and bookmarks";
                        color: Theme.text-faint; font-size: Theme.fs-sm; }
                }

                if !root.empty-query: VerticalLayout {
                    spacing: 2px;
                    alignment: start;
                    if root.n-notes > 0: GroupLabel { text: "Notes"; }
                    for n[i] in root.search-notes: FindRow {
                        icon: Icons.tab-notes; title: n.title; hint: "note";
                        selected: root.sel == i;
                        clicked => { root.sel = i; root.open-selected(); }
                    }
                    if root.n-tasks > 0: Rectangle { height: 8px; }
                    if root.n-tasks > 0: GroupLabel { text: "Tasks"; }
                    for t[i] in root.search-tasks: FindRow {
                        icon: Icons.tab-tasks; title: t.title; hint: "task";
                        selected: root.sel == root.n-notes + i;
                        clicked => { root.sel = root.n-notes + i; root.open-selected(); }
                    }
                    if root.search-bookmarks.length > 0: Rectangle { height: 8px; }
                    if root.search-bookmarks.length > 0: GroupLabel { text: "Bookmarks"; }
                    for b[i] in root.search-bookmarks: FindRow {
                        icon: Icons.bookmark; title: b.title; hint: "bookmark";
                        selected: root.sel == root.n-notes + root.n-tasks + i;
                        clicked => { root.sel = root.n-notes + root.n-tasks + i; root.open-selected(); }
                    }
                    if root.total == 0: Text { text: "No matches in notes, tasks or bookmarks";
                        color: Theme.text-faint; font-size: Theme.fs-sm; }
                }
            }
        }
        // Bottom bar.
        Rectangle {
            height: 40px;
            Rectangle { y: 0; height: 1px; background: Theme.line; }
            HorizontalLayout {
                padding-left: 16px; padding-right: 8px; spacing: 14px;
                VerticalLayout { alignment: center;
                    Text { text: "Find everywhere"; color: Theme.text-faint; font-size: 12px; } }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; Text { text: "Open"; color: Theme.text; font-size: 12.5px; font-weight: 500; } }
                VerticalLayout { alignment: center; Keycap { text: "⏎"; strong: true; } }
                VerticalLayout { alignment: center; Rectangle { width: 1px; height: 14px; background: Theme.line-strong; } }
                VerticalLayout { alignment: center; Text { text: "Move"; color: Theme.text-dim; font-size: 12.5px; } }
                VerticalLayout { alignment: center; Keycap { text: "↑↓"; } }
                VerticalLayout { alignment: center; Rectangle { width: 1px; height: 14px; background: Theme.line-strong; } }
                VerticalLayout { alignment: center; Text { text: "Back"; color: Theme.text-dim; font-size: 12.5px; } }
                VerticalLayout { alignment: center; Keycap { text: "esc"; } }
            }
        }
    }
}
