import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Keycap } from "../components/keycap.slint";
import { TimeRow, TimeProjectBar } from "../types.slint";
import { TimeStore } from "../time_store.slint";

// Time tracking v2 (screen 24): entries grouped by day (left) + a Pomodoro ring
// and a This-week per-project card (right). Builds on the existing time_entries +
// org CLOCK logging. State lives in the TimeStore global.
export component TimeView inherits VerticalLayout {
    spacing: 12px;

    // 1 Hz tick that drives the Pomodoro countdown + running-elapsed while active.
    Timer {
        interval: 1s;
        running: TimeStore.pomo-running || TimeStore.running;
        triggered => { TimeStore.pomo-tick(); }
    }

    // Running-timer bar.
    if TimeStore.running: Rectangle {
        height: 44px;
        background: Theme.bg-panel;
        border-radius: Theme.r-md;
        border-width: 1px;
        border-color: Theme.line;
        HorizontalLayout {
            padding-left: 12px; padding-right: 8px; spacing: 10px;
            Rectangle { width: 8px; height: 8px; y: (parent.height - 8px) / 2; border-radius: 4px; background: Theme.accent; }
            Text { text: TimeStore.running-desc; color: Theme.text; font-size: Theme.fs-body; font-weight: 500;
                vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            if TimeStore.running-project != "": Rectangle {
                background: Theme.bg-elevated; border-radius: Theme.r-sm; height: 26px; y: (parent.height - 26px) / 2;
                HorizontalLayout { padding-left: 8px; padding-right: 8px;
                    Text { text: TimeStore.running-project; color: Theme.text-dim; font-size: Theme.fs-sm; vertical-alignment: center; } } }
            Text { text: TimeStore.running-elapsed; color: Theme.text; font-family: Theme.mono; font-size: 20px;
                font-weight: 700; vertical-alignment: center; }
            Rectangle {
                width: 84px; height: 30px; y: (parent.height - 30px) / 2; border-radius: Theme.r-sm;
                border-width: 1px; border-color: Theme.accent;
                stbt := TouchArea { clicked => { TimeStore.stop-timer(); } }
                HorizontalLayout { alignment: center; spacing: 6px;
                    Rectangle { width: 9px; height: 9px; y: (parent.height - 9px)/2; background: Theme.text; }
                    Text { text: "Stop"; color: Theme.text; font-size: Theme.fs-sm; vertical-alignment: center; } }
            }
        }
    }

    HorizontalLayout {
        spacing: 16px;
        vertical-stretch: 1;

        // ---- entries ----
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 4px;
            // Idle prompt: never edits time on its own — the user decides.
            if TimeStore.idle-pending: Rectangle {
                height: 44px;
                background: Theme.bg-panel;
                border-radius: Theme.r-sm;
                border-width: 1px;
                border-color: Theme.line-strong;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 8px; spacing: 8px;
                    Text { text: TimeStore.idle-label; color: Theme.text; font-size: Theme.fs-body;
                        vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    Rectangle { width: 64px; height: 28px; y: (parent.height - 28px) / 2; border-radius: Theme.r-sm;
                        background: ikta.has-hover ? Theme.bg-elevated : transparent;
                        ikta := TouchArea { clicked => { TimeStore.idle-keep(); } }
                        Text { text: "Keep"; color: Theme.text-dim; font-size: Theme.fs-sm;
                            horizontal-alignment: center; vertical-alignment: center; } }
                    Rectangle { width: 108px; height: 28px; y: (parent.height - 28px) / 2; border-radius: Theme.r-sm;
                        border-width: 1px; border-color: Theme.line-strong;
                        background: idta.has-hover ? Theme.bg-elevated : transparent;
                        idta := TouchArea { clicked => { TimeStore.idle-discard(); } }
                        Text { text: "Discard idle"; color: Theme.text; font-size: Theme.fs-sm;
                            horizontal-alignment: center; vertical-alignment: center; } }
                }
            }
            // Quick-add (Add entry / ⌘N). ⏎ adds, Esc cancels.
            if TimeStore.adding: VerticalLayout {
                spacing: 4px;
                Rectangle {
                    height: 38px;
                    background: Theme.bg-panel;
                    border-radius: Theme.r-sm;
                    border-width: 1px;
                    border-color: Theme.line-strong;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 10px; spacing: 10px;
                        Rectangle {
                            horizontal-stretch: 1;
                            if addin.text == "": Text { text: "What + when — e.g. Review PR #magpie 45m · Standup 9:00-9:15 · yesterday 14:00-15:30";
                                color: Theme.text-faint; font-size: Theme.fs-body; vertical-alignment: center; overflow: elide; width: 100%; height: 100%; }
                            addin := TextInput {
                                width: 100%; height: 100%;
                                text <=> TimeStore.add-draft;
                                color: Theme.text; font-size: Theme.fs-body;
                                single-line: true; vertical-alignment: center;
                                init => { self.focus(); }
                                edited => { TimeStore.add-error = ""; }
                                key-pressed(e) => {
                                    if e.text == Key.Return { TimeStore.submit-entry(self.text); return accept; }
                                    if e.text == Key.Escape { TimeStore.adding = false; TimeStore.editing-id = 0; TimeStore.add-error = ""; return accept; }
                                    return reject;
                                }
                            }
                        }
                        if TimeStore.editing-id > 0: VerticalLayout { alignment: center;
                            Text { text: "Editing"; color: Theme.text-faint; font-size: Theme.fs-sm; } }
                        VerticalLayout { alignment: center; Keycap { text: "⏎"; strong: true; } }
                        VerticalLayout { alignment: center; Keycap { text: "esc"; } }
                    }
                }
                if TimeStore.add-error != "": Text { text: TimeStore.add-error; color: Theme.text-dim; font-size: Theme.fs-sm; }
            }
            ListView {
                vertical-stretch: 1;
                for row[i] in TimeStore.rows: Rectangle {
                    height: row.is-day-header ? 34px : 44px;
                    background: (!row.is-day-header && row.running) ? Theme.bg-elevated : transparent;
                    border-radius: Theme.r-sm;
                    if row.is-day-header: HorizontalLayout {
                        padding-left: 4px; padding-right: 8px;
                        Text { text: row.day-label; color: Theme.text-dim; font-size: Theme.fs-sm; font-weight: 600;
                            vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: row.day-total; color: Theme.text-faint; font-family: Theme.mono; font-size: Theme.fs-sm;
                            vertical-alignment: center; }
                    }
                    if !row.is-day-header: HorizontalLayout {
                        padding-left: 12px; padding-right: 10px; spacing: 10px;
                        Text { text: row.desc; color: Theme.text; font-size: Theme.fs-body; vertical-alignment: center;
                            overflow: elide; horizontal-stretch: 1; }
                        if row.project != "": Text { text: row.project; color: Theme.text-faint; font-size: Theme.fs-sm; vertical-alignment: center; }
                        if row.tag != "": Text { text: row.tag; color: Theme.text-faint; font-size: Theme.fs-sm; vertical-alignment: center; }
                        Text { text: row.span; color: Theme.text-faint; font-family: Theme.mono; font-size: Theme.fs-sm; vertical-alignment: center; }
                        Text { text: row.duration; color: Theme.text; font-family: Theme.mono; font-size: Theme.fs-body;
                            vertical-alignment: center; width: 84px; horizontal-alignment: right; }
                        Rectangle { width: 24px; height: 24px; y: (parent.height - 24px)/2; border-radius: Theme.r-xs;
                            background: cbt.has-hover ? Theme.bg-elevated : transparent;
                            Text { text: "▶"; color: Theme.text-faint; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            cbt := TouchArea { clicked => { TimeStore.continue-row(i); } } }
                        // Edit (finished entries only).
                        Rectangle { width: 24px; height: 24px; y: (parent.height - 24px)/2; border-radius: Theme.r-xs;
                            background: edt.has-hover ? Theme.bg-elevated : transparent;
                            Text { text: row.running ? "" : "✎"; color: edt.has-hover ? Theme.text-dim : Theme.text-ghost;
                                font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                            edt := TouchArea { enabled: !row.running; clicked => { TimeStore.edit-entry(row.id); } } }
                        // Delete (finished entries only — Stop a running one first).
                        Rectangle { width: 24px; height: 24px; y: (parent.height - 24px)/2; border-radius: Theme.r-xs;
                            background: dlt.has-hover ? Theme.bg-elevated : transparent;
                            Text { text: row.running ? "" : "×"; color: dlt.has-hover ? Theme.text-dim : Theme.text-ghost;
                                font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                            dlt := TouchArea { enabled: !row.running; clicked => { TimeStore.delete-entry(row.id); } } }
                    }
                }
            }
            // Actions.
            HorizontalLayout {
                spacing: 16px;
                Text { text: "Every entry is also written to its note as an org CLOCK line";
                    color: Theme.text-faint; font-size: Theme.fs-xs; vertical-alignment: center; horizontal-stretch: 1; }
                Rectangle { height: 28px; width: 96px; border-radius: Theme.r-sm; background: cla.has-hover ? Theme.bg-elevated : transparent;
                    cla := TouchArea { clicked => { TimeStore.continue-last(); } }
                    Text { text: "Continue"; color: Theme.text-dim; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; } }
                Rectangle { height: 28px; width: 116px; border-radius: Theme.r-sm; background: aea.has-hover ? Theme.bg-elevated : transparent;
                    aea := TouchArea { clicked => { TimeStore.editing-id = 0; TimeStore.add-draft = ""; TimeStore.adding = true; TimeStore.add-error = ""; } }
                    HorizontalLayout { alignment: center; spacing: 6px;
                        Text { text: "Add entry"; color: Theme.text-dim; font-size: Theme.fs-sm; vertical-alignment: center; }
                        VerticalLayout { alignment: center; Keycap { text: "⌘N"; } } } }
                Rectangle { height: 28px; width: 96px; border-radius: Theme.r-sm; background: eca.has-hover ? Theme.bg-elevated : transparent;
                    eca := TouchArea { clicked => { TimeStore.export-csv(); } }
                    Text { text: "Export CSV"; color: Theme.text-dim; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; } }
                Rectangle { height: 28px; width: 80px; border-radius: Theme.r-sm; background: rea.has-hover ? Theme.bg-elevated : transparent;
                    rea := TouchArea { clicked => { TimeStore.report(); } }
                    Text { text: "Report"; color: Theme.text-dim; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; } }
            }
        }

        // ---- right column: pomodoro + this week ----
        VerticalLayout {
            width: 340px;
            spacing: 12px;

            // Pomodoro card.
            Rectangle {
                background: Theme.bg-panel; border-radius: Theme.r-lg; border-width: 1px; border-color: Theme.line;
                height: 350px;  // + the auto-continue row
                VerticalLayout {
                    padding: 18px; spacing: 10px;
                    HorizontalLayout {
                        Text { text: "Pomodoro"; color: Theme.text; font-size: Theme.fs-body; font-weight: 600;
                            vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: "25 / 5 · long break 15"; color: Theme.text-faint; font-size: Theme.fs-xs; vertical-alignment: center; }
                    }
                    // Ring: an accent arc over a track. `pomo-progress` drives the arc via
                    // a conic-ish approximation (two half-rings would need Path; keep a
                    // simple radial track + a big remaining readout).
                    Rectangle {
                        height: 180px;
                        Rectangle {
                            width: 168px; height: 168px; x: (parent.width - 168px) / 2;
                            border-radius: 84px; border-width: 10px;
                            border-color: Theme.bg-elevated;
                        }
                        // Progress ring (accent) — width grows with progress as a simple bar
                        // beneath the readout; a full arc needs Path (deferred).
                        VerticalLayout {
                            alignment: center;
                            Text { text: TimeStore.pomo-remaining; color: Theme.text; font-size: 40px; font-weight: 700;
                                horizontal-alignment: center; }
                            Text { text: (TimeStore.pomo-phase == 0 ? "Focus" : (TimeStore.pomo-phase == 1 ? "Break" : "Long break"))
                                    + " · " + TimeStore.pomo-cycle + " of " + TimeStore.pomo-cycles-total;
                                color: Theme.text-dim; font-size: Theme.fs-sm; horizontal-alignment: center; }
                        }
                    }
                    // Progress bar under the readout.
                    Rectangle {
                        height: 4px; background: Theme.bg-elevated; border-radius: 2px;
                        Rectangle { x: 0; width: parent.width * TimeStore.pomo-progress; height: parent.height;
                            border-radius: 2px; background: Theme.accent; }
                    }
                    // Cycle dots.
                    HorizontalLayout {
                        alignment: center; spacing: 8px;
                        for d in [1, 2, 3, 4]: Rectangle {
                            width: 8px; height: 8px; border-radius: 4px;
                            background: d <= TimeStore.pomo-cycle ? Theme.accent : Theme.bg-elevated;
                        }
                    }
                    HorizontalLayout {
                        alignment: center; spacing: 10px;
                        Rectangle { width: 96px; height: 32px; border-radius: Theme.r-sm; border-width: 1px; border-color: Theme.line;
                            background: pta.has-hover ? Theme.bg-elevated : transparent;
                            pta := TouchArea { clicked => { TimeStore.pomo-toggle(); } }
                            Text { text: TimeStore.pomo-running ? "Pause" : "Start"; color: Theme.text; font-size: Theme.fs-sm;
                                horizontal-alignment: center; vertical-alignment: center; } }
                        Rectangle { width: 96px; height: 32px; border-radius: Theme.r-sm;
                            background: ska.has-hover ? Theme.bg-elevated : transparent;
                            ska := TouchArea { clicked => { TimeStore.pomo-skip(); } }
                            Text { text: "Skip"; color: Theme.text-dim; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; } }
                    }
                    // Auto-continue: roll into the next phase, or pause at each phase end.
                    Rectangle {
                        height: 24px;
                        acta := TouchArea { clicked => { TimeStore.set-pomo-auto(!TimeStore.pomo-auto); } }
                        HorizontalLayout {
                            alignment: center; spacing: 8px;
                            Rectangle { width: 14px; height: 14px; y: (parent.height - 14px) / 2; border-radius: 4px;
                                border-width: 1.5px; border-color: TimeStore.pomo-auto ? Theme.text-dim : Theme.line-strong;
                                background: TimeStore.pomo-auto ? Theme.bg-elevated : transparent;
                                Text { text: TimeStore.pomo-auto ? "✓" : ""; color: Theme.text; font-size: 10px;
                                    horizontal-alignment: center; vertical-alignment: center; } }
                            Text { text: "Auto-continue to the next phase"; color: acta.has-hover ? Theme.text : Theme.text-dim;
                                font-size: Theme.fs-sm; vertical-alignment: center; }
                        }
                    }
                }
            }

            // This week card.
            Rectangle {
                background: Theme.bg-panel; border-radius: Theme.r-lg; border-width: 1px; border-color: Theme.line;
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 18px; spacing: 12px;
                    HorizontalLayout {
                        Text { text: "This week"; color: Theme.text; font-size: Theme.fs-body; font-weight: 600;
                            vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: TimeStore.week-total; color: Theme.text-dim; font-family: Theme.mono; font-size: Theme.fs-sm; vertical-alignment: center; }
                    }
                    for p[i] in TimeStore.week-projects: VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            Text { text: p.name; color: p.accent ? Theme.text : Theme.text-dim; font-size: Theme.fs-body;
                                vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Text { text: p.total; color: Theme.text-dim; font-family: Theme.mono; font-size: Theme.fs-sm; vertical-alignment: center; }
                        }
                        Rectangle {
                            height: 4px; background: Theme.bg-elevated; border-radius: 2px;
                            Rectangle { x: 0; width: parent.width * p.bar; height: parent.height; border-radius: 2px;
                                background: p.accent ? Theme.accent : Theme.line-strong; }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }
}
