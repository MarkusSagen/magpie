// Custom monochrome line icons (replace emoji glyphs). Each is a single-colour SVG
// tinted at the use-site via `Image.colorize`, so one file serves every state.
export global Icons {
    out property <image> tab-tasks: @image-url("../../../assets/icons/tab-tasks.svg");
    out property <image> tab-today: @image-url("../../../assets/icons/tab-today.svg");
    out property <image> tab-daily: @image-url("../../../assets/icons/tab-daily.svg");
    out property <image> tab-clipboard: @image-url("../../../assets/icons/tab-clipboard.svg");
    out property <image> tab-notes: @image-url("../../../assets/icons/tab-notes.svg");
    out property <image> tab-stats: @image-url("../../../assets/icons/tab-stats.svg");
    out property <image> type-text: @image-url("../../../assets/icons/type-text.svg");
    out property <image> type-link: @image-url("../../../assets/icons/type-link.svg");
    out property <image> type-color: @image-url("../../../assets/icons/type-color.svg");
    out property <image> type-email: @image-url("../../../assets/icons/type-email.svg");
    out property <image> type-image: @image-url("../../../assets/icons/type-image.svg");
    out property <image> type-file: @image-url("../../../assets/icons/type-file.svg");
    out property <image> act-paste: @image-url("../../../assets/icons/act-paste.svg");
    out property <image> act-copy: @image-url("../../../assets/icons/act-copy.svg");
    out property <image> act-keep: @image-url("../../../assets/icons/act-keep.svg");
    out property <image> act-edit: @image-url("../../../assets/icons/act-edit.svg");
    out property <image> act-snippet: @image-url("../../../assets/icons/act-snippet.svg");
    out property <image> act-pin: @image-url("../../../assets/icons/act-pin.svg");
    out property <image> act-slot: @image-url("../../../assets/icons/act-slot.svg");
    out property <image> act-merge: @image-url("../../../assets/icons/act-merge.svg");
    out property <image> act-note: @image-url("../../../assets/icons/act-note.svg");
    out property <image> act-delete: @image-url("../../../assets/icons/act-delete.svg");
    out property <image> act-export: @image-url("../../../assets/icons/act-export.svg");
    out property <image> lock: @image-url("../../../assets/icons/icon-lock.svg");
    out property <image> bookmark: @image-url("../../../assets/icons/icon-bookmark.svg");
    out property <image> search: @image-url("../../../assets/icons/icon-search.svg");
    out property <image> theme: @image-url("../../../assets/icons/icon-theme.svg");
}
