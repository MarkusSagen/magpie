import { SecretRow } from "types.slint";

// Secrets vault view state. A global so Rust builds the list + detail and the view
// reads it directly (mirrors SnippetsStore / DataStore). Values are masked unless the
// row's `revealed` flag is set (per-row reveal, toggled through `reveal-selected`).
export global SecretsStore {
    in-out property <[SecretRow]> rows;
    in-out property <string> query;
    in-out property <int> selected;        // index into `rows`
    in-out property <bool> has-selection;
    // Detail of the selected secret.
    in-out property <string> detail-key;
    in-out property <string> detail-value;   // masked or revealed per detail-revealed
    in-out property <string> detail-notes;
    in-out property <bool> detail-revealed;
    // Edit/create/promote modal. `edit-id`: 0 = create new, >0 = edit that secret,
    // <0 = promote the clipboard entry with id (-edit-id) — value comes from the clip.
    in-out property <bool> editing;
    in-out property <int> edit-id;
    in-out property <string> edit-key;
    in-out property <string> edit-value;
    in-out property <string> edit-notes;
    callback search(string);
    callback select(int);
    callback copy-selected();      // copy the real value to the clipboard
    callback reveal-selected();    // toggle reveal on the selected secret
    callback new-secret();
    callback edit-selected();
    callback delete-selected();
    callback save-edit();
    callback cancel-edit();
}
