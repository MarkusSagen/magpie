import { Palette } from "types.slint";

export global Theme {
    // Selected palette index (wired from the root's `theme-index`; a global
    // can't read the root directly). Kept in range even if pushed a bad value.
    in property <int> index: 0;
    out property <Palette> p: palettes[
        Math.min(Math.max(index, 0), palettes.length - 1)];
    // Re-exported tokens — views read only `Theme.*`.
    out property <bool> dark: p.dark;
    out property <color> bg-sidebar: p.bg-sidebar;
    out property <color> bg-app: p.bg-app;
    out property <color> bg-panel: p.bg-panel;
    out property <color> bg-elevated: p.bg-elevated;
    // Derived: a hair lighter than bg-elevated (selected row in a popover, tiles).
    out property <color> bg-elevated-2: p.bg-elevated.mix(p.line-strong, 0.5);
    out property <color> line: p.line;
    out property <color> line-strong: p.line-strong;
    out property <color> text: p.text;
    out property <color> text-dim: p.text-dim;
    out property <color> text-faint: p.text-faint;
    // Derived: idle shortcut hints / row numbers — between faint and the app bg.
    out property <color> text-ghost: p.text-faint.mix(p.bg-app, 0.62);
    out property <color> accent: p.accent;
    out property <color> on-accent: p.on-accent;
    out property <color> danger: p.danger;
    // Modal scrim behind overlays (spec: rgba(6,6,8,.62)).
    out property <brush> scrim: #060608.with-alpha(0.62);
    // spacing scale (theme-independent)
    out property <length> sp1: 4px;
    out property <length> sp2: 8px;
    out property <length> sp3: 12px;
    out property <length> sp4: 16px;
    out property <length> sp5: 24px;
    // radii
    out property <length> r-xs: 4px;   // keycaps
    out property <length> r-sm: 6px;   // rows / tabs / buttons
    out property <length> r-md: 8px;   // cards
    out property <length> r-lg: 12px;  // window / popovers
    // type scale (Graphite)
    out property <length> fs-xs: 11.5px;   // meta / labels
    out property <length> fs-sm: 12.5px;   // secondary
    out property <length> fs-body: 13.5px; // body
    out property <length> fs-md: 14px;
    out property <length> fs-lg: 15px;     // search input
    out property <length> fs-title: 20px;  // page title
    // Type families (bundled + registered in runtime.rs). `mono` is JetBrainsMono
    // Nerd Font Mono — its Private-Use-Area glyphs render copied Nerd Font icons,
    // and it's the code / clipboard-content / preview face. `ui` (Geist) stays the
    // sans face for chrome (sidebar, titles). Emoji fall back to the OS colour font.
    out property <string> mono: "JetBrainsMono Nerd Font Mono";
    out property <string> ui: "Geist";

    // The theme catalogue. ORDER IS THE CONTRACT with `themes.rs` (index-based).
    out property <[Palette]> palettes: [
        // 0 — Graphite (default; id stays `dark`)
        {
            name: "Graphite", dark: true,
            bg-sidebar: #0f0f11, bg-app: #141416, bg-panel: #17171a, bg-elevated: #1e1e22,
            line: #232327, line-strong: #2e2e34,
            text: #ededf0, text-dim: #a1a1aa, text-faint: #7c7c85,
            accent: #8b9cff, on-accent: #141416, danger: #e06a6a,
        },
        // 1 — Light
        {
            name: "Light", dark: false,
            bg-sidebar: #edeef1, bg-app: #f6f6f8, bg-panel: #ffffff, bg-elevated: #ececf0,
            line: #d8d8e0, line-strong: #c2c2cc,
            text: #1a1a1e, text-dim: #55555f, text-faint: #8a8a92,
            accent: #4a6cf0, on-accent: #ffffff, danger: #d0483f,
        },
        // 2 — Catppuccin Mocha
        {
            name: "Catppuccin Mocha", dark: true,
            bg-sidebar: #181825, bg-app: #1e1e2e, bg-panel: #313244, bg-elevated: #45475a,
            line: #313244, line-strong: #45475a,
            text: #cdd6f4, text-dim: #a6adc8, text-faint: #7f849c,
            accent: #89b4fa, on-accent: #1e1e2e, danger: #f38ba8,
        },
        // 3 — Catppuccin Latte
        {
            name: "Catppuccin Latte", dark: false,
            bg-sidebar: #e6e9ef, bg-app: #eff1f5, bg-panel: #ffffff, bg-elevated: #dce0e8,
            line: #ccd0da, line-strong: #bcc0cc,
            text: #4c4f69, text-dim: #6c6f85, text-faint: #8c8fa1,
            accent: #1e66f5, on-accent: #ffffff, danger: #d20f39,
        },
        // 4 — Tokyo Night
        {
            name: "Tokyo Night", dark: true,
            bg-sidebar: #16161e, bg-app: #1a1b26, bg-panel: #24283b, bg-elevated: #292e42,
            line: #292e42, line-strong: #3b4261,
            text: #c0caf5, text-dim: #a9b1d6, text-faint: #565f89,
            accent: #7aa2f7, on-accent: #1a1b26, danger: #f7768e,
        },
        // 5 — Atom One Dark
        {
            name: "Atom One Dark", dark: true,
            bg-sidebar: #21252b, bg-app: #282c34, bg-panel: #2f343d, bg-elevated: #3a3f4b,
            line: #3a3f4b, line-strong: #4b5263,
            text: #abb2bf, text-dim: #828997, text-faint: #5c6370,
            accent: #61afef, on-accent: #282c34, danger: #e06c75,
        },
        // 6 — Dracula
        {
            name: "Dracula", dark: true,
            bg-sidebar: #21222c, bg-app: #282a36, bg-panel: #2f313f, bg-elevated: #44475a,
            line: #44475a, line-strong: #565872,
            text: #f8f8f2, text-dim: #b8bcc8, text-faint: #6272a4,
            accent: #bd93f9, on-accent: #282a36, danger: #ff5555,
        },
        // 7 — Nord
        {
            name: "Nord", dark: true,
            bg-sidebar: #272c36, bg-app: #2e3440, bg-panel: #3b4252, bg-elevated: #434c5e,
            line: #3b4252, line-strong: #4c566a,
            text: #eceff4, text-dim: #d8dee9, text-faint: #7b8394,
            accent: #88c0d0, on-accent: #2e3440, danger: #bf616a,
        },
        // 8 — Gruvbox Dark
        {
            name: "Gruvbox Dark", dark: true,
            bg-sidebar: #1d2021, bg-app: #282828, bg-panel: #32302f, bg-elevated: #3c3836,
            line: #3c3836, line-strong: #504945,
            text: #ebdbb2, text-dim: #bdae93, text-faint: #928374,
            accent: #fabd2f, on-accent: #282828, danger: #fb4934,
        },
    ];
}

// Kept for existing call sites — mirrors `Theme.accent`/`Theme.on-accent` so
// every ref via `Pal.*` still tracks the active theme.
export global Pal {
    out property <color> accent: Theme.accent;
    out property <color> on-accent: Theme.on-accent;
}
