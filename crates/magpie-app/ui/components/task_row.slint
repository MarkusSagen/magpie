import { Theme, Pal } from "../theme.slint";
import { Icons } from "../icons.slint";
import { TaskRow } from "../types.slint";

// A single task row shared by the popover's Tasks/Today tabs and the launcher's
// Today dashboard: a circle checkbox toggle + title + due/project/recur badges.
export component PopoverTaskRow inherits Rectangle {
    in property <TaskRow> t;
    callback toggle();
    callback open();
    height: 40px;
    background: prow.has-hover ? Theme.bg-elevated : transparent;
    border-radius: Theme.r-sm;
    prow := TouchArea { clicked => { root.open(); } }
    HorizontalLayout {
        padding-left: Theme.sp2;
        padding-right: Theme.sp2;
        spacing: Theme.sp2;
        Rectangle {
            width: 24px;
            Rectangle {
                y: 11px;
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: 1px;
                border-color: root.t.doing && !root.t.done ? Theme.warn : Theme.text-faint;
                background: root.t.done ? Pal.accent : (root.t.doing ? Theme.warn.with-alpha(0.2) : transparent);
                if root.t.done: Text {
                    text: "✓";
                    color: Pal.on-accent;
                    font-size: 11px;
                    width: 18px;
                    height: 18px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if !root.t.done && root.t.doing: Text {
                    text: "◐";
                    color: Theme.warn;
                    font-size: 12px;
                    width: 18px;
                    height: 18px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            TouchArea { clicked => { root.toggle(); } }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            padding-top: 5px;
            padding-bottom: 5px;
            Text {
                text: root.t.title;
                color: root.t.done ? Theme.text-faint : Theme.text;
                font-size: Theme.fs-body;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: Theme.sp2;
                alignment: start;
                if root.t.due != "": Text { text: root.t.due; color: root.t.overdue ? Theme.danger : Theme.text-dim; font-size: Theme.fs-xs; vertical-alignment: center; }
                if root.t.project != "": Text { text: "#" + root.t.project; color: Theme.link; font-size: Theme.fs-xs; vertical-alignment: center; }
                if root.t.recur != "": Text { text: root.t.recur; color: Theme.success; font-size: Theme.fs-xs; vertical-alignment: center; }
            }
        }
    }
}
