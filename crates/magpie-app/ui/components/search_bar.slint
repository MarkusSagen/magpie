import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";

// The one shared top search bar, used identically across every section (clipboard uses
// its own inline copy for keyboard-hub reasons; Notes/Tasks/etc. use THIS so the search
// looks and behaves the same everywhere): 56px, borderless with a bottom hairline, a
// search glyph, a large single-line input, and a context placeholder.
export component SearchBar inherits Rectangle {
    in property <string> placeholder: "Search…";
    in-out property <string> text;
    callback edited(string);
    // Emitted on Enter / Esc so the host can act (open first result / clear).
    // NB: not named accept/escape — those are reserved return values in key handlers.
    callback submit();
    callback dismiss();
    height: 56px;
    // Bottom hairline (matches the clipboard top bar).
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Image {
                source: Icons.search;
                width: 16px; height: 16px; image-fit: contain;
                colorize: Theme.text-faint;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            if root.text == "": Text {
                x: 0;
                text: root.placeholder;
                color: Theme.text-faint;
                font-size: Theme.fs-lg;
                vertical-alignment: center;
            }
            ti := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.text;
                color: Theme.text;
                font-size: Theme.fs-lg;
                single-line: true;
                vertical-alignment: center;
                edited => { root.edited(self.text); }
                key-pressed(event) => {
                    if event.text == Key.Return { root.submit(); return accept; }
                    if event.text == Key.Escape { root.dismiss(); return accept; }
                    return reject;
                }
            }
        }
    }
}
