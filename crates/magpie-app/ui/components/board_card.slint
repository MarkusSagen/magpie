import { Theme, Pal } from "../theme.slint";
import { Icons } from "../icons.slint";
import { TaskRow } from "../types.slint";

// A task card (Graphite): ring checkbox + title + due/#tag + a monochrome 3-bar
// priority glyph. Focused/hovered = 1px accent border. Shared by every board
// layout (Kanban / List / Grid / Table).
export component BoardCard inherits Rectangle {
    in property <TaskRow> t;
    in property <bool> draggable;
    callback open();
    callback set-status(int); // 0=Todo, 1=Doing, 2=Done
    callback drag-start(int, int, string);
    callback drag-move(length, length);
    callback drag-end(length, length);
    property <bool> dragging: false;
    height: 56px;
    background: bcta.has-hover ? Theme.bg-elevated : Theme.bg-panel;
    border-radius: Theme.r-md;
    border-width: 1px;
    border-color: bcta.has-hover ? Theme.accent : transparent;
    opacity: root.dragging ? 0.4 : 1.0;
    bcta := TouchArea {
        moved => {
            if (root.draggable && self.pressed) {
                if (!root.dragging && (Math.abs(self.mouse-x - self.pressed-x) > 6px || Math.abs(self.mouse-y - self.pressed-y) > 6px)) {
                    root.dragging = true;
                    root.drag-start(root.t.note_id, root.t.line_index, root.t.title);
                }
                if (root.dragging) {
                    root.drag-move(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up) {
                if (root.dragging) {
                    root.drag-end(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                } else {
                    root.open();
                }
                root.dragging = false;
            }
        }
    }
    HorizontalLayout {
        padding: Theme.sp2;
        spacing: 8px;
        // Ring checkbox — toggles Done. Filled accent + inner dot when done.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: 1.5px;
                border-color: root.t.done ? Theme.accent : Theme.text-faint;
                background: root.t.done ? Theme.accent : transparent;
                if root.t.done: Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Theme.on-accent; }
                chkta := TouchArea { clicked => { root.set-status(root.t.done ? 0 : 2); } }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.t.title;
                color: root.t.done ? Theme.text-faint : Theme.text;
                font-size: Theme.fs-body;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if root.t.due != "": Text { text: root.t.due; color: root.t.overdue ? Theme.danger : Theme.text-dim; font-size: Theme.fs-xs; vertical-alignment: center; }
                if root.t.project != "": Text { text: "#" + root.t.project; color: Theme.text-dim; font-size: Theme.fs-xs; vertical-alignment: center; overflow: elide; }
            }
        }
        // Monochrome 3-bar priority glyph (High=3 filled, Med=2, Low=1; rest faint).
        if root.t.priority <= 2: VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 2px;
                alignment: end;
                for b in [0, 1, 2]: Rectangle {
                    width: 3px;
                    height: 5px + b * 3px;
                    border-radius: 1px;
                    background: b < (root.t.priority == 0 ? 3 : (root.t.priority == 1 ? 2 : 1)) ? Theme.text : Theme.text-faint;
                }
            }
        }
    }
}
